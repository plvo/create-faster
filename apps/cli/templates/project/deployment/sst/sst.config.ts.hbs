/// <reference path="./.sst/platform/config.d.ts" />

export default $config({
  app(input) {
    return {
      name: '{{projectName}}',
      removal: input?.stage === 'production' ? 'retain' : 'remove',
      home: 'aws',
    };
  },
  async run() {
{{#if (projectSecrets "nextjs" "hono" "tanstack-start")}}
    const secrets = {
{{#each (projectSecrets "nextjs" "hono" "tanstack-start")}}
      {{pascalCase this}}: new sst.Secret('{{pascalCase this}}'),
{{/each}}
    };

{{/if}}
{{#each apps}}
{{#if (eq stackName "nextjs")}}
    const {{camelCase appName}} = new sst.aws.Nextjs('{{appName}}'{{#if (eq ../repo "turborepo")}}, {
      path: 'apps/{{appName}}/',
{{#if (appSecrets)}}
      environment: {
        {{> sst/secret-environment}}
      },
{{/if}}
    }{{else if (appSecrets)}}, {
      environment: {
        {{> sst/secret-environment}}
      },
    }{{/if}});
{{/if}}
{{#if (eq stackName "hono")}}
    const {{camelCase appName}} = new sst.aws.Function('{{appName}}', {
      url: true,
      handler: '{{#if (eq ../repo "turborepo")}}apps/{{appName}}/{{/if}}src/index.handler',
      environment: {
        NODE_ENV: $dev ? 'development' : 'production',
        {{> sst/secret-environment}}
      },
    });
{{/if}}
{{#if (eq stackName "tanstack-start")}}
    const {{camelCase appName}} = new sst.aws.TanStackStart('{{appName}}', {
{{#if (eq ../repo "turborepo")}}
      path: 'apps/{{appName}}/',
{{/if}}
      environment: {
        NODE_ENV: $dev ? 'development' : 'production',
        NITRO_PRESET: 'aws-lambda',
        {{> sst/secret-environment}}
      },
    });
{{/if}}
{{/each}}

    return {
{{#each apps}}
{{#if (or (eq stackName "nextjs") (eq stackName "hono") (eq stackName "tanstack-start"))}}
      '{{appName}}': {{camelCase appName}}.url,
{{/if}}
{{/each}}
    };
  },
});
