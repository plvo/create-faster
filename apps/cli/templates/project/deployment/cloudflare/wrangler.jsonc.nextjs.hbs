{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{#if (isMono)}}{{appName}}{{else}}{{projectName}}{{/if}}",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-12",
  // global_fetch_strictly_public routes fetch() through the public internet so OpenNext asset serving avoids Worker subrequest limits
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // workerd leaves process.env.NODE_ENV unset, so dependencies reading it at runtime would behave as in development
  "vars": {
    "NODE_ENV": "production"
  }{{>cloudflare/d1-binding}}{{> cloudflare/hyperdrive-binding localCommands="`wrangler dev`"}}
}
