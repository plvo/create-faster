---
path: src/lib/db/index.ts
mono:
  path: src/index.ts
---
{{#if (has "database" "postgres")}}
import { PrismaPg } from '@prisma/adapter-pg';
{{#unless (and (databaseBinding "hyperdrive") (has "deployment" "cloudflare"))}}
import { parse as parseConnectionString } from 'pg-connection-string';
{{/unless}}
{{/if}}
{{#if (has "database" "mysql")}}
import { PrismaMariaDb } from '@prisma/adapter-mariadb';
{{/if}}
import { PrismaClient } from '{{#if (isMono)}}../generated/prisma/client{{else}}../../../generated/prisma/client{{/if}}';

{{#if (and (databaseBinding "hyperdrive") (has "deployment" "cloudflare"))}}
export function createDb(hyperdrive: Hyperdrive) {
{{#if (has "database" "postgres")}}
  const adapter = new PrismaPg({ connectionString: hyperdrive.connectionString });
{{/if}}
{{#if (has "database" "mysql")}}
  const adapter = new PrismaMariaDb({
    host: hyperdrive.host,
    port: hyperdrive.port,
    user: hyperdrive.user,
    password: hyperdrive.password,
    database: hyperdrive.database,
  });
{{/if}}
  return new PrismaClient({ adapter });
}
export type Database = ReturnType<typeof createDb>;
type Client = Database;
{{else}}
{{#if (has "database" "postgres")}}
{{> postgres/tls-warning}}

warnIfProductionTlsDisabled(process.env.DATABASE_URL);
{{/if}}
{{> prisma/node-adapter}}

const globalForPrisma = global as unknown as { prisma: PrismaClient };

export const prisma =
  globalForPrisma.prisma ||
  new PrismaClient({ adapter });

if (process.env.NODE_ENV !== 'production') globalForPrisma.prisma = prisma;

type Client = typeof prisma;
{{/if}}

export * from '{{#if (isMono)}}../generated/prisma/client{{else}}../../../generated/prisma/client{{/if}}';

// Type helpers
export type User = Awaited<ReturnType<Client['user']['findUnique']>>;
export type Post = Awaited<ReturnType<Client['post']['findUnique']>>;

{{#if (hasLibrary "better-auth")}}
// Auth types
export type Session = Awaited<ReturnType<Client['session']['findUnique']>>;
export type Account = Awaited<ReturnType<Client['account']['findUnique']>>;
export type Verification = Awaited<ReturnType<Client['verification']['findUnique']>>;
{{/if}}
