#!/bin/sh

subject=$(head -n 1 "$1")
types='{{> husky/commit-types}}'

if echo "$subject" | grep -Eq "^($types)(\([^)]+\))?!?: .+"; then
    echo "✅ Commit message is valid!"
else
    echo "⚠️  Invalid commit message format, recommended: "
    echo "  • <type>(<scope>): <subject>"
    echo "  • Example: feat(auth): add email login"
    echo "Allowed types:"
    echo "$types" | tr '|' '\n' | sed 's/^/  • /'
fi

exit 0
