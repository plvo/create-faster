#!/bin/sh

subject=$(head -n 1 "$1")

if echo "$subject" | grep -Eq '^(build|ci|feat|fix|perf|refactor|style|docs|test|chore|revert|workflow|wip|security)(\([^)]+\))?!?: .+'; then
    echo "✅ Commit message is valid!"
else
    echo "⚠️  Invalid commit message format, recommended: "
    echo "  • <type>(<scope>): <subject>"
    echo "  • Example: feat(auth): add email login"
    echo "Allowed types:"
    echo "  • build"
    echo "  • ci"
    echo "  • feat"
    echo "  • fix"
    echo "  • perf"
    echo "  • refactor"
    echo "  • style"
    echo "  • docs"
    echo "  • test"
    echo "  • chore"
    echo "  • revert"
    echo "  • workflow"
    echo "  • wip"
    echo "  • security"
fi

exit 0
