---
mono:
  scope: app
---
{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "{{#if (isMono)}}../../packages/ui/src/base.css{{else if (eq stackName "tanstack-start")}}src/styles.css{{else}}src/styles/globals.css{{/if}}",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    {{#if (isMono)}}
    "hooks": "@repo/ui/hooks",
    "lib": "@/lib",
    "utils": "@repo/ui/lib/utils",
    "ui": "@repo/ui/components/ui"
    {{else}}
    "hooks": "@/hooks",
    "lib": "@/lib",
    "utils": "src/lib/utils"
    {{/if}}
  }
}