---
mono:
  scope: app
---
{
  {{#if (isMono)}}
  {{> shadcn/components-config css="../../packages/ui/src/base.css"}}
  {{/if}}
  {{#unless (isMono)}}
  {{#if (eq stackName "tanstack-start")}}
  {{> shadcn/components-config css="src/styles.css"}}
  {{else}}
  {{> shadcn/components-config css="src/styles/globals.css"}}
  {{/if}}
  {{/unless}}
  "aliases": {
    "components": "@/components",
    {{#if (isMono)}}
    "hooks": "@repo/ui/hooks",
    {{else}}
    "hooks": "@/hooks",
    {{/if}}
    "lib": "@/lib",
    {{#if (isMono)}}
    "utils": "@repo/ui/lib/utils",
    "ui": "@repo/ui/components/ui"
    {{else}}
    "utils": "src/lib/utils"
    {{/if}}
  }
}