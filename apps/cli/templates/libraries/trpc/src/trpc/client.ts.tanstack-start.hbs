---
mono:
  scope: app
---
import { createIsomorphicFn } from '@tanstack/react-start';
import { getRequest } from '@tanstack/react-start/server';
import { createTRPCClient, httpBatchLink, unstable_localLink } from '@trpc/client';
import superjson from 'superjson';
{{#if (isMono)}}
import { type AppRouter, appRouter, createTRPCContext } from '@repo/api';
{{else}}
import { createTRPCContext } from '@/trpc/init';
import { type AppRouter, appRouter } from '@/trpc/routers/_app';
{{/if}}
{{#if (and (has "database" "d1") project.orm)}}
import { db } from '@/lib/server';
{{/if}}

// Call once per request (getRouter does): the server client memoizes its context promise,
// so every procedure called while rendering one request shares one context.
export const makeTRPCClient = createIsomorphicFn()
  .server(() => {
    let context: ReturnType<typeof createTRPCContext> | undefined;
    return createTRPCClient<AppRouter>({
      links: [
        unstable_localLink({
          router: appRouter,
          transformer: superjson,
          createContext: () => {
            if (!context) context = createTRPCContext({ headers: getRequest().headers{{#if (and (has "database" "d1") project.orm)}}, db{{/if}} });
            return context;
          },
          {{> trpc/on-error dev="import.meta.env.DEV"}}
        }),
      ],
    });
  })
  .client(() =>
    createTRPCClient<AppRouter>({
      links: [httpBatchLink({ url: '/api/trpc', transformer: superjson })],
    }),
  );
