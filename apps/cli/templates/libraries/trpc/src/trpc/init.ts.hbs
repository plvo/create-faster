---
path: src/trpc/init.ts
mono:
  scope: pkg
  path: src/trpc.ts
---
{{#if (and (has "database" "d1") project.orm)}}
{{#if (hasLibrary "better-auth")}}
import { createAuth } from {{#if (isMono)}}'@repo/auth/auth'{{else}}'@/lib/auth/create-auth'{{/if}};
{{/if}}
import type { Database } from {{#if (isMono)}}'@repo/db'{{else}}'@/lib/db'{{/if}};
{{else}}
{{#if (hasLibrary "better-auth")}}
{{#if (isMono)}}
import { auth as sessionReader } from './auth';
{{else}}
import { sessionReader } from './session-reader';
{{/if}}
{{/if}}
{{#if project.orm}}
import { db } from {{#if (isMono)}}'@repo/db'{{else}}'@/lib/db'{{/if}};
{{/if}}
{{/if}}
{{#if (and (hasLibrary "better-auth") (has "stack" "tanstack-start"))}}
import { getRequestSession } from {{#if (isMono)}}'@repo/auth/session-cache'{{else}}'@/lib/auth/session-cache'{{/if}};
{{/if}}
import { initTRPC, TRPCError } from '@trpc/server';
import superjson from 'superjson';

export async function createTRPCContext(opts: { headers: Headers{{#if (and (has "database" "d1") project.orm)}}; db: Database{{/if}} }) {
{{#if (hasLibrary "better-auth")}}
{{#if (and (has "database" "d1") project.orm)}}
  const sessionReader = createAuth(opts.db);
{{/if}}
{{#if (has "stack" "tanstack-start")}}
  const session = await getRequestSession(opts.headers, () => sessionReader.api.getSession({ headers: opts.headers }));
{{else}}
  const session = await sessionReader.api.getSession({ headers: opts.headers });
{{/if}}

{{/if}}
  return {
{{#if (hasLibrary "better-auth")}}
    session,
{{/if}}
    headers: opts.headers,
{{#if (and (has "database" "d1") project.orm)}}
    db: opts.db,
{{else if project.orm}}
    db,
{{/if}}
  };
}

type TRPCContext = Awaited<ReturnType<typeof createTRPCContext>>;

// The build inlines this literal: tRPC's own default reads NODE_ENV at runtime, which some production
// servers leave unset (Next.js on Cloudflare through OpenNext).
const isDev = process.env.NODE_ENV === 'development';

const t = initTRPC.context<TRPCContext>().create({
  transformer: superjson,
  isDev,
  // Outside development an error carries no stack trace, and an unexpected one (a failed query, a bug) reaches
  // the client as a generic message: its own message can carry SQL, parameters or other internals.
  errorFormatter: ({ shape, error }) => {
    if (isDev) return shape;
    const data = { ...shape.data };
    delete data.stack;
    return {
      ...shape,
      message: error.code === 'INTERNAL_SERVER_ERROR' ? 'Internal server error' : shape.message,
      data,
    };
  },
});

export const router = t.router;
export const publicProcedure = t.procedure;
{{#if (hasLibrary "better-auth")}}

export const protectedProcedure = publicProcedure.use(async (opts) => {
  if (!opts.ctx.session?.user) {
    throw new TRPCError({
      code: 'UNAUTHORIZED',
      message: 'You must be logged in to access this resource',
    });
  }

  return opts.next({
    ctx: {
      ...opts.ctx,
      session: opts.ctx.session,
      user: opts.ctx.session.user,
    },
  });
});
{{/if}}
