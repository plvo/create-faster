---
mono:
  scope: app
---
{{#if (hasLibrary "tanstack-query")}}
import { useRouter } from '@tanstack/react-router';
import { createTRPCContext } from '@trpc/tanstack-react-query';
import type { ReactNode } from 'react';
import type { AppRouter } from {{#if (isMono)}}'@repo/api'{{else}}'@/trpc/routers/_app'{{/if}};

export const { TRPCProvider, useTRPC, useTRPCClient } = createTRPCContext<AppRouter>();

export function RouterTRPCProvider({ children }: { children: ReactNode }) {
  const { queryClient, trpcClient } = useRouter().options.context;
  return (
    <TRPCProvider trpcClient={trpcClient} queryClient={queryClient}>
      {children}
    </TRPCProvider>
  );
}
{{/if}}
