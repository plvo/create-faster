---
mono:
  scope: app
---
import { fetchRequestHandler } from '@trpc/server/adapters/fetch';
{{#if (isMono)}}
import { appRouter, createTRPCContext } from '@repo/api';
{{else}}
import { appRouter } from '@/trpc/routers/_app';
import { createTRPCContext } from '@/trpc/init';
{{/if}}
{{#if (and (has "database" "d1") project.orm)}}
import { getDb } from '@/lib/server';
{{/if}}

{{> trpc/cross-origin-write}}

const handler = (req: Request) => {
  if (isCrossOriginWrite(req)) return new Response('Forbidden', { status: 403 });

  return fetchRequestHandler({
    endpoint: '/api/trpc',
    req,
    router: appRouter,
{{#if (and (has "database" "d1") project.orm)}}
    createContext: async ({ req }) => createTRPCContext({ headers: req.headers, db: await getDb() }),
{{else}}
    createContext: ({ req }) => createTRPCContext({ headers: req.headers }),
{{/if}}
    {{> trpc/on-error dev="process.env.NODE_ENV === 'development'"}}
  });
};

export { handler as GET, handler as POST };
