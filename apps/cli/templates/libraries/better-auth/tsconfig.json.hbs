{
  "extends": "@repo/config/ts/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "types": ["node"{{#if (has "deployment" "cloudflare")}}, "@cloudflare/workers-types"{{/if}}]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}