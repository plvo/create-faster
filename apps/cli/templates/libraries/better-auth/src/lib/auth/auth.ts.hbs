---
path: src/lib/auth/create-auth.ts
mono:
  scope: pkg
  path: src/auth.ts
---
{{#if (has "orm" "drizzle")}}
{{#if (has "database" "d1")}}
import { type Database, userAccountTable, userSessionTable, userTable, userVerificationTable } from {{#if (isMono)}}'@repo/db'{{else}}'@/lib/db'{{/if}};
{{else}}
import { db, userAccountTable, userSessionTable, userTable, userVerificationTable } from {{#if (isMono)}}'@repo/db'{{else}}'@/lib/db'{{/if}};
{{/if}}
import { drizzleAdapter } from '@better-auth/drizzle-adapter';
{{/if}}
{{#if (has "orm" "prisma")}}
import { prisma } from {{#if (isMono)}}'@repo/db'{{else}}'@/lib/db'{{/if}};
import { prismaAdapter } from '@better-auth/prisma-adapter';
{{/if}}
import { type BetterAuthPlugin, betterAuth } from 'better-auth';

const HOUR = 60 * 60;
const DAY = 24 * HOUR;

const isDev = process.env.NODE_ENV === 'development';
const prodHost = process.env.BETTER_AUTH_URL ? new URL(process.env.BETTER_AUTH_URL).host : undefined;

export function createAuth({{#if (has "database" "d1")}}db: Database, {{/if}}cookiePlugin?: BetterAuthPlugin) {
  return betterAuth({
    baseURL: {
      allowedHosts: [
        prodHost,
        ...(isDev || !prodHost ? ['localhost:*', '*.localhost:*'] : []),
      ].filter(Boolean) as string[],
      fallback: process.env.BETTER_AUTH_URL,
      protocol: isDev ? 'http' : 'auto',
    },
    {{#if (has "orm" "drizzle")}}
    database: drizzleAdapter(db, {
      {{#if (has "database" "postgres")}}
      provider: 'pg',
      {{/if}}
      {{#if (has "database" "mysql")}}
      provider: 'mysql',
      {{/if}}
      {{#if (or (has "database" "sqlite") (has "database" "d1"))}}
      provider: 'sqlite',
      {{/if}}
      usePlural: false,
      schema: {
        user: userTable,
        account: userAccountTable,
        session: userSessionTable,
        verification: userVerificationTable,
      },
    }),
    {{/if}}
    {{#if (has "orm" "prisma")}}
    database: prismaAdapter(prisma, {
      {{#if (has "database" "postgres")}}
      provider: 'postgresql',
      {{/if}}
      {{#if (has "database" "mysql")}}
      provider: 'mysql',
      {{/if}}
      usePlural: false,
    }),
    {{/if}}
    advanced: {
      {{> better-auth/client-ip}}
      {{#if (has "database" "postgres")}}
      database: {
        generateId: () => crypto.randomUUID(),
      },
      {{/if}}
    },

    plugins: [...(cookiePlugin ? [cookiePlugin] : [])],
    emailAndPassword: {
      enabled: true,
      minPasswordLength: 6,
      revokeSessionsOnPasswordReset: true,
    },
    // verbose for explicitly setting the model name
    user: {
      modelName: 'user',
      fields: {
        name: 'username',
        email: 'email',
        emailVerified: 'emailVerified',
        image: 'avatarUrl',
        createdAt: 'createdAt',
        updatedAt: 'updatedAt',
      },
    },
    session: {
      modelName: 'session',
      fields: {
        userId: 'userId',
        token: 'token',
        expiresAt: 'expiresAt',
        ipAddress: 'ipAddress',
        userAgent: 'userAgent',
        createdAt: 'createdAt',
        updatedAt: 'updatedAt',
      },
      expiresIn: 15 * DAY,
      disableSessionRefresh: !cookiePlugin,
    },
    account: {
      modelName: 'account',
      fields: {
        userId: 'userId',
        accountId: 'accountId',
        providerId: 'providerId',
        accessToken: 'accessToken',
        refreshToken: 'refreshToken',
        accessTokenExpiresAt: 'accessTokenExpiresAt',
        refreshTokenExpiresAt: 'refreshTokenExpiresAt',
        scope: 'scope',
        idToken: 'idToken',
        password: 'password',
        createdAt: 'createdAt',
        updatedAt: 'updatedAt',
      },
    },
    verification: {
      modelName: 'verification',
      fields: {
        identifier: 'identifier',
        value: 'value',
        expiresAt: 'expiresAt',
        createdAt: 'createdAt',
        updatedAt: 'updatedAt',
      },
    },
  });
}

export type Auth = ReturnType<typeof createAuth>;
