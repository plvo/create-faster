---
mono:
  scope: pkg
  path: src/session-cache.ts
---
{{#if (has "database" "d1")}}
import type { Auth } from './auth';
{{else}}
import type { auth } from './auth';
{{/if}}

type Session = {{#if (has "database" "d1")}}Auth{{else}}typeof auth{{/if}}['$Infer']['Session'];

const sessions = new WeakMap<Request, Promise<Session | null>>();

export function getRequestSession(
  request: Request,
  load: () => Promise<Session | null>,
): Promise<Session | null> {
  const cached = sessions.get(request);
  if (cached) return cached;

  const session = load();
  sessions.set(request, session);
  return session;
}
