---
mono:
  scope: pkg
  path: src/session-cache.ts
---
{{#if (has "stack" "tanstack-start")}}
import type { Auth } from {{#if (isMono)}}'./auth'{{else}}'./create-auth'{{/if}};

type Session = Auth['$Infer']['Session'];

const sessions = new WeakMap<Headers, Promise<Session | null>>();

export function getRequestSession(headers: Headers, load: () => Promise<Session | null>): Promise<Session | null> {
  const cached = sessions.get(headers);
  if (cached) return cached;

  const session = load();
  sessions.set(headers, session);
  return session;
}
{{/if}}
