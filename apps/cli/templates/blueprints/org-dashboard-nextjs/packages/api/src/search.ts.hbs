mono:
  scope: pkg
  name: api
  path: src/search.ts
---
import { asc, contactTable, desc, type db, or, sql, userTable } from '@repo/db';
import { hasPermission, isAdmin } from './middleware/rbac';
import { type SearchGroup, type SearchableType, searchGroups } from './search-engine';
import { containsText } from './text-match';

// The signed-in user of a request and the database it reads.
export interface SearchCaller {
  db: typeof db;
  session: { user: { id: string; role?: string | null } };
}

// Adding a searchable type is one entry here. A type is read by the check its list procedure makes: `adminProcedure`
// for the users, `permissionProcedure('contact', 'read')` for the contacts.
const SEARCHABLE_TYPES: SearchableType<SearchCaller>[] = [
  {
    type: 'contacts',
    label: 'Contacts',
    canSearch: ({ session }) => hasPermission(session.user.id, 'contact', 'read'),
    find: async ({ db }, text, limit) => {
      const fullName = sql`concat(${contactTable.firstName}, ' ', ${contactTable.lastName})`;
      const rows = await db
        .select({
          id: contactTable.id,
          firstName: contactTable.firstName,
          lastName: contactTable.lastName,
          email: contactTable.email,
          company: contactTable.company,
        })
        .from(contactTable)
        .where(or(containsText(fullName, text), containsText(contactTable.email, text), containsText(contactTable.company, text)))
        .orderBy(desc(contactTable.createdAt), desc(contactTable.id))
        .limit(limit);
      return rows.map((row) => ({
        id: row.id,
        title: `${row.firstName} ${row.lastName}`,
        subtitle: row.email ?? row.company ?? '',
        href: `/contacts/${row.id}`,
      }));
    },
  },
  {
    type: 'users',
    label: 'Users',
    canSearch: ({ session }) => isAdmin(session),
    find: async ({ db }, text, limit) => {
      const rows = await db
        .select({ id: userTable.id, name: userTable.name, email: userTable.email })
        .from(userTable)
        .where(or(containsText(userTable.name, text), containsText(userTable.email, text)))
        .orderBy(asc(userTable.name), asc(userTable.id))
        .limit(limit);
      return rows.map((row) => ({ id: row.id, title: row.name, subtitle: row.email, href: `/admin/users/${row.id}` }));
    },
  },
];

// The groups of records matching the text, for the types the caller may read. A group with no match is left out.
export function searchRecords(
  request: SearchCaller,
  query: string,
  types: SearchableType<SearchCaller>[] = SEARCHABLE_TYPES,
): Promise<SearchGroup[]> {
  return searchGroups(types, query, async () => request);
}
