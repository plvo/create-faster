---
mono:
  scope: pkg
  name: api
  path: src/search.ts
---
import { isGranted } from '@repo/auth/role-permissions';
import { contactTable, desc, or, sql } from '@repo/db';
import type { SearchGroup, SearchableType } from './search-engine';
import { type SearchCaller, type SearchContext, searchTypes, USERS_SEARCH_TYPE } from './search-records';
import { containsText } from './text-match';

// Adding a searchable type is one entry here. A type is read by the check its list procedure makes:
// `permissionProcedure('contact', 'read')` for the contacts.
const SEARCHABLE_TYPES: SearchableType<SearchContext>[] = [
  {
    type: 'contacts',
    label: 'Contacts',
    canSearch: ({ permissions }) => isGranted(permissions, 'contact', 'read'),
    find: async ({ db }, text, limit) => {
      const fullName = sql`concat(${contactTable.firstName}, ' ', ${contactTable.lastName})`;
      const rows = await db
        .select({
          id: contactTable.id,
          firstName: contactTable.firstName,
          lastName: contactTable.lastName,
          email: contactTable.email,
          company: contactTable.company,
        })
        .from(contactTable)
        .where(or(containsText(fullName, text), containsText(contactTable.email, text), containsText(contactTable.company, text)))
        .orderBy(desc(contactTable.createdAt), desc(contactTable.id))
        .limit(limit);
      return rows.map((row) => ({
        id: row.id,
        title: `${row.firstName} ${row.lastName}`,
        subtitle: row.email ?? row.company ?? '',
        href: `/contacts/${row.id}`,
      }));
    },
  },
  USERS_SEARCH_TYPE,
];

// The groups of records matching the text, for the types the caller may read. A group with no match is left out.
export function searchRecords(
  request: SearchCaller,
  query: string,
  types: SearchableType<SearchContext>[] = SEARCHABLE_TYPES,
): Promise<SearchGroup[]> {
  return searchTypes(types, request, query);
}
