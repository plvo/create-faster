import type { LucideIcon } from 'lucide-react';
import { LayoutDashboard, Users, Shield, ShieldCheck } from 'lucide-react';

export interface RouteProps {
  url: string;
  title: string;
  icon?: LucideIcon;
  category?: string;
  permissions?: Record<string, string[]>;
}

export const ROUTES: RouteProps[] = [
  { url: '/', title: 'Dashboard', icon: LayoutDashboard },
  { url: '/contacts', title: 'Contacts', icon: Users, permissions: { contact: ['read'] } },
  { url: '/admin/users', title: 'Users', icon: Shield, category: 'Administration', permissions: { user: ['list'] } },
  { url: '/admin/roles', title: 'Roles', icon: ShieldCheck, category: 'Administration', permissions: { user: ['list'] } },
];

export const PROFILE_TABS = [
  { label: 'Account', url: '/profile/account' },
  { label: 'Security', url: '/profile/security' },
  { label: 'Sessions', url: '/profile/sessions' },
  { label: 'Preferences', url: '/profile/preferences' },
] as const;

// The routes that have a page, which the breadcrumb links to.
export const PAGE_URLS: string[] = [...ROUTES.map((route) => route.url), '/profile', ...PROFILE_TABS.map((tab) => tab.url)];
