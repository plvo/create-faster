import type { Metadata } from 'next';
import { headers } from 'next/headers';
import { notFound, redirect } from 'next/navigation';
import { cache } from 'react';
import { type BusinessAction, type BusinessResource, isRequestGranted } from '@repo/auth/permissions';
import { auth } from '@/lib/auth/auth';
import { REQUEST_PATH_HEADER } from '@/lib/auth/request-path';
import { safeRedirectPath } from '@/lib/safe-redirect';
import { getQueryClient, trpc } from '@/trpc/server';

{{> auth/session-guards}}

// The permission list is the one the layout fetches (`permissions.mine`), read once per request: what a role may do is in
// the database.
export async function hasPermission<R extends BusinessResource>(resource: R, action: BusinessAction<R>): Promise<boolean> {
  const granted = await getQueryClient().ensureQueryData(trpc.permissions.mine.queryOptions());
  return isRequestGranted(granted, { [resource]: [action] });
}

export async function requirePermission<R extends BusinessResource>(resource: R, action: BusinessAction<R>) {
  const session = await requireSession();
  if (!(await hasPermission(resource, action))) notFound();
  return session;
}

// The title of a page behind `requirePermission`. A page that answers not found still has its own metadata resolved,
// so a static `metadata` would title the refusal after the page: the page declares `generateMetadata` and asks here,
// where the title follows the same permission as the guard.
export async function permittedMetadata<R extends BusinessResource>(
  resource: R,
  action: BusinessAction<R>,
  title: string | (() => Promise<string>),
): Promise<Metadata> {
  await requireSession();
  if (!(await hasPermission(resource, action))) return { title: 'Page not found' };
  return { title: typeof title === 'string' ? title : await title() };
}
