---
mono:
  scope: pkg
  name: api
  path: src/router/contact.ts
---
import { z } from 'zod';
import { contactTable, desc, eq, count as dbCount } from '@repo/db';
import { router } from '../trpc';
import { permissionProcedure } from '../middleware/rbac';
import { pageInput, pageOffset } from '../pagination';

const blankAsNull = (value: string) => value || null;

const emailOrBlank = z.union([z.string().email(), z.literal('')]).transform(blankAsNull);
const textOrBlank = z.string().transform(blankAsNull);

const contactInput = z.object({
  firstName: z.string().min(1),
  lastName: z.string().min(1),
  email: emailOrBlank.optional(),
  phone: textOrBlank.optional(),
  company: textOrBlank.optional(),
  notes: textOrBlank.optional(),
});

export const contactRouter = router({
  list: permissionProcedure('contact', 'read')
    .input(pageInput)
    .query(async ({ ctx, input }) => {
      const [items, [totals]] = await Promise.all([
        ctx.db
          .select()
          .from(contactTable)
          .orderBy(desc(contactTable.createdAt), desc(contactTable.id))
          .limit(input.pageSize)
          .offset(pageOffset(input)),
        ctx.db.select({ count: dbCount() }).from(contactTable),
      ]);
      return { items, total: totals?.count ?? 0 };
    }),

  getById: permissionProcedure('contact', 'read')
    .input(z.object({ id: z.string() }))
    .query(async ({ ctx, input }) => {
      const [contact] = await ctx.db
        .select()
        .from(contactTable)
        .where(eq(contactTable.id, input.id))
        .limit(1);
      return contact ?? null;
    }),

  create: permissionProcedure('contact', 'create')
    .input(contactInput)
    .mutation(async ({ ctx, input }) => {
      const [contact] = await ctx.db
        .insert(contactTable)
        .values({ ...input, createdById: ctx.session.user.id })
        .returning();
      return contact;
    }),

  update: permissionProcedure('contact', 'update')
    .input(z.object({ id: z.string(), data: contactInput.partial() }))
    .mutation(async ({ ctx, input }) => {
      const [contact] = await ctx.db
        .update(contactTable)
        .set({ ...input.data, updatedAt: new Date() })
        .where(eq(contactTable.id, input.id))
        .returning();
      return contact;
    }),

  delete: permissionProcedure('contact', 'delete')
    .input(z.object({ id: z.string() }))
    .mutation(async ({ ctx, input }) => {
      await ctx.db
        .delete(contactTable)
        .where(eq(contactTable.id, input.id));
    }),

  count: permissionProcedure('contact', 'read').query(async ({ ctx }) => {
    const [result] = await ctx.db
      .select({ count: dbCount() })
      .from(contactTable);
    return result?.count ?? 0;
  }),
});
