---
mono:
  scope: pkg
  name: api
  path: src/middleware/rbac.ts
---
import { TRPCError } from '@trpc/server';
import { auth } from '../auth';
import { protectedProcedure } from '../trpc';

export const isAdmin = (session: { user: { role?: string | null } }): boolean => session.user.role === 'admin';

export const hasPermission = async (userId: string, resource: string, action: string): Promise<boolean> => {
  const result = await auth.api.userHasPermission({
    body: { userId, permissions: { [resource]: [action] } },
  });
  return result.success;
};

export const adminProcedure = protectedProcedure.use(async (opts) => {
  if (!isAdmin(opts.ctx.session)) {
    throw new TRPCError({
      code: 'FORBIDDEN',
      message: 'Only admins can access this resource',
    });
  }

  return opts.next({ ctx: opts.ctx });
});

export const permissionProcedure = (resource: string, action: string) =>
  protectedProcedure.use(async (opts) => {
    if (!(await hasPermission(opts.ctx.session.user.id, resource, action))) {
      throw new TRPCError({ code: 'FORBIDDEN', message: 'Missing permission' });
    }
    return opts.next({ ctx: opts.ctx });
  });
