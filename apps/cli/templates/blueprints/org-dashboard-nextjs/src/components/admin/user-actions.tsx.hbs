'use client';

import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { MoreHorizontal } from 'lucide-react';
import { useState } from 'react';
import { toast } from 'sonner';
import { Button } from '@repo/ui/components/ui/button';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from '@repo/ui/components/ui/dropdown-menu';
import { useMenuConfirmation } from '@/hooks/use-menu-confirmation';
import { useTRPC } from '@/trpc/providers';
import { authClient } from '@repo/auth/auth-client';

type User = {
  id: string;
  name: string;
  role: string;
  banned: boolean | null;
};

{{{{raw}}}}
export function UserActions({ user }: { user: User }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const { data: session } = authClient.useSession();
  const [loading, setLoading] = useState(false);
  const { actionRef, cancelRef, ...banConfirmation } = useMenuConfirmation();
  const rolesQuery = useQuery(trpc.user.assignableRoles.queryOptions(undefined, { enabled: banConfirmation.open }));

  const invalidateUsers = () => {
    queryClient.invalidateQueries({ queryKey: trpc.user.list.queryKey() });
  };

  const handleBan = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.banUser({ userId: user.id, banReason: 'Banned by admin' });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to ban user');
        return;
      }
      toast.success(`${user.name} has been banned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to ban user');
    } finally {
      setLoading(false);
    }
  };

  const handleUnban = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.unbanUser({ userId: user.id });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to unban user');
        return;
      }
      toast.success(`${user.name} has been unbanned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to unban user');
    } finally {
      setLoading(false);
    }
  };

  const setRole = useMutation(
    trpc.user.setRole.mutationOptions({
      onSuccess: (_result, input) => {
        const label = rolesQuery.data?.find((role) => role.id === input.role)?.label ?? input.role;
        toast.success(`${user.name} is now ${label}`);
        invalidateUsers();
      },
      onError: (error) => toast.error(error.message),
    }),
  );

  if (session?.user.id === user.id) return null;

  return (
    <DropdownMenu open={banConfirmation.open} onOpenChange={banConfirmation.onOpenChange}>
      <DropdownMenuTrigger asChild>
        <Button variant='ghost' size='icon' disabled={loading} aria-label='Actions'>
          <MoreHorizontal />
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align='end'>
        {(rolesQuery.data ?? [])
          .filter((role) => role.id !== user.role)
          .map((role) => (
            <DropdownMenuItem
              key={role.id}
              disabled={setRole.isPending}
              onClick={() => setRole.mutate({ id: user.id, role: role.id })}
            >
              Set role: {role.label}
            </DropdownMenuItem>
          ))}
        <DropdownMenuSeparator />
        {user.banned ? (
          <DropdownMenuItem onClick={handleUnban}>
            Unban User
          </DropdownMenuItem>
        ) : banConfirmation.confirming ? (
          <>
            <DropdownMenuItem onSelect={handleBan} className='text-destructive focus:text-destructive'>
              Confirm ban
            </DropdownMenuItem>
            <DropdownMenuItem
              ref={cancelRef}
              onSelect={(event) => {
                event.preventDefault();
                banConfirmation.swapItems(false);
              }}
            >
              Cancel
            </DropdownMenuItem>
          </>
        ) : (
          <DropdownMenuItem
            ref={actionRef}
            onSelect={(event) => {
              event.preventDefault();
              banConfirmation.swapItems(true);
            }}
            className='text-destructive focus:text-destructive'
          >
            Ban User
          </DropdownMenuItem>
        )}
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
{{{{/raw}}}}
