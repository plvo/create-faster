'use client';

import { useQueryClient } from '@tanstack/react-query';
import { MoreHorizontal } from 'lucide-react';
import { useState } from 'react';
import { toast } from 'sonner';
import { Button } from '@repo/ui/components/ui/button';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from '@repo/ui/components/ui/dropdown-menu';
import { useTRPC } from '@/trpc/providers';
import { authClient } from '@repo/auth/auth-client';

type User = {
  id: string;
  name: string;
  role: string;
  banned: boolean | null;
};

{{{{raw}}}}
export function UserActions({ user }: { user: User }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const { data: session } = authClient.useSession();
  const [loading, setLoading] = useState(false);

  const invalidateUsers = () => {
    queryClient.invalidateQueries({ queryKey: trpc.user.list.queryKey() });
  };

  const handleBan = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.banUser({ userId: user.id, banReason: 'Banned by admin' });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to ban user');
        return;
      }
      toast.success(`${user.name} has been banned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to ban user');
    } finally {
      setLoading(false);
    }
  };

  const handleUnban = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.unbanUser({ userId: user.id });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to unban user');
        return;
      }
      toast.success(`${user.name} has been unbanned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to unban user');
    } finally {
      setLoading(false);
    }
  };

  const handleSetRole = async (role: 'admin' | 'user' | 'manager') => {
    setLoading(true);
    try {
      const res = await authClient.admin.setRole({ userId: user.id, role });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to update role');
        return;
      }
      toast.success(`${user.name} is now ${role}`);
      invalidateUsers();
    } catch {
      toast.error('Failed to update role');
    } finally {
      setLoading(false);
    }
  };

  if (session?.user.id === user.id) return null;

  return (
    <DropdownMenu>
      <DropdownMenuTrigger asChild>
        <Button variant='ghost' size='icon' disabled={loading} aria-label='Actions'>
          <MoreHorizontal />
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align='end'>
        {(['admin', 'user', 'manager'] as const)
          .filter((role) => role !== user.role)
          .map((role) => (
            <DropdownMenuItem key={role} onClick={() => handleSetRole(role)}>
              Set role: {role}
            </DropdownMenuItem>
          ))}
        <DropdownMenuSeparator />
        {user.banned ? (
          <DropdownMenuItem onClick={handleUnban}>
            Unban User
          </DropdownMenuItem>
        ) : (
          <DropdownMenuItem onClick={handleBan} className='text-destructive focus:text-destructive'>
            Ban User
          </DropdownMenuItem>
        )}
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
{{{{/raw}}}}
