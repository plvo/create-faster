'use client';

import { useQueryClient } from '@tanstack/react-query';
import { MoreHorizontal } from 'lucide-react';
import { useEffect, useRef, useState } from 'react';
import { toast } from 'sonner';
import { Button } from '@repo/ui/components/ui/button';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from '@repo/ui/components/ui/dropdown-menu';
import { useTRPC } from '@/trpc/providers';
import { authClient } from '@repo/auth/auth-client';

type User = {
  id: string;
  name: string;
  role: string;
  banned: boolean | null;
};

{{{{raw}}}}
export function UserActions({ user }: { user: User }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const { data: session } = authClient.useSession();
  const [loading, setLoading] = useState(false);
  const [open, setOpen] = useState(false);
  const [confirmingBan, setConfirmingBan] = useState(false);
  const banItemRef = useRef<HTMLDivElement>(null);
  const cancelBanRef = useRef<HTMLDivElement>(null);
  const itemToFocus = useRef<'ban' | 'cancel' | null>(null);

  const invalidateUsers = () => {
    queryClient.invalidateQueries({ queryKey: trpc.user.list.queryKey() });
  };

  const handleBan = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.banUser({ userId: user.id, banReason: 'Banned by admin' });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to ban user');
        return;
      }
      toast.success(`${user.name} has been banned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to ban user');
    } finally {
      setLoading(false);
    }
  };

  const handleUnban = async () => {
    setLoading(true);
    try {
      const res = await authClient.admin.unbanUser({ userId: user.id });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to unban user');
        return;
      }
      toast.success(`${user.name} has been unbanned`);
      invalidateUsers();
    } catch {
      toast.error('Failed to unban user');
    } finally {
      setLoading(false);
    }
  };

  const handleSetRole = async (role: 'admin' | 'user' | 'manager') => {
    setLoading(true);
    try {
      const res = await authClient.admin.setRole({ userId: user.id, role });
      if (res.error) {
        toast.error(res.error.message ?? 'Failed to update role');
        return;
      }
      toast.success(`${user.name} is now ${role}`);
      invalidateUsers();
    } catch {
      toast.error('Failed to update role');
    } finally {
      setLoading(false);
    }
  };

  // The confirmation and the Ban User item replace each other, which would drop the keyboard focus on the page: the item
  // that takes the other's place takes the focus.
  const swapBanItems = (confirming: boolean) => {
    itemToFocus.current = confirming ? 'cancel' : 'ban';
    setConfirmingBan(confirming);
  };

  useEffect(() => {
    const target = itemToFocus.current === 'cancel' ? cancelBanRef : banItemRef;
    if (itemToFocus.current) target.current?.focus();
    itemToFocus.current = null;
  });

  const handleOpenChange = (nextOpen: boolean) => {
    setOpen(nextOpen);
    if (!nextOpen) setConfirmingBan(false);
  };

  if (session?.user.id === user.id) return null;

  return (
    <DropdownMenu open={open} onOpenChange={handleOpenChange}>
      <DropdownMenuTrigger asChild>
        <Button variant='ghost' size='icon' disabled={loading} aria-label='Actions'>
          <MoreHorizontal />
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align='end'>
        {(['admin', 'user', 'manager'] as const)
          .filter((role) => role !== user.role)
          .map((role) => (
            <DropdownMenuItem key={role} onClick={() => handleSetRole(role)}>
              Set role: {role}
            </DropdownMenuItem>
          ))}
        <DropdownMenuSeparator />
        {user.banned ? (
          <DropdownMenuItem onClick={handleUnban}>
            Unban User
          </DropdownMenuItem>
        ) : confirmingBan ? (
          <>
            <DropdownMenuItem onSelect={handleBan} className='text-destructive focus:text-destructive'>
              Confirm ban
            </DropdownMenuItem>
            <DropdownMenuItem
              ref={cancelBanRef}
              onSelect={(event) => {
                event.preventDefault();
                swapBanItems(false);
              }}
            >
              Cancel
            </DropdownMenuItem>
          </>
        ) : (
          <DropdownMenuItem
            ref={banItemRef}
            onSelect={(event) => {
              event.preventDefault();
              swapBanItems(true);
            }}
            className='text-destructive focus:text-destructive'
          >
            Ban User
          </DropdownMenuItem>
        )}
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
{{{{/raw}}}}
