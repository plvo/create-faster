{{#unless (eq stackName "tanstack-start")}}
'use client';

{{/unless}}
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { useId } from 'react';
import { PAGE_SIZES } from '@repo/api/pagination';
import { Button } from '@repo/ui/components/ui/button';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@repo/ui/components/ui/select';

export function pageCountOf(total: number, pageSize: number): number {
  return Math.max(1, Math.ceil(total / pageSize));
}

interface TablePaginationProps {
  page: number;
  pageSize: number;
  total: number;
  itemName: string;
  onPageChange: (page: number) => void;
  onPageSizeChange: (pageSize: number) => void;
}

export function TablePagination({ page, pageSize, total, itemName, onPageChange, onPageSizeChange }: TablePaginationProps) {
  const pageSizeLabelId = useId();
  const pageCount = pageCountOf(total, pageSize);
  const firstRow = (page - 1) * pageSize + 1;
  const lastRow = Math.min(page * pageSize, total);

  return (
    <nav aria-label='Pagination' className='flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-sm'>
      <p aria-live='polite' className='text-muted-foreground tabular-nums'>
        {page <= pageCount ? `Showing ${firstRow}–${lastRow} of ${total} ${itemName}` : `${total} ${itemName} in total`}
      </p>
      <div className='flex flex-wrap items-center gap-x-6 gap-y-3'>
        <div className='flex items-center gap-2'>
          <span id={pageSizeLabelId} className='text-muted-foreground'>
            Rows per page
          </span>
          <Select value={String(pageSize)} onValueChange={(value) => onPageSizeChange(Number(value))}>
            <SelectTrigger size='sm' aria-labelledby={pageSizeLabelId} className='w-18'>
              <SelectValue />
            </SelectTrigger>
            <SelectContent>
              {PAGE_SIZES.map((size) => (
                <SelectItem key={size} value={String(size)}>
                  {size}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>
        <div className='flex items-center gap-4'>
          <span className='tabular-nums'>
            Page {page} of {pageCount}
          </span>
          <div className='flex items-center gap-2'>
            <Button
              variant='outline'
              size='icon'
              aria-label='Previous page'
              disabled={page <= 1}
              onClick={() => onPageChange(Math.min(page - 1, pageCount))}
            >
              <ChevronLeft className='size-4' />
            </Button>
            <Button
              variant='outline'
              size='icon'
              aria-label='Next page'
              disabled={page >= pageCount}
              onClick={() => onPageChange(page + 1)}
            >
              <ChevronRight className='size-4' />
            </Button>
          </div>
        </div>
      </div>
    </nav>
  );
}

interface PageOutOfRangeProps {
  page: number;
  itemName: string;
  onGoToLastPage: () => void;
}

export function PageOutOfRange({ page, itemName, onGoToLastPage }: PageOutOfRangeProps) {
  return (
    <div className='flex flex-col items-center gap-4 rounded-lg border bg-card p-8 text-center'>
      <p className='text-muted-foreground'>
        There are no {itemName} on page {page}.
      </p>
      <Button variant='outline' onClick={onGoToLastPage}>
        Go to the last page
      </Button>
    </div>
  );
}
