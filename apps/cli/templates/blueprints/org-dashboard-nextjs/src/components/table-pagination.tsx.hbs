{{#unless (eq stackName "tanstack-start")}}
'use client';

{{/unless}}
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { type ReactNode, useEffect, useId, useRef } from 'react';
import { PAGE_SIZES, pageCountOf, pageOffset } from '@repo/api/pagination';
import { Button } from '@repo/ui/components/ui/button';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@repo/ui/components/ui/select';

interface PagedListProps {
  page: number;
  pageSize: number;
  total: number;
  rowCount: number;
  itemName: string;
  emptyMessage: string;
  setPage: (page: number) => void;
  setPageSize: (pageSize: number) => void;
  children: ReactNode;
}

// The three states of a paged table: nothing at all, a page past the end, and rows. `children` is the table.
export function PagedList({ rowCount, emptyMessage, children, ...pagination }: PagedListProps) {
  if (pagination.total === 0) {
    return (
      <div className='rounded-lg border bg-card p-8 text-center'>
        <p className='text-muted-foreground'>{emptyMessage}</p>
      </div>
    );
  }

  return (
    <>
      {rowCount === 0 ? (
        <PageOutOfRange
          page={pagination.page}
          itemName={pagination.itemName}
          onGoToLastPage={() => pagination.setPage(pageCountOf(pagination.total, pagination.pageSize))}
        />
      ) : (
        children
      )}
      <TablePagination {...pagination} />
    </>
  );
}

type TablePaginationProps = Omit<PagedListProps, 'rowCount' | 'emptyMessage' | 'children'>;

function TablePagination({ page, pageSize, total, itemName, setPage, setPageSize }: TablePaginationProps) {
  const pageSizeLabelId = useId();
  const previousButton = useRef<HTMLButtonElement>(null);
  const nextButton = useRef<HTMLButtonElement>(null);
  const pressed = useRef<'previous' | 'next' | null>(null);
  const pageCount = pageCountOf(total, pageSize);
  const inRange = page <= pageCount;
  const firstRow = pageOffset({ page, pageSize }) + 1;
  const lastRow = Math.min(page * pageSize, total);

  // A button disabled while it has the focus drops it: the other button takes it, so the keyboard stays on the pager.
  useEffect(() => {
    if (pressed.current === 'next' && page >= pageCount) previousButton.current?.focus();
    if (pressed.current === 'previous' && page <= 1) nextButton.current?.focus();
    pressed.current = null;
  }, [page, pageCount]);

  return (
    <nav aria-label='Pagination' className='flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-sm'>
      <p aria-live='polite' className='text-muted-foreground tabular-nums'>
        {inRange ? `Showing ${firstRow}–${lastRow} of ${total} ${itemName}` : `${total} ${itemName} in total`}
      </p>
      <div className='flex w-full flex-wrap items-center gap-x-6 gap-y-3 sm:w-auto'>
        <div className='flex items-center gap-2'>
          <span id={pageSizeLabelId} className='text-muted-foreground'>
            Rows per page
          </span>
          <Select value={String(pageSize)} onValueChange={(value) => setPageSize(Number(value))}>
            <SelectTrigger
              aria-labelledby={pageSizeLabelId}
              className='w-20 data-[size=default]:h-11 sm:data-[size=default]:h-9'
            >
              <SelectValue />
            </SelectTrigger>
            <SelectContent>
              {PAGE_SIZES.map((size) => (
                <SelectItem key={size} value={String(size)}>
                  {size}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>
        <div className='flex w-full items-center justify-between sm:w-auto sm:gap-4'>
          <span className='tabular-nums'>{inRange ? `Page ${page} of ${pageCount}` : `Page ${page}`}</span>
          <div className='flex items-center gap-2'>
            <Button
              ref={previousButton}
              variant='outline'
              size='icon'
              className='size-11 sm:size-9'
              aria-label='Previous page'
              disabled={page <= 1}
              onClick={() => {
                pressed.current = 'previous';
                setPage(Math.min(page - 1, pageCount));
              }}
            >
              <ChevronLeft className='size-4' />
            </Button>
            <Button
              ref={nextButton}
              variant='outline'
              size='icon'
              className='size-11 sm:size-9'
              aria-label='Next page'
              disabled={page >= pageCount}
              onClick={() => {
                pressed.current = 'next';
                setPage(page + 1);
              }}
            >
              <ChevronRight className='size-4' />
            </Button>
          </div>
        </div>
      </div>
    </nav>
  );
}

function PageOutOfRange({ page, itemName, onGoToLastPage }: { page: number; itemName: string; onGoToLastPage: () => void }) {
  return (
    <div className='flex flex-col items-center gap-4 rounded-lg border bg-card p-8 text-center'>
      <p role='status' className='text-muted-foreground'>
        There are no {itemName} on page {page}.
      </p>
      <Button variant='outline' onClick={onGoToLastPage}>
        Go to the last page
      </Button>
    </div>
  );
}
