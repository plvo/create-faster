---
mono:
  scope: root
---
import { spawn } from 'node:child_process';
import { existsSync } from 'node:fs';
import { copyFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';

{{> local-setup/steps}}

const steps: Step[] = [
  { label: 'Creating .env files from the .env.example files', run: createEnvFiles },
  { label: 'Starting the database (docker compose)', run: () => sh('docker compose up -d --wait') },
  { label: 'Applying the schema to the database', run: () => sh('{{runScript "db:push" "--force"}}', 'packages/db') },
  { label: 'Seeding demo data', run: () => sh('{{runScript "db:seed" "--fixtures"}}') },
];

console.log('Setting up your local environment\n');

runSteps(steps).then(() => console.log('\nLocal setup complete. Sign in with the credentials printed above, then run `{{runScript "dev"}}`.'));
