mono:
  scope: pkg
  name: auth
  path: src/email.ts
---
interface ResetPasswordEmail {
  to: string;
  url: string;
}

const isDev = process.env.NODE_ENV === 'development';

/**
 * The single place password reset links leave the server.
 * No mailer is configured: the link is logged to the server console, in development and in production.
 * Replace the body with a call to a mail provider (Resend, SES, Postmark, ...) to deliver the link to `to`.
 */
export async function sendResetPasswordEmail({ to, url }: ResetPasswordEmail): Promise<void> {
  console.log(`[reset-password] ${to} → ${url}`);
  if (!isDev) {
    console.warn(
      '[reset-password] No mailer is configured: this link is only in the server logs. Plug a mailer into packages/auth/src/email.ts before going live.',
    );
  }
}
