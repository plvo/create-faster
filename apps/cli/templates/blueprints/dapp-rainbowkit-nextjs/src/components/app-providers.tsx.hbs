'use client';

import '@rainbow-me/rainbowkit/styles.css';
import {
  createAuthenticationAdapter,
  RainbowKitAuthenticationProvider,
  RainbowKitProvider,
} from '@rainbow-me/rainbowkit';
import { type Config, WagmiProvider } from 'wagmi';
import { ThemeProvider as NextThemesProvider } from 'next-themes';
import { MissingConfig } from '@/components/missing-config';
import { TRPCReactProvider } from '@/trpc/providers';
import { authClient } from '@/lib/auth/auth-client';
import { wagmiConfig } from '@/lib/wagmi';
import { createSiweMessage } from 'viem/siwe';
import { useRouter } from 'next/navigation';
import { useMemo } from 'react';
import type React from 'react';
import { useMounted } from '@/hooks/use-mounted';

interface AppProvidersProps {
  children: React.ReactNode;
}

export function AppProviders({ children }: AppProvidersProps) {
  if (!wagmiConfig) return <MissingConfig />;

  return <WalletProviders config={wagmiConfig}>{children}</WalletProviders>;
}

interface WalletProvidersProps extends AppProvidersProps {
  config: Config;
}

function WalletProviders({ config, children }: WalletProvidersProps) {
  const { data: session, isPending } = authClient.useSession();
  const router = useRouter();
  const mounted = useMounted();

  const authStatus = !mounted || isPending
    ? 'loading'
    : session
      ? 'authenticated'
      : 'unauthenticated';

  const authAdapter = useMemo(() => {
    return createAuthenticationAdapter({
      getNonce: async () => {
        const { data } = await authClient.siwe.nonce();
        return data?.nonce ?? '';
      },
      createMessage: ({ nonce, address, chainId }) => {
        return createSiweMessage({
          domain: window.location.host,
          address,
          statement: 'Sign in with Ethereum.',
          uri: window.location.origin,
          version: '1',
          chainId,
          nonce,
        });
      },
      verify: async ({ message, signature }) => {
        const { error } = await authClient.siwe.verify({
          message,
          signature,
        });
        if (!error) router.push('/protected');
        return !error;
      },
      signOut: async () => {
        await authClient.signOut();
      },
    });
  }, [router]);

  return (
    <WagmiProvider config={config}>
      <TRPCReactProvider>
        <RainbowKitAuthenticationProvider adapter={authAdapter} status={authStatus}>
          <RainbowKitProvider>
            <NextThemesProvider attribute='class' defaultTheme='system' enableSystem storageKey={"{{appName}}-theme"}>
              {children}
            </NextThemesProvider>
          </RainbowKitProvider>
        </RainbowKitAuthenticationProvider>
      </TRPCReactProvider>
    </WagmiProvider>
  );
}
