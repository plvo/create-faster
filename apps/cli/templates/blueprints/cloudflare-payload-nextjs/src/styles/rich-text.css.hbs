[data-rich-text] > * + * {
  margin-top: 1rem;
}

[data-rich-text] h1,
[data-rich-text] h2,
[data-rich-text] h3,
[data-rich-text] h4 {
  font-weight: 600;
  line-height: 1.25;
}

[data-rich-text] h1 {
  font-size: 2rem;
}

[data-rich-text] h2 {
  font-size: 1.5rem;
}

[data-rich-text] h3 {
  font-size: 1.25rem;
}

[data-rich-text] a {
  text-decoration: underline;
  text-underline-offset: 4px;
}

[data-rich-text] ul,
[data-rich-text] ol {
  padding-left: 1.5rem;
}

[data-rich-text] ul {
  list-style: disc;
}

[data-rich-text] ol {
  list-style: decimal;
}

[data-rich-text] blockquote {
  border-left: 3px solid currentcolor;
  padding-left: 1rem;
  font-style: italic;
}

[data-rich-text] img {
  height: auto;
  max-width: 100%;
  border-radius: 0.5rem;
}
