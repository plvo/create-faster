export const MAX_UPLOAD_BYTES = 20 * 1024 * 1024;

// The multipart request carries the file, the other fields, the headers and the boundaries, so its limit leaves room around the file.
const MULTIPART_ENVELOPE_BYTES = 1024 * 1024;

export const MAX_UPLOAD_REQUEST_BYTES = MAX_UPLOAD_BYTES + MULTIPART_ENVELOPE_BYTES;
