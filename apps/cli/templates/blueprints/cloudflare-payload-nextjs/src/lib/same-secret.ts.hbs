import { createHash, timingSafeEqual } from 'node:crypto';

// Hashing both sides gives buffers of the same length, which timingSafeEqual requires, and hides the length of the secret.
const sha256 = (value: string) => createHash('sha256').update(value).digest();

/** Whether two secrets are equal, in a time that does not depend on how many leading characters match. */
export function sameSecret(given: string, expected: string): boolean {
  return timingSafeEqual(sha256(given), sha256(expected));
}
