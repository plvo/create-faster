---
mono:
  scope: app
  path: src/backup.ts
---
// Dumps every table of the D1 database to R2 as NDJSON, one object per table (more when a table is large), with a manifest.
// The backups have a bucket of their own, bound to this Worker only. The media are not copied: they are already in the media
// bucket, and the `media` table of the dump is their index.
// D1 Time Travel rewinds the whole database to a point of the last 30 days, and covers nothing of R2.

const BACKUP_PREFIX = 'backups/';
// One query per page of rows: a run is one invocation, whose D1 queries are counted (1000 on the Workers Paid plan), so the
// pages are large. A page that returns fewer rows than this is the last one.
const ROWS_PER_QUERY = 2000;
const BYTES_PER_OBJECT = 8 * 1024 * 1024;
const DAY_MS = 24 * 60 * 60 * 1000;
const DEFAULT_RETENTION_DAYS = 30;

interface BackupEnv {
  BACKUP_RETENTION_DAYS?: string;
  BACKUPS: R2Bucket;
  DB: D1Database;
}

interface TableEntry {
  name: string;
  objects: string[];
  rows: number;
}

export interface BackupManifest {
  createdAt: string;
  prefix: string;
  tables: TableEntry[];
}

const quote = (identifier: string) => `"${identifier.replaceAll('"', '""')}"`;

// `_cf_*` tables belong to D1 and it refuses to read them.
async function listTables(db: D1Database): Promise<string[]> {
  const { results } = await db
    .prepare("SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE '\\_cf\\_%' ESCAPE '\\' AND name NOT LIKE 'sqlite\\_%' ESCAPE '\\' ORDER BY name")
    .all<{ name: string }>();
  return results.map((row) => row.name);
}

async function dumpTable(env: BackupEnv, table: string, prefix: string): Promise<TableEntry> {
  const entry: TableEntry = { name: table, objects: [], rows: 0 };
  let lines: string[] = [];
  let bytes = 0;

  const flush = async () => {
    if (lines.length === 0) return;
    const key = `${prefix}${table}/${String(entry.objects.length + 1).padStart(4, '0')}.ndjson`;
    await env.BACKUPS.put(key, `${lines.join('\n')}\n`, { httpMetadata: { contentType: 'application/x-ndjson' } });
    entry.objects.push(key);
    lines = [];
    bytes = 0;
  };

  let lastRowId = 0;
  let lastPageLength = ROWS_PER_QUERY;
  while (lastPageLength === ROWS_PER_QUERY) {
    const { results } = await env.DB.prepare(
      `SELECT rowid AS __rowid, * FROM ${quote(table)} WHERE rowid > ?1 ORDER BY rowid LIMIT ${ROWS_PER_QUERY}`,
    )
      .bind(lastRowId)
      .all<Record<string, unknown> & { __rowid: number }>();
    lastPageLength = results.length;
    for (const { __rowid, ...row } of results) {
      const line = JSON.stringify(row);
      lines.push(line);
      bytes += line.length + 1;
      entry.rows += 1;
      lastRowId = __rowid;
      if (bytes >= BYTES_PER_OBJECT) await flush();
    }
  }
  await flush();
  return entry;
}

async function deleteUnder(bucket: R2Bucket, prefix: string): Promise<void> {
  let cursor: string | undefined;
  do {
    const listed = await bucket.list({ cursor, prefix });
    if (listed.objects.length > 0) await bucket.delete(listed.objects.map((object) => object.key));
    cursor = listed.truncated ? listed.cursor : undefined;
  } while (cursor);
}

export function retentionDaysOf(env: BackupEnv): number {
  const days = Number(env.BACKUP_RETENTION_DAYS ?? DEFAULT_RETENTION_DAYS);
  if (!Number.isInteger(days) || days < 1) {
    throw new Error(`BACKUP_RETENTION_DAYS must be a whole number of days, 1 or more (got "${env.BACKUP_RETENTION_DAYS}")`);
  }
  return days;
}

// A backup lives under backups/<date>/<time>/: a date whose last moment is older than the retention goes, with the
// backups inside. The date of the run is never one of them.
async function pruneOldBackups(env: BackupEnv, now: Date, retentionDays: number): Promise<string[]> {
  const oldest = now.getTime() - retentionDays * DAY_MS;
  const today = `${BACKUP_PREFIX}${now.toISOString().slice(0, 10)}/`;
  const { delimitedPrefixes } = await env.BACKUPS.list({ delimiter: '/', prefix: BACKUP_PREFIX });
  const expired = delimitedPrefixes.filter((prefix) => {
    const day = Date.parse(prefix.slice(BACKUP_PREFIX.length, -1));
    return prefix !== today && Number.isFinite(day) && day + DAY_MS <= oldest;
  });
  for (const prefix of expired) await deleteUnder(env.BACKUPS, prefix);
  return expired;
}

export async function runBackup(env: BackupEnv, now = new Date()): Promise<BackupManifest> {
  // Refuses a run whose retention is wrong before it writes or deletes anything.
  const retentionDays = retentionDaysOf(env);
  const timestamp = now.toISOString().replaceAll(':', '-').replace(/\.\d+Z$/, 'Z');
  const prefix = `${BACKUP_PREFIX}${now.toISOString().slice(0, 10)}/${timestamp}/`;

  const tables: TableEntry[] = [];
  for (const table of await listTables(env.DB)) tables.push(await dumpTable(env, table, prefix));

  const manifest: BackupManifest = { createdAt: now.toISOString(), prefix, tables };
  await env.BACKUPS.put(`${prefix}manifest.json`, JSON.stringify(manifest, null, 2), {
    httpMetadata: { contentType: 'application/json' },
  });

  const pruned = await pruneOldBackups(env, now, retentionDays);
  console.log(`[cron] backed up ${tables.length} table(s) to ${prefix}, pruned ${pruned.length} old day(s)`);
  return manifest;
}
