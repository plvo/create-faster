import { defineCloudflareConfig } from '@opennextjs/cloudflare';
import r2IncrementalCache from '@opennextjs/cloudflare/overrides/incremental-cache/r2-incremental-cache';
import d1NextTagCache from '@opennextjs/cloudflare/overrides/tag-cache/d1-next-tag-cache';

type IncrementalCache = Pick<typeof r2IncrementalCache, 'delete' | 'get' | 'name' | 'set'>;

const answersNotFound = (value: object): boolean =>
  'type' in value && value.type === 'app' && 'meta' in value && (value.meta as { status?: number } | undefined)?.status === 404;

// A page that answers 404 is not worth an R2 object: nothing expires it, and a made-up URL would leave one for good. It
// is rendered again on the next request, which costs one indexed D1 read, and a page published at that slug shows at once.
const withoutNotFoundPages: IncrementalCache = {
  name: r2IncrementalCache.name,
  get: (key, cacheType) => r2IncrementalCache.get(key, cacheType),
  set: async (key, value, cacheType) => {
    if (answersNotFound(value)) return;
    await r2IncrementalCache.set(key, value, cacheType);
  },
  delete: (key) => r2IncrementalCache.delete(key),
};

// Pages are cached in R2 under the incremental-cache/ prefix of the bucket, away from the media at its root, until a
// Payload hook revalidates their tags. The tags live in the revalidations table of the D1 database, which a Payload
// migration creates. Revalidation is on demand only, so no queue (and no self-reference service binding) is configured.
export default defineCloudflareConfig({
  incrementalCache: withoutNotFoundPages,
  tagCache: d1NextTagCache,
});
