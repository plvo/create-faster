// Runs a script of this app against the real D1 database and R2 bucket of the account, for one run: `migrate` applies the
// migrations, `ensure-admin` creates the first admin.
// The committed wrangler.jsonc has no remote binding (`next build` resolves the bindings through payload.config.ts, so a
// remote one would make every build reach the account). This script writes a Wrangler config with DB and STORAGE as remote
// bindings, points payload.config.ts at it, runs the script and deletes the config. Wrangler needs a login first
// (`wrangler login`, or CLOUDFLARE_API_TOKEN).
import { spawnSync } from 'node:child_process';
import { mkdirSync, rmSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { bindingsWithoutDatabaseId, remoteBindingsConfig } from './remote-config';

const REMOTE_BINDINGS = ['DB', 'STORAGE'];
const SCRIPTS: Record<string, string> = {
  'ensure-admin': '{{runScript "ensure-admin"}}',
  migrate: '{{runScript "migrate"}}',
};

const fail: (message: string) => never = (message) => {
  console.error(message);
  process.exit(1);
};

const [name = ''] = process.argv.slice(2);
const command = SCRIPTS[name];
if (!command) fail(`Usage: remote.ts <${Object.keys(SCRIPTS).join('|')}>`);

const { experimental_readRawConfig } = await import('wrangler');
const { rawConfig, configPath } = experimental_readRawConfig({ config: 'wrangler.jsonc' });
if (!configPath) fail('No wrangler.jsonc in the current directory: run this from the app directory.');

const unset = bindingsWithoutDatabaseId(rawConfig);
if (unset.length > 0) {
  fail(`The database_id of ${unset.join(', ')} in wrangler.jsonc is still the placeholder: paste the id that \`wrangler d1 create\` printed.`);
}

// .wrangler is ignored by git.
const remoteConfigPath = path.resolve('.wrangler', 'remote-bindings.jsonc');
mkdirSync(path.dirname(remoteConfigPath), { recursive: true });
writeFileSync(remoteConfigPath, JSON.stringify(remoteBindingsConfig(rawConfig, REMOTE_BINDINGS), null, 2));
try {
  const result = spawnSync(command, {
    env: {
      ...process.env,
      // The migration needs no secret, and a CI job that only migrates has none.
      PAYLOAD_SECRET: process.env.PAYLOAD_SECRET || (name === 'migrate' ? 'ignore' : ''),
      WRANGLER_CONFIG_PATH: remoteConfigPath,
      WRANGLER_REMOTE_BINDINGS: 'true',
    },
    shell: true,
    stdio: 'inherit',
  });
  process.exitCode = result.status ?? 1;
} finally {
  rmSync(remoteConfigPath, { force: true });
}
