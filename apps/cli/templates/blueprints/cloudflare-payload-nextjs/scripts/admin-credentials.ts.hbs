const MIN_REMOTE_PASSWORD_LENGTH = 12;

type Env = Record<string, string | undefined>;
export type AdminCredentials = { email: string; password: string } | { error: string };

/**
 * The email and password of the admin to create, from ADMIN_EMAIL and ADMIN_PASSWORD, or what is wrong with them. The
 * example password is for the local database: the production admin is reachable from the internet, so a run against
 * the remote bindings takes a longer one.
 */
export function adminCredentials(env: Env, envFile: string): AdminCredentials {
  const { ADMIN_EMAIL: email, ADMIN_PASSWORD: password } = env;
  if (!email || !password) {
    return { error: `Set ADMIN_EMAIL and ADMIN_PASSWORD in ${envFile} (copy ${envFile}.example).` };
  }
  if (env.WRANGLER_REMOTE_BINDINGS === 'true' && password.length < MIN_REMOTE_PASSWORD_LENGTH) {
    return {
      error: `Choose an ADMIN_PASSWORD of at least ${MIN_REMOTE_PASSWORD_LENGTH} characters in ${envFile} before creating the admin of the production database.`,
    };
  }
  return { email, password };
}
