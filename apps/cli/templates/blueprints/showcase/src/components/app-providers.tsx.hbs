'use client';

import { ConsentBanner, ConsentDialog, ConsentManagerProvider } from '@c15t/nextjs';
import posthog from 'posthog-js';
import type React from 'react';

interface AppProvidersProps {
  children: React.ReactNode;
}

export function AppProviders({ children }: AppProvidersProps) {
  return (
    <ConsentManagerProvider
      options=\{{
        mode: 'offline',
        consentCategories: ['necessary', 'measurement'],
        colorScheme: 'dark',
        i18n: {
          locale: 'en',
          messages: {
            en: {
              common: {
                acceptAll: 'Accept',
                rejectAll: 'Reject',
                customize: 'Customize',
                save: 'Save',
              },
              cookieBanner: {
                title: 'Cookies',
                description:
                  'We use cookies to measure site traffic. You can accept or reject them.',
              },
              consentManagerDialog: {
                title: 'Cookie preferences',
                description: 'Choose which cookies you want to allow.',
              },
              consentTypes: {
                necessary: {
                  title: 'Essential cookies',
                  description: 'Required for the site to function.',
                },
                measurement: {
                  title: 'Analytics',
                  description: 'Help us understand how the site is used.',
                },
              },
            },
          },
        },
        callbacks: {
          onConsentSet: ({ preferences }) => {
            if (preferences.measurement) {
              posthog.opt_in_capturing();
            } else {
              posthog.opt_out_capturing();
            }
          },
        },
      }}
    >
      {children}
      <ConsentBanner />
      <ConsentDialog />
    </ConsentManagerProvider>
  );
}
