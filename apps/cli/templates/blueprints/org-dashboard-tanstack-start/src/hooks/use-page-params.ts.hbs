import { useNavigate, useSearch } from '@tanstack/react-router';
import { pageControls, parsePageParams } from '@repo/api/pagination';

export function usePageParams() {
  const navigate = useNavigate();
  const params = parsePageParams(useSearch({ strict: false }));

  return pageControls(params, (search) =>
    navigate({ to: '.', search: (previous) => ({ ...previous, page: undefined, pageSize: undefined, ...search }) }),
  );
}
