import { createFileRoute, notFound } from '@tanstack/react-router';
import { UserDetail } from '@/components/admin/user-detail';
import { DetailPending } from '@/components/detail-pending';
import { QueryBoundary } from '@/components/query-boundary';
import { pageTitle } from '@/lib/page-title';

export const Route = createFileRoute('/_dashboard/admin/users/$id')({
  loader: async ({ context, params }) => {
    const user = await context.queryClient.fetchQuery(context.trpc.user.getById.queryOptions({ id: params.id }));
    if (!user) throw notFound();
  },
  head: () => ({ meta: [{ title: pageTitle('User') }] }),
  pendingComponent: DetailPending,
  component: UserPage,
});

function UserPage() {
  const { id } = Route.useParams();

  return (
    <QueryBoundary>
      <UserDetail id={id} />
    </QueryBoundary>
  );
}
