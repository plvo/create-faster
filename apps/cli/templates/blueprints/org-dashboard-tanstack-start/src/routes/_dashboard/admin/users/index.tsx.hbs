import { createFileRoute } from '@tanstack/react-router';
import { pageSearch, parsePageParams } from '@repo/api/pagination';
import { UsersClient } from '@/components/admin/users-client';
import { QueryBoundary } from '@/components/query-boundary';
import { pageTitle } from '@/lib/page-title';

export const Route = createFileRoute('/_dashboard/admin/users/')({
  validateSearch: pageSearch,
  loaderDeps: ({ search }) => parsePageParams(search),
  loader: ({ context, deps }) => {
    void context.queryClient.prefetchQuery(context.trpc.user.list.queryOptions(deps));
    void context.queryClient.prefetchQuery(context.trpc.user.count.queryOptions());
  },
  head: () => ({ meta: [{ title: pageTitle('Users') }] }),
  component: UsersPage,
});

function UsersPage() {
  return (
    <QueryBoundary>
      <UsersClient />
    </QueryBoundary>
  );
}
