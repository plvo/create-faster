---
mono:
  scope: root
---
{{{{raw}}}}
name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      stage:
        description: Deployment stage
        type: choice
        options:
          - staging
          - production

permissions:
  id-token: write
  contents: read

concurrency:
  group: deploy-${{ github.event_name == 'workflow_dispatch' && inputs.stage || 'staging' }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: ${{ github.event_name == 'workflow_dispatch' && inputs.stage || 'staging' }}
    steps:
      - uses: actions/checkout@v4

      - uses: oven-sh/setup-bun@v2
{{{{/raw}}}}
{{#if (eq pm "pnpm")}}

      - uses: pnpm/action-setup@v4
{{/if}}

      - run: {{#if (eq pm "bun")}}bun install --frozen-lockfile{{else if (eq pm "pnpm")}}pnpm install --frozen-lockfile{{else if pm}}npm ci{{else}}npm install{{/if}}
{{{{raw}}}}

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

{{{{/raw}}}}
{{#if (hasRootScript "lint")}}
      - name: Lint
        run: {{#if pm}}{{pm}}{{else}}npm{{/if}} run lint

{{/if}}
      - name: Build
        run: {{#if pm}}{{pm}}{{else}}npm{{/if}} run build
{{{{raw}}}}

      - name: Deploy
        run: npx sst deploy --stage ${{ github.event_name == 'workflow_dispatch' && inputs.stage || 'staging' }}
{{{{/raw}}}}
