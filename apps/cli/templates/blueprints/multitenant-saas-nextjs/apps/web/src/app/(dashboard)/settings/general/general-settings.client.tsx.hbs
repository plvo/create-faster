'use client';

import { useActiveOrganization } from '@repo/auth/auth-client';
import { Button } from '@repo/ui/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@repo/ui/components/ui/card';
import { Input } from '@repo/ui/components/ui/input';
import { Label } from '@repo/ui/components/ui/label';
import { useMutation } from '@tanstack/react-query';
import { useRouter } from 'next/navigation';
import { useState } from 'react';
import { toast } from 'sonner';
import { z } from 'zod';
import { useAppForm } from '@repo/ui/lib/form';
import { Can } from '@/components/can';
import { usePermission } from '@/hooks/use-permission';
import { useTRPC } from '@/trpc/providers';

{{{{raw}}}}
const generalSchema = z.object({
  name: z.string().min(1, 'Name is required'),
  slug: z.string().min(1, 'Slug is required'),
});

export function GeneralSettingsClient() {
  const router = useRouter();
  const trpc = useTRPC();
  const { data: active, refetch } = useActiveOrganization();
  const { allowed: canUpdate } = usePermission({ organization: ['update'] });
  const [confirmInput, setConfirmInput] = useState('');

  const updateOrg = useMutation(
    trpc.organization.update.mutationOptions({
      onSuccess: () => {
        toast.success('Saved');
        refetch();
      },
      onError: (err) => toast.error(err.message),
    }),
  );

  const deleteOrg = useMutation(
    trpc.organization.delete.mutationOptions({
      onSuccess: () => {
        toast.success('Organization deleted');
        router.push('/onboarding');
      },
      onError: (err) => toast.error(err.message),
    }),
  );

  const form = useAppForm({
    defaultValues: { name: active?.name ?? '', slug: active?.slug ?? '' },
    validators: { onChange: generalSchema },
    onSubmit: ({ value }) => {
      updateOrg.mutate({ name: value.name, slug: value.slug });
    },
  });

  function handleDelete() {
    if (!active) return;
    if (confirmInput !== active.slug) {
      toast.error('Confirmation does not match the organization slug.');
      return;
    }
    deleteOrg.mutate();
  }

  if (!active) return null;

  return (
    <div className='space-y-6'>
      <Card>
        <CardHeader>
          <CardTitle>General</CardTitle>
          <CardDescription>Organization name and URL slug.</CardDescription>
        </CardHeader>
        <CardContent>
          <form
            onSubmit={(e) => {
              e.preventDefault();
              form.handleSubmit();
            }}
            className='space-y-4'
          >
            <form.AppField name='name'>
              {(field) => <field.InputField label='Name' props={{ disabled: !canUpdate }} />}
            </form.AppField>
            <form.AppField name='slug'>
              {(field) => <field.InputField label='Slug' props={{ disabled: !canUpdate }} />}
            </form.AppField>
            {canUpdate ? (
              <form.AppForm>
                <form.SubmitButton props={{ disabled: updateOrg.isPending }}>Save</form.SubmitButton>
              </form.AppForm>
            ) : null}
          </form>
        </CardContent>
      </Card>

      <Can permissions={{ organization: ['delete'] }}>
        <Card className='border-destructive'>
          <CardHeader>
            <CardTitle className='text-destructive'>Danger zone</CardTitle>
            <CardDescription>Deleting an organization is permanent.</CardDescription>
          </CardHeader>
          <CardContent className='space-y-4'>
            <div className='space-y-2'>
              <Label htmlFor='confirm'>
                Type the slug <span className='font-mono'>{active.slug}</span> to confirm.
              </Label>
              <Input id='confirm' value={confirmInput} onChange={(e) => setConfirmInput(e.target.value)} />
            </div>
            <Button variant='destructive' onClick={handleDelete}>
              Delete organization
            </Button>
          </CardContent>
        </Card>
      </Can>
    </div>
  );
}
{{{{/raw}}}}
