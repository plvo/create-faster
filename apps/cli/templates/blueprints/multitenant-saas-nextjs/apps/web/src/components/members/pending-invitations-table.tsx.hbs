'use client';

import { Button } from '@repo/ui/components/ui/button';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@repo/ui/components/ui/table';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { toast } from 'sonner';
import { Can } from '@/components/can';
import { formatDate } from '@/lib/format-date';
import { getAppUrl } from '@/lib/get-app-url';
import { useTRPC } from '@/trpc/providers';

{{{{raw}}}}
type Invitation = {
  id: string;
  email: string;
  role: string;
  status: string;
  expiresAt?: Date | string | null;
};

function buildLink(id: string): string {
  return `${getAppUrl()}/accept-invitation/${id}`;
}

export function PendingInvitationsTable() {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const { data: invitations, isLoading } = useQuery(trpc.invitation.list.queryOptions());
  const cancel = useMutation(
    trpc.invitation.cancel.mutationOptions({
      onSuccess: () => queryClient.invalidateQueries(trpc.invitation.list.queryFilter()),
      onError: (err) => toast.error(err.message),
    }),
  );

  if (isLoading) return <div>Loading...</div>;
  const pending = ((invitations as Invitation[] | undefined) ?? []).filter((i) => i.status === 'pending');
  if (pending.length === 0) return <p className='text-sm text-muted-foreground'>No pending invitations.</p>;

  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>Email</TableHead>
          <TableHead>Role</TableHead>
          <TableHead className='hidden sm:table-cell'>Expires</TableHead>
          <TableHead />
        </TableRow>
      </TableHeader>
      <TableBody>
        {pending.map((i) => (
          <TableRow key={i.id}>
            <TableCell className='break-all whitespace-normal'>{i.email}</TableCell>
            <TableCell>{i.role}</TableCell>
            <TableCell className='hidden sm:table-cell'>{i.expiresAt ? formatDate(i.expiresAt) : '—'}</TableCell>
            <TableCell>
              <div className='flex flex-wrap gap-2'>
                <Button
                  variant='outline'
                  size='sm'
                  onClick={async () => {
                    await navigator.clipboard.writeText(buildLink(i.id));
                    toast.success('Link copied');
                  }}
                >
                  Copy link
                </Button>
                <Can permissions={{ invitation: ['cancel'] }}>
                  <Button variant='ghost' size='sm' onClick={() => cancel.mutate({ invitationId: i.id })}>
                    Cancel
                  </Button>
                </Can>
              </div>
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
{{{{/raw}}}}
