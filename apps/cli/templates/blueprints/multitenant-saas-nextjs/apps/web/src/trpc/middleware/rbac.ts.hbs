import type { statement } from '@repo/auth/permissions';
import { TRPCError } from '@trpc/server';
import { auth } from '../auth';
{{#if (isMono)}}
import { protectedProcedure } from '../trpc';
{{else}}
import { protectedProcedure } from '@/trpc/init';
{{/if}}

{{{{raw}}}}
export const orgProcedure = protectedProcedure.use(async ({ ctx, next }) => {
  const orgId = ctx.session.session.activeOrganizationId;
  if (!orgId) {
    throw new TRPCError({
      code: 'FORBIDDEN',
      message: 'No active organization. Switch to an organization or create one.',
    });
  }
  return next({ ctx: { ...ctx, orgId } });
});

type Statement = typeof statement;

// Whether the caller's role in the organization holds the permission, as `permissionProcedure` and the palette search
// ask it. A resource and action that the statement does not declare fail to compile. better-auth refuses a caller who
// is not a member of the organization.
export async function hasPermission<Resource extends keyof Statement>(
  headers: Headers,
  organizationId: string,
  resource: Resource,
  action: Statement[Resource][number],
): Promise<boolean> {
  const result = await auth.api.hasPermission({
    headers,
    body: { organizationId, permissions: { [resource]: [action] } },
  });
  return result.success;
}

export const permissionProcedure = <Resource extends keyof Statement>(
  resource: Resource,
  action: Statement[Resource][number],
) =>
  orgProcedure.use(async ({ ctx, next }) => {
    if (!(await hasPermission(ctx.headers, ctx.orgId, resource, action))) {
      throw new TRPCError({
        code: 'FORBIDDEN',
        message: `Missing permission ${resource}.${action}`,
      });
    }
    return next();
  });

export function assertInScope<T extends { organizationId: string }>(
  row: T | undefined | null,
  ctx: { orgId: string },
): asserts row is T {
  if (!row || row.organizationId !== ctx.orgId) {
    throw new TRPCError({ code: 'NOT_FOUND' });
  }
}
