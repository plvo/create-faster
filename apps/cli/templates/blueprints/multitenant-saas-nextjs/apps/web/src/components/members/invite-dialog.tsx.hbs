'use client';

import { Button } from '@repo/ui/components/ui/button';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '@repo/ui/components/ui/dialog';
import { useState } from 'react';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { toast } from 'sonner';
import { z } from 'zod';
import { useAppForm } from '@repo/ui/lib/form';
import { Can } from '@/components/can';
import { useTRPC } from '@/trpc/providers';
import { InvitationLinkDialog } from './invitation-link-dialog';

{{{{raw}}}}
const inviteSchema = z.object({
  email: z.email('Enter a valid email'),
  role: z.string().min(1, 'Role is required'),
});

export function InviteDialog() {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const [open, setOpen] = useState(false);
  const [linkDialog, setLinkDialog] = useState<{ open: boolean; link: string; email: string }>({
    open: false,
    link: '',
    email: '',
  });

  const { data: assignable } = useQuery(trpc.member.assignableRoles.queryOptions());

  const create = useMutation(
    trpc.invitation.create.mutationOptions({
      onSuccess: (data) => {
        setOpen(false);
        form.reset({ email: '', role: defaultRole });
        queryClient.invalidateQueries(trpc.invitation.list.queryFilter());
        setLinkDialog({ open: true, link: (data as { inviteLink: string; email?: string }).inviteLink, email: (data as { email?: string }).email ?? '' });
      },
      onError: (err) => toast.error(err.message),
    }),
  );

  const roles = assignable ?? [];
  const roleOptions = Object.fromEntries(roles.map((r) => [r, r]));
  const defaultRole = roles.includes('member') ? 'member' : (roles[0] ?? '');

  const form = useAppForm({
    defaultValues: { email: '', role: defaultRole },
    validators: { onChange: inviteSchema },
    onSubmit: ({ value }) => {
      create.mutate({ email: value.email, role: roles.includes(value.role) ? value.role : defaultRole });
    },
  });

  return (
    <>
      <Can permissions={{ invitation: ['create'] }}>
        <Dialog open={open} onOpenChange={setOpen}>
          <DialogTrigger asChild>
            <Button>Invite member</Button>
          </DialogTrigger>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>Invite member</DialogTitle>
              <DialogDescription>You&apos;ll get a link to share with the invited person.</DialogDescription>
            </DialogHeader>
            <form
              onSubmit={(e) => {
                e.preventDefault();
                form.handleSubmit();
              }}
              className='space-y-4'
            >
              <form.AppField name='email'>
                {(field) => <field.InputField label='Email' props={{ type: 'email' }} />}
              </form.AppField>
              <form.AppField name='role'>
                {(field) => <field.SelectField label='Role' options={roleOptions} />}
              </form.AppField>
              <div className='flex justify-end gap-2'>
                <Button type='button' variant='outline' onClick={() => setOpen(false)}>
                  Cancel
                </Button>
                <form.AppForm>
                  <form.SubmitButton props={{ disabled: create.isPending }}>Create invitation</form.SubmitButton>
                </form.AppForm>
              </div>
            </form>
          </DialogContent>
        </Dialog>
      </Can>
      <InvitationLinkDialog
        open={linkDialog.open}
        onOpenChange={(o) => setLinkDialog((s) => ({ ...s, open: o }))}
        inviteLink={linkDialog.link}
        email={linkDialog.email}
      />
    </>
  );
}
{{{{/raw}}}}
