---
mono:
  scope: app
  path: src/app/(dashboard)/documents.client.tsx
---
{{{{raw}}}}
'use client';

import { useRef, useState } from 'react';
import { useMutation, useQueryClient, useSuspenseQueries } from '@tanstack/react-query';
import { toast } from 'sonner';
import { Trash2, Upload } from 'lucide-react';
import { z } from 'zod';
import { Field, FieldLabel } from '@repo/ui/components/ui/field';
import { Input } from '@repo/ui/components/ui/input';
import { useAppForm } from '@repo/ui/lib/form';
import { useTRPC } from '@/trpc/providers';
import { Can } from '@/components/can';
import { ConfirmDialog } from '@/components/confirm-dialog';
import { COUNT_STALE_TIME } from '@repo/api/pagination';
import { formatDate } from '@/lib/format-date';
import { formatFileSize } from '@/lib/format-file-size';
import { invalidatePagedList } from '@/lib/invalidate-paged-list';
import { responseErrorMessage } from '@/lib/response-error';
import { PagedList } from '@/components/table-pagination';
import { usePageParams } from '@/hooks/use-page-params';

const schema = z.object({
  title: z.string().max(200),
});

// `userId` is the signed-in user, read by the page on the server: a row is theirs when it carries it.
export function DocumentsClient({ userId }: { userId: string }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const pagination = usePageParams();
  const [{ data: documents }, { data: total }] = useSuspenseQueries({
    queries: [
      trpc.documents.list.queryOptions({ page: pagination.page, pageSize: pagination.pageSize }),
      trpc.documents.count.queryOptions(undefined, { staleTime: COUNT_STALE_TIME }),
    ],
  });
  const fileRef = useRef<HTMLInputElement>(null);
  const [deleting, setDeleting] = useState<{ id: string; title: string } | null>(null);

  const deleteMutation = useMutation(
    trpc.documents.delete.mutationOptions({
      onSuccess: () => {
        invalidatePagedList(queryClient, trpc.documents);
        toast.success('Document deleted');
        setDeleting(null);
      },
      onError: (error) => toast.error(error.message),
    }),
  );

  const form = useAppForm({
    defaultValues: { title: '' },
    validators: { onSubmit: schema },
    onSubmit: async ({ value, formApi }) => {
      const file = fileRef.current?.files?.[0];
      if (!file) {
        toast.error('Select a file first');
        return;
      }

      const body = new FormData();
      body.append('file', file);
      body.append('title', value.title || file.name);

      try {
        const res = await fetch('/api/documents/upload', { method: 'POST', body });
        if (!res.ok) throw new Error(await responseErrorMessage(res, 'Upload failed'));
        invalidatePagedList(queryClient, trpc.documents);
        toast.success('Document uploaded');
        formApi.reset();
        if (fileRef.current) fileRef.current.value = '';
      } catch (err) {
        toast.error(err instanceof Error ? err.message : 'Upload failed');
      }
    },
  });

  return (
    <div className='space-y-6'>
      <div className='space-y-1'>
        <h1 className='text-3xl font-bold'>Documents</h1>
        <p className='text-sm text-muted-foreground'>Upload, browse and remove your documents.</p>
      </div>
      <Can permissions={{ document: ['create'] }}>
        <form
          onSubmit={(e) => {
            e.preventDefault();
            form.handleSubmit();
          }}
          className='flex flex-wrap items-end gap-3 rounded-lg border p-4'
        >
          <div className='min-w-48 flex-1'>
            <form.AppField name='title'>
              {(f) => <f.InputField label='Title' props={{ placeholder: 'Document title' }} />}
            </form.AppField>
          </div>
          <Field className='min-w-56 flex-1 gap-2'>
            <FieldLabel htmlFor='document-file'>File</FieldLabel>
            <Input id='document-file' ref={fileRef} type='file' />
          </Field>
          <form.AppForm>
            <form.SubmitButton>
              <Upload className='size-4' />
              Upload
            </form.SubmitButton>
          </form.AppForm>
        </form>
      </Can>

      <PagedList
        {...pagination}
        total={total}
        rowCount={documents.length}
        itemName='documents'
        emptyMessage='No documents yet. Upload your first document to get started.'
      >
        <div className='rounded-lg border'>
          <table className='w-full text-sm'>
            <thead>
              <tr className='border-b bg-muted/50'>
                <th className='px-4 py-3 text-left font-medium'>Title</th>
                <th className='hidden px-4 py-3 text-left font-medium sm:table-cell'>Size</th>
                <th className='hidden px-4 py-3 text-left font-medium md:table-cell'>Uploaded</th>
                <th className='px-4 py-3' />
              </tr>
            </thead>
            <tbody>
              {documents.map((doc) => (
                <tr key={doc.id} className='border-b last:border-0 hover:bg-muted/50'>
                  <td className='px-4 py-3 font-medium'>{doc.title}</td>
                  <td className='hidden px-4 py-3 text-muted-foreground sm:table-cell'>
                    {doc.size != null ? formatFileSize(doc.size) : '—'}
                  </td>
                  <td className='hidden px-4 py-3 text-muted-foreground md:table-cell'>
                    {formatDate(doc.createdAt)}
                  </td>
                  <td className='px-4 py-3 text-right'>
                    <Can permissions={{ document: doc.userId === userId ? ['delete'] : ['delete', 'delete-any'] }}>
                      <button
                        type='button'
                        onClick={() => setDeleting({ id: doc.id, title: doc.title })}
                        className='text-destructive hover:text-destructive/80'
                        aria-label={`Delete ${doc.title}`}
                      >
                        <Trash2 className='size-4' />
                      </button>
                    </Can>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </PagedList>

      <ConfirmDialog
        open={deleting !== null}
        onOpenChange={(open) => {
          if (!open) setDeleting(null);
        }}
        title='Delete document'
        description={`${deleting?.title ?? 'This document'} will be deleted. This cannot be undone.`}
        confirmLabel='Delete'
        disabled={deleteMutation.isPending}
        onConfirm={() => {
          if (deleting) deleteMutation.mutate({ id: deleting.id });
        }}
      />
    </div>
  );
}
{{{{/raw}}}}
