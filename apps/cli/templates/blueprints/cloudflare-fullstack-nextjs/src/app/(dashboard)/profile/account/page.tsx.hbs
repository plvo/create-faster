---
mono:
  scope: app
  path: src/app/(dashboard)/profile/account/page.tsx
---
import type { Metadata } from 'next';
import { AccountForm } from '@/components/profile/account-form';
import { AvatarUpload } from '@/components/profile/avatar-upload';
import { ChangeEmailForm } from '@/components/profile/change-email-form';
import { EmailChangeNoticeAlert } from '@/components/profile/email-change-notice';
import { type EmailChangeSearch, emailChangeNotice } from '@/lib/auth/email-change';
import { requireSession } from '@/lib/auth/session';

export const metadata: Metadata = { title: 'Account' };

export default async function AccountPage({ searchParams }: { searchParams: Promise<EmailChangeSearch> }) {
  const session = await requireSession();
  const notice = emailChangeNotice(await searchParams, session.user.email);

  const { name, email, image, createdAt } = session.user;

  return (
    <div className='space-y-6'>
      <EmailChangeNoticeAlert notice={notice} />
      <AvatarUpload name={name} image={image ?? null} />
      <AccountForm initialName={name} email={email} createdAt={new Date(createdAt).toISOString()} />
      <ChangeEmailForm email={email} />
    </div>
  );
}
