mono:
  scope: app
  path: src/app/(dashboard)/admin/roles/page.tsx
---
{{{{raw}}}}
import { Check, Minus } from 'lucide-react';
import type { Metadata } from 'next';
import { ADMIN_PERMISSIONS, ADMIN_ROLE, PERMISSIONS } from '@repo/auth/permissions';
import { listRoleMatrix } from '@repo/auth/role-permissions';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '@repo/ui/components/ui/table';
import { requireAdmin } from '@/lib/auth/session';
import { getDb } from '@/lib/server';

export const metadata: Metadata = { title: 'Roles' };

export default async function RolesPage() {
  const session = await requireAdmin();

  // `admin` is compiled and holds what ADMIN_PERMISSIONS lists; every other role is a row of the database.
  const columns = [
    { id: ADMIN_ROLE, granted: new Set<string>(ADMIN_PERMISSIONS) },
    ...(await listRoleMatrix(await getDb())).map((role) => ({ id: role.id, granted: new Set<string>(role.permissions) })),
  ];
  const currentRole = session.user.role;

  return (
    <div className='space-y-6'>
      <div className='space-y-1'>
        <h1 className='text-3xl font-bold'>Roles</h1>
        <p className='text-sm text-muted-foreground'>
          What each role may do. The roles and their permissions on business resources are rows of the{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>roles</code> and{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>role_permissions</code> tables; <strong>admin</strong> and the{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>user</code> and{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>session</code> permissions are compiled in{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs wrap-anywhere'>packages/auth/src/permissions.ts</code>. This view is
          read-only.
        </p>
      </div>

      <div className='overflow-hidden rounded-lg border'>
        <Table>
          <TableCaption className='sr-only'>Permissions granted to each role</TableCaption>
          <TableHeader>
            <TableRow className='bg-muted/50'>
              <TableHead scope='col' className='px-2 sm:px-4'>
                Permission
              </TableHead>
              {columns.map((role) => (
                <TableHead
                  key={role.id}
                  scope='col'
                  className={`px-2 text-center capitalize sm:px-4 ${role.id === currentRole ? 'bg-primary/10 text-primary' : ''}`}
                >
                  {role.id}
                  {role.id === currentRole && <span className='block text-xs font-normal normal-case sm:ml-1 sm:inline'>(you)</span>}
                </TableHead>
              ))}
            </TableRow>
          </TableHeader>
          <TableBody>
            {PERMISSIONS.map((permission) => {
              const [resource, action] = permission.split('.');
              return (
                <TableRow key={permission}>
                  <TableHead scope='row' className='px-2 py-3 font-normal whitespace-normal wrap-anywhere sm:px-4'>
                    <span className='font-medium'>{resource}</span>
                    <span className='text-muted-foreground'>.{action}</span>
                  </TableHead>
                  {columns.map((role) => {
                    const granted = role.granted.has(permission);
                    return (
                      <TableCell
                        key={role.id}
                        className={`px-2 py-3 text-center sm:px-4 ${role.id === currentRole ? 'bg-primary/5' : ''}`}
                      >
                        {granted ? (
                          <Check className='mx-auto size-4 text-primary' />
                        ) : (
                          <Minus className='mx-auto size-4 text-muted-foreground' />
                        )}
                        <span className='sr-only'>{granted ? 'Allowed' : 'Denied'}</span>
                      </TableCell>
                    );
                  })}
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
      </div>
    </div>
  );
}
{{{{/raw}}}}
