mono:
  scope: app
  path: src/app/(dashboard)/admin/roles/page.tsx
---
{{{{raw}}}}
import { Check, Minus } from 'lucide-react';
import type { Metadata } from 'next';
import { headers } from 'next/headers';
import { redirect } from 'next/navigation';
import { roleDefinitions, statement } from '@repo/auth/permissions';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '@repo/ui/components/ui/table';
import { getAuth } from '@/lib/server';

export const metadata: Metadata = { title: 'Roles' };

type RoleName = keyof typeof roleDefinitions;
type ResourceName = keyof typeof statement;

function isGranted(role: RoleName, resource: string, action: string): boolean {
  // roleDefinitions[role] has a different shape per role, so index it generically.
  const perms = roleDefinitions[role] as Record<string, readonly string[] | undefined>;
  return perms[resource]?.includes(action) ?? false;
}

export default async function RolesPage() {
  const auth = await getAuth();
  const session = await auth.api.getSession({ headers: await headers() });
  if (session?.user.role !== 'admin') redirect('/');

  const currentRole = session.user.role as RoleName;
  const roleNames = Object.keys(roleDefinitions) as RoleName[];
  const rows = (Object.keys(statement) as ResourceName[]).flatMap((resource) =>
    statement[resource].map((action) => ({ resource, action })),
  );

  return (
    <div className='space-y-6'>
      <div className='space-y-1'>
        <h1 className='text-3xl font-bold'>Roles</h1>
        <p className='text-sm text-muted-foreground'>
          Permissions granted to each role. Roles are defined in code at{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs wrap-anywhere'>packages/auth/src/permissions.ts</code> —
          this view is read-only.
        </p>
      </div>

      <div className='rounded-lg border'>
        <Table>
          <TableCaption className='sr-only'>Permissions granted to each role</TableCaption>
          <TableHeader>
            <TableRow className='bg-muted/50'>
              <TableHead scope='col' className='px-2 sm:px-4'>
                Permission
              </TableHead>
              {roleNames.map((role) => (
                <TableHead
                  key={role}
                  scope='col'
                  className={`px-2 text-center capitalize sm:px-4 ${role === currentRole ? 'bg-primary/10 text-primary' : ''}`}
                >
                  {role}
                  {role === currentRole && <span className='block text-xs font-normal normal-case sm:ml-1 sm:inline'>(you)</span>}
                </TableHead>
              ))}
            </TableRow>
          </TableHeader>
          <TableBody>
            {rows.map(({ resource, action }) => (
              <TableRow key={`${resource}.${action}`}>
                <TableHead scope='row' className='px-2 py-3 font-normal whitespace-normal wrap-anywhere sm:px-4'>
                  <span className='font-medium'>{resource}</span>
                  <span className='text-muted-foreground'>.{action}</span>
                </TableHead>
                {roleNames.map((role) => {
                  const granted = isGranted(role, resource, action);
                  return (
                    <TableCell
                      key={role}
                      className={`px-2 py-3 text-center sm:px-4 ${role === currentRole ? 'bg-primary/5' : ''}`}
                    >
                      {granted ? (
                        <Check className='mx-auto size-4 text-primary' />
                      ) : (
                        <Minus className='mx-auto size-4 text-muted-foreground' />
                      )}
                      <span className='sr-only'>{granted ? 'Allowed' : 'Denied'}</span>
                    </TableCell>
                  );
                })}
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
    </div>
  );
}
{{{{/raw}}}}
