---
mono:
  scope: app
  path: src/app/(dashboard)/page.tsx
---
import type { Metadata } from 'next';
import { Suspense } from 'react';
import { parsePageParams } from '@repo/api/pagination';
import { Skeleton } from '@repo/ui/components/ui/skeleton';
import { requireSession } from '@/lib/auth/session';
import { getQueryClient, HydrateClient, prefetch, trpc } from '@/trpc/server';
import { DocumentsClient } from './documents.client';

export const metadata: Metadata = { title: 'Documents' };

export default async function DocumentsPage({
  searchParams,
}: {
  searchParams: Promise<Record<string, string | string[] | undefined>>;
}) {
  await requireSession();
  // The layout already fetched the permissions of the caller for this request, so this reads the same answer.
  const granted = await getQueryClient().ensureQueryData(trpc.permissions.mine.queryOptions());
  if (!granted.includes('document.read')) {
    return (
      <div className='space-y-1'>
        <h1 className='text-3xl font-bold'>Documents</h1>
        <p className='text-sm text-muted-foreground'>Your role has no access to documents.</p>
      </div>
    );
  }

  prefetch(trpc.documents.list.queryOptions(parsePageParams(await searchParams)));
  prefetch(trpc.documents.count.queryOptions());

  return (
    <HydrateClient>
      <Suspense fallback={<Skeleton className='h-64 w-full' />}>
        <DocumentsClient />
      </Suspense>
    </HydrateClient>
  );
}
