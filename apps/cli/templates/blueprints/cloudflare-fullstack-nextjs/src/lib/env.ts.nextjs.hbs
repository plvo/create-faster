  path: src/lib/env.ts
---
import 'server-only';
import { getCloudflareContext } from '@opennextjs/cloudflare';
import { connection } from 'next/server';

export type Env = {
  DB: D1Database;
  STORAGE: R2Bucket;
};

export async function getEnv(): Promise<Env> {
  // Reading the context while Next.js prerenders (next build) starts a local workerd per build worker.
  await connection();
  const { env } = await getCloudflareContext({ async: true });
  return {
    DB: env.DB,
    STORAGE: env.STORAGE,
  };
}
