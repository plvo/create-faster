import { ADMIN_ROLE, type BusinessPermission, isBusinessPermission } from './permissions';

export interface DefaultRole {
  label: string;
  permissions: readonly BusinessPermission[];
}

// The roles a fresh database starts with. The names of the permissions are typed from `businessStatement`, so a
// misspelled one fails type checking. The `db:roles` command writes them.
export const DEFAULT_ROLES = {
  user: { label: 'User', permissions: ['document.create', 'document.read', 'document.update', 'document.delete'] },
  manager: { label: 'Manager', permissions: ['document.read'] },
} as const satisfies Record<string, DefaultRole>;

// A role identifier is the value of `users.role`, which the admin plugin and the SQL below carry as plain text.
const ROLE_ID = /^[a-z0-9-]+$/;

function quoted(text: string): string {
  return `'${text.replaceAll("'", "''")}'`;
}

function permissionColumns(permission: string): [string, string] {
  const [resource, action, ...rest] = permission.split('.');
  if (!resource || !action || rest.length > 0 || !isBusinessPermission(resource, action)) {
    throw new Error(`"${permission}" is not a business permission: only the resources of businessStatement can be stored`);
  }
  return [resource, action];
}

function assertValid(id: string, role: DefaultRole): void {
  if (id === ADMIN_ROLE) throw new Error(`"${ADMIN_ROLE}" is compiled, it cannot be stored`);
  if (!ROLE_ID.test(id)) throw new Error(`"${id}" is not a role identifier (lowercase letters, digits and hyphens)`);
  if (role.label.trim() === '') throw new Error(`The role "${id}" needs a label`);
  for (const permission of role.permissions) permissionColumns(permission);
}

// The SQL that writes the roles of `definitions` that are not in `existingRoleIds`, as statements that ignore a row
// that already exists. A role that exists is never written again, so a permission removed from it since stays removed.
// Every definition is validated, whether it is written or not.
export function defaultRoleStatements(
  existingRoleIds: Iterable<string>,
  definitions: Readonly<Record<string, DefaultRole>> = DEFAULT_ROLES,
): string[] {
  for (const [id, role] of Object.entries(definitions)) assertValid(id, role);

  const existing = new Set(existingRoleIds);
  return Object.entries(definitions)
    .filter(([id]) => !existing.has(id))
    .flatMap(([id, role]) => {
      const rows = role.permissions.map((permission) => {
        const [resource, action] = permissionColumns(permission);
        return `(${quoted(id)}, ${quoted(resource)}, ${quoted(action)})`;
      });
      return [
        `INSERT OR IGNORE INTO roles (id, label) VALUES (${quoted(id)}, ${quoted(role.label)});`,
        ...(rows.length > 0 ? [`INSERT OR IGNORE INTO role_permissions (role_id, resource, action) VALUES ${rows.join(', ')};`] : []),
      ];
    });
}
