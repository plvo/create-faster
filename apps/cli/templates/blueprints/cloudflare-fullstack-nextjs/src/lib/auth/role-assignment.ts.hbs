import { and, eq, roleTable, type SQL, sql, type User, type Database, userTable } from '@repo/db';
import { ADMIN_ROLE, ROLE_ID } from './permissions';

export type AccountChangeRefusalCode = 'BAD_REQUEST' | 'NOT_FOUND';

// A change the rules refuse, as the status it answers with. The guard of the `admin` plugin endpoints
// (guard-administrators.ts) turns it into the plugin's own error.
export class AccountChangeRefused extends Error {
  constructor(
    readonly code: AccountChangeRefusalCode,
    message: string,
  ) {
    super(message);
    this.name = 'AccountChangeRefused';
  }
}

const userNotFound = () => new AccountChangeRefused('NOT_FOUND', 'User not found');
const unknownRole = () => new AccountChangeRefused('BAD_REQUEST', 'That role does not exist');
const lastAdministrator = (change: 'demoted' | 'banned' | 'removed') =>
  new AccountChangeRefused('BAD_REQUEST', `The last administrator cannot be ${change}`);

// A role is the id of one role, as text: the plugin stores a list as `a,b` and reads `user,admin` as an administrator,
// which `permissionsOf` reads as nothing, so no path writes anything but one id.
export function readRoleId(value: unknown): string {
  if (typeof value !== 'string' || !ROLE_ID.test(value)) {
    throw new AccountChangeRefused('BAD_REQUEST', 'A role is one id: lowercase letters, digits and hyphens');
  }
  return value;
}

export function readUserId(value: unknown): string {
  if (typeof value !== 'string' || value === '') throw new AccountChangeRefused('BAD_REQUEST', 'Invalid user id');
  return value;
}

// An administrator other than the account being changed who can still sign in: a banned one does not keep the
// application administrable.
const anotherAdministrator = (userId: string): SQL =>
  sql`exists (select 1 from ${userTable} as other_administrator where other_administrator.id <> ${userId} and other_administrator.role = ${ADMIN_ROLE} and coalesce(other_administrator.banned, 0) = 0)`;

// The condition under which changing this account leaves an administrator. It is part of the statement that writes
// (UPDATE or DELETE ... WHERE), so the check and the write are one step: D1 has no interactive transaction, and a
// read followed by a write would let two requests each see the other administrator and both go through.
const keepsAnAdministrator = (userId: string): SQL => sql`(${userTable.role} <> ${ADMIN_ROLE} or ${anotherAdministrator(userId)})`;

// The test of `assertExistingRole`, inside the statement that writes.
const isAssignable = (role: string): SQL => sql`(${role} = ${ADMIN_ROLE} or exists (select 1 from ${roleTable} where ${roleTable.id} = ${role}))`;

async function accountExists(db: Database, userId: string): Promise<boolean> {
  const [found] = await db.select({ id: userTable.id }).from(userTable).where(eq(userTable.id, userId)).limit(1);
  return found !== undefined;
}

// `admin` is compiled and has no row; any other role must have one.
export async function assertExistingRole(db: Database, role: string): Promise<void> {
  if (role === ADMIN_ROLE) return;
  const [known] = await db.select({ id: roleTable.id }).from(roleTable).where(eq(roleTable.id, role)).limit(1);
  if (!known) throw unknownRole();
}

// Sets the role of an account to an existing one, unless the account is the last administrator and the role is not
// admin. Returns the account as written.
export async function assignRole(db: Database, userId: string, role: string): Promise<User> {
  const id = readRoleId(role);
  const [written] = await db
    .update(userTable)
    .set({ role: id, updatedAt: new Date() })
    .where(
      and(eq(userTable.id, userId), isAssignable(id), sql`(${id} = ${ADMIN_ROLE} or ${keepsAnAdministrator(userId)})`),
    )
    .returning();
  if (written) return written;

  // Nothing was written: say why. The reads only choose the message, the refusal was decided by the statement.
  if (!(await accountExists(db, userId))) throw userNotFound();
  await assertExistingRole(db, id);
  throw lastAdministrator('demoted');
}

// Marks the account banned unless it is the last administrator. The plugin's own ban follows (reason, expiry, the end
// of the sessions) and sets the same flag again, so it can never be the write that leaves no administrator.
export async function claimBan(db: Database, userId: string): Promise<void> {
  const [claimed] = await db
    .update(userTable)
    .set({ banned: true, updatedAt: new Date() })
    .where(and(eq(userTable.id, userId), keepsAnAdministrator(userId)))
    .returning({ id: userTable.id });
  if (claimed) return;
  throw (await accountExists(db, userId)) ? lastAdministrator('banned') : userNotFound();
}

// Deletes the account unless it is the last administrator. The sessions and accounts of the user go with it (foreign
// keys with cascade).
export async function removeAccount(db: Database, userId: string): Promise<void> {
  const [removed] = await db
    .delete(userTable)
    .where(and(eq(userTable.id, userId), keepsAnAdministrator(userId)))
    .returning({ id: userTable.id });
  if (removed) return;
  throw (await accountExists(db, userId)) ? lastAdministrator('removed') : userNotFound();
}

// The roles an account can be given, for the role selects: `admin` first, then the roles of the database by id.
export async function listAssignableRoles(db: Database): Promise<{ id: string; label: string }[]> {
  const stored = await db.select({ id: roleTable.id, label: roleTable.label }).from(roleTable).orderBy(roleTable.id);
  return [{ id: ADMIN_ROLE, label: 'Admin' }, ...stored.filter((role) => role.id !== ADMIN_ROLE)];
}
