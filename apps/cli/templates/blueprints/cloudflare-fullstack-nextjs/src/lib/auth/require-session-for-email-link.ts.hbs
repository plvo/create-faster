---
mono:
  scope: pkg
  name: auth
  path: src/require-session-for-email-link.ts
---
import type { BetterAuthPlugin } from 'better-auth';
import { APIError, createAuthMiddleware, getSessionFromCtx } from 'better-auth/api';

const SAME_ORIGIN_PATH = /^\/(?![/\\])/;

// Without a session, better-auth signs in whoever opens an email change link as the account that asked for the
// change. An address typed with a typo would hand the account to the person who owns that address, so the link
// only works in a browser signed in to the account, as password change and every other account action do.
export const requireSessionForEmailLink = {
  id: 'require-session-for-email-link',
  hooks: {
    before: [
      {
        matcher: (ctx) => ctx.path === '/verify-email',
        handler: createAuthMiddleware(async (ctx) => {
          if (await getSessionFromCtx(ctx)) return;
          const callbackURL = String(ctx.query?.callbackURL ?? '');
          if (!SAME_ORIGIN_PATH.test(callbackURL)) {
            throw new APIError('UNAUTHORIZED', { message: 'Sign in to confirm your new email address' });
          }
          const separator = callbackURL.includes('?') ? '&' : '?';
          throw ctx.redirect(`${callbackURL}${separator}error=SIGN_IN_REQUIRED`);
        }),
      },
    ],
  },
} satisfies BetterAuthPlugin;
