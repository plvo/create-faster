mono:
  scope: app
  path: src/components/admin/edit-user.tsx
---
{{{{raw}}}}
'use client';

import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { useRouter } from 'next/navigation';
import { KeyRound, Trash2 } from 'lucide-react';
import { useState } from 'react';
import { toast } from 'sonner';
import { z } from 'zod';
import { authClient } from '@repo/auth/auth-client';
import { DEFAULT_ROLE } from '@repo/auth/permissions';
import { Badge } from '@repo/ui/components/ui/badge';
import { Button } from '@repo/ui/components/ui/button';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@repo/ui/components/ui/select';
import { Skeleton } from '@repo/ui/components/ui/skeleton';
import { useAppForm } from '@repo/ui/lib/form';
import { GeneratedPassword } from '@/components/admin/generated-password';
import { invalidatePagedList } from '@/lib/invalidate-paged-list';
import { useTRPC } from '@/trpc/providers';

export type AdminUser = {
  id: string;
  name: string;
  email: string;
  role: string | null;
  banned: boolean | null;
  firstName: string | null;
  lastName: string | null;
  phone: string | null;
  createdAt: string | Date;
};

const profileSchema = z.object({
  name: z.string().min(1, 'Name required').max(64),
  firstName: z.string().max(255),
  lastName: z.string().max(255),
  phone: z.string().max(40),
});

const PROFILE_FIELDS = [
  { name: 'name', label: 'Display name' },
  { name: 'firstName', label: 'First name' },
  { name: 'lastName', label: 'Last name' },
  { name: 'phone', label: 'Phone' },
] as const;

const labelId = (field: string) => `edit-user-${field}`;

function ConfirmActions({
  label,
  pending,
  onConfirm,
  onCancel,
}: {
  label: string;
  pending: boolean;
  onConfirm: () => void;
  onCancel: () => void;
}) {
  return (
    <>
      <Button type='button' variant='destructive' onClick={onConfirm} disabled={pending}>
        {label}
      </Button>
      <Button type='button' variant='ghost' onClick={onCancel}>
        Cancel
      </Button>
    </>
  );
}

export function EditUser({ user }: { user: AdminUser }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const router = useRouter();
  const { data: session } = authClient.useSession();
  const isOwnAccount = session?.user.id === user.id;
  // Role, ban and delete are offered once the session says the account is someone else's, never before.
  const isOtherAccount = session !== null && session !== undefined && !isOwnAccount;
  const [newPassword, setNewPassword] = useState<string | null>(null);
  const [confirming, setConfirming] = useState<'ban' | 'delete' | null>(null);
  const rolesQuery = useQuery(trpc.users.assignableRoles.queryOptions(undefined, { enabled: isOtherAccount }));
  const currentRole = user.role ?? DEFAULT_ROLE;
  const profile = {
    name: user.name,
    firstName: user.firstName ?? '',
    lastName: user.lastName ?? '',
    phone: user.phone ?? '',
  };

  const invalidate = () => {
    queryClient.invalidateQueries(trpc.users.get.queryFilter({ id: user.id }));
    invalidatePagedList(queryClient, trpc.users);
  };

  const updateMutation = useMutation(
    trpc.users.update.mutationOptions({
      onSuccess: () => {
        invalidate();
        toast.success('Profile updated');
      },
      onError: (e) => {
        toast.error(e.message);
        form.reset(profile);
      },
    }),
  );
  const roleMutation = useMutation(
    trpc.users.setRole.mutationOptions({
      onSuccess: () => {
        invalidate();
        toast.success('Role updated');
      },
      onError: (e) => toast.error(e.message),
    }),
  );
  const passwordMutation = useMutation(
    trpc.users.setPassword.mutationOptions({
      onSuccess: ({ password }) => {
        setNewPassword(password);
        toast.success('Password reset');
      },
      onError: (e) => toast.error(e.message),
    }),
  );
  const banMutation = useMutation(
    trpc.users.setBanned.mutationOptions({
      onSuccess: () => {
        invalidate();
        setConfirming(null);
        toast.success('Status updated');
      },
      onError: (e) => toast.error(e.message),
    }),
  );
  const removeMutation = useMutation(
    trpc.users.remove.mutationOptions({
      onSuccess: () => {
        invalidatePagedList(queryClient, trpc.users);
        toast.success('User deleted');
        router.push('/admin/users');
      },
      onError: (e) => toast.error(e.message),
    }),
  );

  const form = useAppForm({
    defaultValues: profile,
    validators: { onSubmit: profileSchema },
    onSubmit: ({ value }) => {
      updateMutation.mutate({ id: user.id, ...value });
    },
  });

  return (
    <div className='max-w-2xl space-y-6'>
      <div className='space-y-0.5'>
        <div className='flex flex-wrap items-center gap-2'>
          <h1 className='min-w-0 break-words text-3xl font-bold'>{user.name}</h1>
          {user.banned && <Badge variant='destructive'>Banned</Badge>}
        </div>
        <p className='text-sm wrap-anywhere text-muted-foreground'>{user.email}</p>
      </div>

      <section className='space-y-4 rounded-lg border bg-card p-4 sm:p-6'>
        <div>
          <h2 className='text-sm font-semibold'>Profile</h2>
          <p className='text-sm text-muted-foreground'>Click a value to edit it.</p>
        </div>
        <dl className='space-y-4'>
          {PROFILE_FIELDS.map(({ name, label }) => (
            <div key={name} className='space-y-1'>
              <dt id={labelId(name)} className='text-sm font-medium'>
                {label}
              </dt>
              <dd>
                <form.AppField name={name}>
                  {(f) => <f.InlineEditField variant='boxed' labelledBy={labelId(name)} />}
                </form.AppField>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      {isOtherAccount && (
        <section className='space-y-3 rounded-lg border bg-card p-4 sm:p-6'>
          <div>
            <h2 className='text-sm font-semibold'>Role</h2>
            <p className='text-sm text-muted-foreground'>Controls what this user can access.</p>
          </div>
          {rolesQuery.isPending && <Skeleton className='h-9 w-48' />}
          {rolesQuery.isError && (
            <p role='alert' className='text-sm text-destructive'>
              The roles could not be loaded. Reload the page to try again.
            </p>
          )}
          {rolesQuery.data && (
            <Select
              value={currentRole}
              onValueChange={(role) => roleMutation.mutate({ id: user.id, role })}
              disabled={roleMutation.isPending}
            >
              <SelectTrigger aria-label='Role' className='w-48'>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                {rolesQuery.data.map((role) => (
                  <SelectItem key={role.id} value={role.id}>
                    {role.label}
                  </SelectItem>
                ))}
                {!rolesQuery.data.some((role) => role.id === currentRole) && (
                  <SelectItem value={currentRole} disabled>
                    {currentRole} (no longer exists)
                  </SelectItem>
                )}
              </SelectContent>
            </Select>
          )}
        </section>
      )}

      <section className='space-y-3 rounded-lg border bg-card p-4 sm:p-6'>
        <div>
          <h2 className='text-sm font-semibold'>Password</h2>
          <p className='text-sm text-muted-foreground'>Generate a new password. It is shown only once.</p>
        </div>
        {newPassword && <GeneratedPassword password={newPassword} />}
        <Button
          type='button'
          variant='outline'
          onClick={() => passwordMutation.mutate({ id: user.id })}
          disabled={passwordMutation.isPending}
        >
          <KeyRound className='size-4' />
          Generate new password
        </Button>
      </section>

      {isOtherAccount && (
        <section className='space-y-3 rounded-lg border border-destructive/30 bg-card p-4 sm:p-6'>
          <div>
            <h2 className='text-sm font-semibold text-destructive'>Danger zone</h2>
            <p className='text-sm text-muted-foreground'>Restrict or permanently remove this account.</p>
          </div>
          <div className='flex flex-wrap gap-2'>
            {confirming === 'ban' ? (
              <ConfirmActions
                label='Confirm ban'
                pending={banMutation.isPending}
                onConfirm={() => banMutation.mutate({ id: user.id, banned: true })}
                onCancel={() => setConfirming(null)}
              />
            ) : (
              <Button
                type='button'
                variant='outline'
                onClick={() => (user.banned ? banMutation.mutate({ id: user.id, banned: false }) : setConfirming('ban'))}
                disabled={banMutation.isPending}
              >
                {user.banned ? 'Unban user' : 'Ban user'}
              </Button>
            )}
            {confirming === 'delete' ? (
              <ConfirmActions
                label='Confirm delete'
                pending={removeMutation.isPending}
                onConfirm={() => removeMutation.mutate({ id: user.id })}
                onCancel={() => setConfirming(null)}
              />
            ) : (
              <Button type='button' variant='destructive' onClick={() => setConfirming('delete')}>
                <Trash2 className='size-4' />
                Delete user
              </Button>
            )}
          </div>
        </section>
      )}
      {isOwnAccount && (
        <p className='text-sm text-muted-foreground'>
          This is your account: you cannot change your own role, ban or delete yourself.
        </p>
      )}
    </div>
  );
}
{{{{/raw}}}}
