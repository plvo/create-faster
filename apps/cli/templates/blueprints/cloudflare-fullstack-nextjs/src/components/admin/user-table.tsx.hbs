---
mono:
  scope: app
  path: src/components/admin/user-table.tsx
---
{{{{raw}}}}
'use client';

import { useSuspenseQueries } from '@tanstack/react-query';
import { X } from 'lucide-react';
import Link from 'next/link';
import { pageCountOf } from '@repo/api/pagination';
import { DEFAULT_USER_SORT, userSortFromSorting, userSortingState } from '@repo/api/user-list';
import { Badge } from '@repo/ui/components/ui/badge';
import { Button } from '@repo/ui/components/ui/button';
import { SearchInput } from '@repo/ui/components/ui/search-input';
import { DataTableShell, type DataTableShellColumn } from '@/components/shared/data-table-shell';
import { PagedList } from '@/components/table-pagination';
import { useUserListParams } from '@/hooks/use-user-list-params';
import { useTRPC } from '@/trpc/providers';

const COUNT_STALE_TIME = 60_000;

type UserRow = {
  id: string;
  name: string;
  email: string;
  role: string | null;
  banned: boolean | null;
  firstName: string | null;
  lastName: string | null;
  phone: string | null;
  createdAt: string | Date;
};

function RoleBadge({ role }: { role: string | null }) {
  return (
    <Badge variant={role === 'admin' ? 'default' : 'secondary'} className='capitalize'>
      {role ?? 'user'}
    </Badge>
  );
}

const columns: DataTableShellColumn<UserRow>[] = [
  {
    accessorKey: 'name',
    header: 'Name',
    meta: { label: 'Name', variant: 'text' },
    cell: ({ row }) => (
      <div className='space-y-1'>
        <div className='flex flex-wrap items-center gap-2'>
          <Link href={`/admin/users/${row.original.id}`} className='font-medium hover:underline'>
            {row.original.name}
          </Link>
          {row.original.banned && <Badge variant='destructive'>Banned</Badge>}
        </div>
        <div className='flex flex-wrap items-center gap-x-2 gap-y-1 md:hidden'>
          <span className='text-xs wrap-anywhere text-muted-foreground sm:hidden'>{row.original.email}</span>
          <RoleBadge role={row.original.role} />
        </div>
      </div>
    ),
  },
  {
    accessorKey: 'email',
    header: 'Email',
    meta: { label: 'Email', variant: 'text', className: 'hidden sm:table-cell' },
    cell: ({ row }) => <span className='text-muted-foreground'>{row.original.email}</span>,
  },
  {
    accessorKey: 'role',
    header: 'Role',
    meta: { label: 'Role', variant: 'text', className: 'hidden md:table-cell' },
    enableSorting: false,
    cell: ({ row }) => <RoleBadge role={row.original.role} />,
  },
];

export function UserTable() {
  const trpc = useTRPC();
  const { page, pageSize, search, sort, setPage, setPageSize, setSearch, setSort } = useUserListParams();
  const [{ data: users }, { data: total }] = useSuspenseQueries({
    queries: [
      trpc.users.list.queryOptions({ page, pageSize, search, sort }),
      trpc.users.count.queryOptions({ search }, { staleTime: COUNT_STALE_TIME }),
    ],
  });
  const sorting = userSortingState(sort);

  return (
    <DataTableShell
      columns={columns}
      data={users as UserRow[]}
      pageCount={pageCountOf(total, pageSize)}
      totalCount={total}
      state={{ pagination: { pageIndex: page - 1, pageSize }, sorting }}
      onSortingChange={(updater) => setSort(userSortFromSorting(typeof updater === 'function' ? updater(sorting) : updater))}
      searchValue={search}
      toolbarStart={
        <>
          <SearchInput
            value={search}
            onChange={setSearch}
            placeholder='Search by name, email or role…'
            className='max-w-sm flex-1'
          />
          {sort !== DEFAULT_USER_SORT && (
            <Button variant='ghost' size='sm' onClick={() => setSort(DEFAULT_USER_SORT)}>
              <X className='size-4' />
              <span className='sr-only sm:not-sr-only'>Clear sort</span>
            </Button>
          )}
        </>
      }
      hidePagination
      wrapTable={(table) => (
        <PagedList
          page={page}
          pageSize={pageSize}
          total={total}
          rowCount={users.length}
          itemName='users'
          emptyMessage={search.trim() ? 'No users match your search.' : 'No users yet.'}
          setPage={setPage}
          setPageSize={setPageSize}
        >
          {table}
        </PagedList>
      )}
    />
  );
}
{{{{/raw}}}}
