mono:
  scope: app
  path: src/components/admin/user-table.tsx
---
{{{{raw}}}}
'use client';

import { useSuspenseQuery } from '@tanstack/react-query';
import Link from 'next/link';
import { Badge } from '@repo/ui/components/ui/badge';
import { DataTableShell, type DataTableShellColumn } from '@/components/shared/data-table-shell';
import { useTRPC } from '@/trpc/providers';

type UserRow = {
  id: string;
  name: string;
  email: string;
  role: string | null;
  banned: boolean | null;
  firstName: string | null;
  lastName: string | null;
  phone: string | null;
  createdAt: string | Date;
};

function RoleBadge({ role }: { role: string | null }) {
  return (
    <Badge variant={role === 'admin' ? 'default' : 'secondary'} className='capitalize'>
      {role ?? 'user'}
    </Badge>
  );
}

const columns: DataTableShellColumn<UserRow>[] = [
  {
    accessorKey: 'name',
    header: 'Name',
    meta: { label: 'Name', variant: 'text' },
    cell: ({ row }) => (
      <div className='space-y-1'>
        <div className='flex items-center gap-2'>
          <Link href={`/admin/users/${row.original.id}`} className='font-medium hover:underline'>
            {row.original.name}
          </Link>
          {row.original.banned && <Badge variant='destructive'>Banned</Badge>}
        </div>
        <div className='flex flex-wrap items-center gap-x-2 gap-y-1 md:hidden'>
          <span className='text-xs wrap-anywhere text-muted-foreground sm:hidden'>{row.original.email}</span>
          <RoleBadge role={row.original.role} />
        </div>
      </div>
    ),
  },
  {
    accessorKey: 'email',
    header: 'Email',
    meta: { label: 'Email', variant: 'text', className: 'hidden sm:table-cell' },
    cell: ({ row }) => <span className='text-muted-foreground'>{row.original.email}</span>,
  },
  {
    accessorKey: 'role',
    header: 'Role',
    meta: { label: 'Role', variant: 'text', className: 'hidden md:table-cell' },
    enableSorting: false,
    cell: ({ row }) => <RoleBadge role={row.original.role} />,
  },
];

export function UserTable() {
  const trpc = useTRPC();
  const { data: users } = useSuspenseQuery(trpc.users.list.queryOptions());

  return (
    <DataTableShell
      columns={columns}
      data={users as UserRow[]}
      filtering='search'
      searchPlaceholder='Search by name, email or role…'
      searchableAccessor={(user) => `${user.name} ${user.email} ${user.role ?? ''}`}
      emptyFiltered='No users match your search.'
    />
  );
}
{{{{/raw}}}}
