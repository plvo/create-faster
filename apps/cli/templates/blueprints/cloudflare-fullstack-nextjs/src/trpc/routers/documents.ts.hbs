---
mono:
  scope: pkg
  name: api
  path: src/router/documents.ts
---
import { and, count, documentTable, eq } from '@repo/db';
import { z } from 'zod';
import { router } from '../trpc';
import { permissionProcedure } from '../middleware/rbac';
import { newestFirstPage } from '../page-query';
import { pageInput } from '../pagination';

// An admin or a manager sees every document, anyone else their own.
function visibleTo(user: { id: string; role?: string | null }) {
  const isPrivileged = user.role === 'admin' || user.role === 'manager';
  return isPrivileged ? undefined : eq(documentTable.userId, user.id);
}

export const documentsRouter = router({
  list: permissionProcedure('document', 'read')
    .input(pageInput)
    .query(({ ctx, input }) =>
      newestFirstPage(ctx.db.select().from(documentTable).where(visibleTo(ctx.session.user)), documentTable, input),
    ),

  count: permissionProcedure('document', 'read').query(async ({ ctx }) => {
    const [result] = await ctx.db.select({ count: count() }).from(documentTable).where(visibleTo(ctx.session.user));
    return result?.count ?? 0;
  }),

  delete: permissionProcedure('document', 'delete')
    .input(z.object({ id: z.string() }))
    .mutation(async ({ ctx, input }) => {
      const [doc] = await ctx.db
        .select()
        .from(documentTable)
        .where(
          ctx.session.user.role === 'admin'
            ? eq(documentTable.id, input.id)
            : and(eq(documentTable.id, input.id), eq(documentTable.userId, ctx.session.user.id)),
        )
        .limit(1);
      if (!doc) return { deleted: false };

      await ctx.db.delete(documentTable).where(eq(documentTable.id, doc.id));
      const { getCloudflareContext } = await import('@opennextjs/cloudflare');
      const { env } = await getCloudflareContext({ async: true });
      await (env as { STORAGE: R2Bucket }).STORAGE.delete(doc.r2Key);
      return { deleted: true };
    }),
});
