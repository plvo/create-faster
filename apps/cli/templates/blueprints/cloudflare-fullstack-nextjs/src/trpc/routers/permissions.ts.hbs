import { callerPermissions } from '../middleware/rbac';
import { protectedProcedure, router } from '../trpc';

export const permissionsRouter = router({
  // The flat list of what the caller may do, read from the database once per request (see `callerPermissions`). The dashboard layout fetches it on
  // the server and hydrates it, so the sidebar and the buttons are right on the first render.
  mine: protectedProcedure.query(({ ctx }) => callerPermissions(ctx)),
});
