import { permissionsOf } from '@repo/auth/role-permissions';
import { protectedProcedure, router } from '../trpc';

export const permissionsRouter = router({
  // The flat list of what the caller may do, read from the database on every call. The dashboard layout fetches it on
  // the server and hydrates it, so the sidebar and the buttons are right on the first render.
  mine: protectedProcedure.query(({ ctx }) => permissionsOf(ctx.db, ctx.session.user.role)),
});
