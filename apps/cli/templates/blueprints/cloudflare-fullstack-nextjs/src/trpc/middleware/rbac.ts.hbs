import { ADMIN_ROLE, type BusinessAction, type BusinessResource, type Permission } from '@repo/auth/permissions';
import { isGranted, permissionsOf } from '@repo/auth/role-permissions';
import type { Database } from '@repo/db';
import { TRPCError } from '@trpc/server';
import { protectedProcedure } from '../trpc';

export const adminProcedure = protectedProcedure.use(async (opts) => {
  if (opts.ctx.session.user.role !== ADMIN_ROLE) {
    throw new TRPCError({ code: 'FORBIDDEN', message: 'Only admins can access this resource' });
  }
  return opts.next({ ctx: opts.ctx });
});

// The caller's permissions are read once per request: every procedure of a request (a batch, or the prefetches of a
// page) shares the `Headers` of that request, which keys the answer. The map holds its keys weakly, so nothing outlives
// the request, and the next request reads the database again. A procedure that changes roles reads `permissionsOf`
// itself afterwards.
const permissionsByRequest = new WeakMap<Headers, Promise<Permission[]>>();

export function callerPermissions(ctx: {
  db: Database;
  headers: Headers;
  session: { user: { role?: string | null } };
}): Promise<Permission[]> {
  let granted = permissionsByRequest.get(ctx.headers);
  if (!granted) {
    granted = permissionsOf(ctx.db, ctx.session.user.role);
    permissionsByRequest.set(ctx.headers, granted);
  }
  return granted;
}

// Gates a procedure on a business permission, named from the vocabulary of `businessStatement`: account administration
// (`user`, `session`) is `adminProcedure`'s. The procedures below it read `ctx.permissions`.
export const permissionProcedure = <R extends BusinessResource>(resource: R, action: BusinessAction<R>) =>
  protectedProcedure.use(async (opts) => {
    const permissions = await callerPermissions(opts.ctx);
    if (!isGranted(permissions, resource, action)) {
      throw new TRPCError({ code: 'FORBIDDEN', message: 'Missing permission' });
    }
    return opts.next({ ctx: { ...opts.ctx, permissions } });
  });
