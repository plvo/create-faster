mono:
  scope: pkg
  name: api
  path: src/middleware/rbac.ts
---
import { ADMIN_ROLE, type Action, type Resource } from '@repo/auth/permissions';
import { hasPermission } from '@repo/auth/role-permissions';
import { TRPCError } from '@trpc/server';
import { protectedProcedure } from '../trpc';

export const adminProcedure = protectedProcedure.use(async (opts) => {
  if (opts.ctx.session.user.role !== ADMIN_ROLE) {
    throw new TRPCError({ code: 'FORBIDDEN', message: 'Only admins can access this resource' });
  }
  return opts.next({ ctx: opts.ctx });
});

export const permissionProcedure = <R extends Resource>(resource: R, action: Action<R>) =>
  protectedProcedure.use(async (opts) => {
    if (!(await hasPermission(opts.ctx.db, opts.ctx.session.user.role, resource, action))) {
      throw new TRPCError({ code: 'FORBIDDEN', message: 'Missing permission' });
    }
    return opts.next({ ctx: opts.ctx });
  });
