---
mono:
  scope: root
---
import { spawn } from 'node:child_process';
import { existsSync } from 'node:fs';
import { copyFile, readdir, rm } from 'node:fs/promises';
import { join } from 'node:path';

{{> local-setup/steps}}

const steps: Step[] = [
  { label: 'Creating .env files from the .env.example files', run: createEnvFiles },
  { label: 'Resetting local D1 state', run: () => rm('.wrangler/v3/d1', { recursive: true, force: true }) },
  { label: 'Generating Drizzle migrations from schema', run: () => sh('{{runScript "db:generate"}}') },
  { label: 'Applying migrations to local D1', run: () => sh('{{runScript "db:migrate"}}', undefined, { CI: 'true' }) },
  { label: 'Generating Cloudflare env types', run: () => sh('{{runScript "cf-typegen"}}', 'apps/web') },
  { label: 'Seeding local D1 with demo data', run: () => sh('{{runScript "db:seed" "--fixtures"}}', undefined, { NODE_ENV: 'development' }) },
];

console.log('Setting up your local environment');
console.log('Note: this resets the local D1 database. Remote data is untouched.\n');

runSteps(steps).then(() => console.log('\nLocal setup complete. Sign in with one of the seeded accounts printed above, then run `{{runScript "dev"}}`.'));
