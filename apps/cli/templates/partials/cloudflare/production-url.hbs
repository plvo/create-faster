{{!-- pointer: when set, renders the one-line deploy step that points to the section instead of the section --}}
{{!-- appUrlUse: what the app does with `NEXT_PUBLIC_APP_URL` when neither better-auth nor tRPC reads it (a phrase that follows "which Next.js freezes into the build and"); a non-empty value opens the gate --}}
{{#if appUrlUse}}
{{> cloudflare/production-url-section publicUse=appUrlUse}}
{{else if (and (hasLibrary "trpc") (has "stack" "nextjs"))}}
{{> cloudflare/production-url-section publicUse="the server-side tRPC client calls"}}
{{else if (hasLibrary "better-auth")}}
{{> cloudflare/production-url-section}}
{{/if}}
