{{!-- The deliverLink module every link of a blueprint leaves the server through.
kinds: the kinds of link, as the TypeScript union (`'reset-password' | 'invitation'`).
file: the path of the generated module, named in the production warning. --}}
type LinkKind = {{kinds}};

interface LinkDelivery {
  kind: LinkKind;
  to: string;
  link: string;
}

const isDev = process.env.NODE_ENV === 'development';

/**
 * The single place the links of the project leave the server.
 * No mailer is configured: the link is logged to the server console, in development and in production.
 * Replace the body with a call to a mail provider (Resend, SES, Postmark, ...) to deliver `link` to `to`.
 */
export async function deliverLink({ kind, to, link }: LinkDelivery): Promise<void> {
  console.log(`[${kind}] ${to} → ${link}`);
  if (!isDev) {
    console.warn(
      `[${kind}] No mailer is configured: this link is only in the server logs. Plug a mailer into {{file}} before going live.`,
    );
  }
}
