{{#if (has "database" "d1")}}
export const getSession = getRequestSession;
{{else}}
export const getSession = cache(async () => auth.api.getSession({ headers: await headers() }));
{{/if}}

// The proxy puts the requested path in REQUEST_PATH_HEADER, so signing in returns to the page that was asked for. A
// client can send that header on the paths the proxy matcher skips, so the value goes through safeRedirectPath here
// as well as in the login form.
async function redirectToLogin(): Promise<never> {
  const destination = safeRedirectPath((await headers()).get(REQUEST_PATH_HEADER));
  redirect(destination === '/' ? '/login' : `/login?redirectTo=${encodeURIComponent(destination)}`);
}

// Layouts and pages render in parallel: a layout redirect does not stop the page from running. Every
// page that prefetches protected data awaits this first, so an anonymous visit redirects before any
// protected query starts. A page whose prefetch needs more than a session awaits the matching guard below
// instead (it includes requireSession), so a rejected query never starts and nothing is logged.
export async function requireSession() {
  const session = await getSession();
  if (!session?.user.role) return redirectToLogin();
  return session;
}

export async function requireAdmin() {
  const session = await requireSession();
  if (session.user.role !== 'admin') redirect('/');
  return session;
}
