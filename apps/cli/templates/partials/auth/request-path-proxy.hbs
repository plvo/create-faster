{{!-- The whole proxy file (middleware on Cloudflare), imports included. It hands the requested path to server
components in the x-request-path request header, which the guards of auth/session-guards read to send an anonymous
visitor to the login with the page they asked for. The header is always overwritten, so a client cannot choose it. --}}
import { type NextRequest, NextResponse } from 'next/server';

export default function {{#if (has "deployment" "cloudflare")}}middleware{{else}}proxy{{/if}}(request: NextRequest) {
  const { pathname, search } = request.nextUrl;

  if (process.env.NODE_ENV === 'development') {
    console.log(`{{#if (has "deployment" "cloudflare")}}MIDDLEWARE{{else}}PROXY{{/if}} "${pathname}"`);
  }

  const requestHeaders = new Headers(request.headers);
  requestHeaders.set('x-request-path', `${pathname}${search}`);
  return NextResponse.next({ request: { headers: requestHeaders } });
}

export const config = {
  matcher: [
    // Exclude API routes, static files, image optimizations, and .png files
    '/((?!api|_next/static|manifest.webmanifest|_next/image|.*\\.png$).*)',
  ],
};
