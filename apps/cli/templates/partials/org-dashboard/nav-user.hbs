{{!-- The whole NavUser component file, imports included: the user menu of the dashboard sidebar.
avatar="image": the avatar shows the user's image, with the initials as fallback (default: the initials alone).
icons="hugeicons": the icons come from Hugeicons (default: lucide-react).
showRole=true: the role follows the name in the menu trigger.
It reads from the project: @repo/ui (avatar, button, dropdown-menu, sidebar) and @repo/auth. --}}
{{#if (eq stackName "tanstack-start")}}
import { useQueryClient } from '@tanstack/react-query';
import { Link, useRouter } from '@tanstack/react-router';
{{else}}
'use client';

{{/if}}
{{#unless (eq icons "hugeicons")}}
import { ChevronsUpDown, LogOut, Moon, Sun, UserIcon } from 'lucide-react';
{{/unless}}
import { useTheme } from 'next-themes';
{{#unless (eq stackName "tanstack-start")}}
import Link from 'next/link';
import { useRouter } from 'next/navigation';
{{/unless}}
import React from 'react';
{{#if (eq icons "hugeicons")}}
import { ArrowUpDownIcon, Logout01Icon, Moon02Icon, Sun03Icon, UserIcon } from '@hugeicons/core-free-icons';
import { HugeiconsIcon } from '@hugeicons/react';
{{/if}}
{{#if (eq avatar "image")}}
import { Avatar, AvatarFallback, AvatarImage } from '@repo/ui/components/ui/avatar';
{{/if}}
import { Button } from '@repo/ui/components/ui/button';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from '@repo/ui/components/ui/dropdown-menu';
import { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from '@repo/ui/components/ui/sidebar';
import type { Session } from '@repo/auth/types';
import { authClient } from '@repo/auth/auth-client';

function UserAvatar({ user }: { user: Session['user'] }) {
  const initials = user.name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);

{{#if (eq avatar "image")}}
  return (
    <Avatar className='size-8 rounded-lg'>
      <AvatarImage src={user.image ?? undefined} alt={user.name} />
      <AvatarFallback className='rounded-lg bg-sidebar-accent text-sidebar-accent-foreground text-xs font-medium'>
        {initials}
      </AvatarFallback>
    </Avatar>
  );
{{else}}
  return (
    <div className='flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-accent text-sidebar-accent-foreground text-xs font-medium'>
      {initials}
    </div>
  );
{{/if}}
}

export function NavUser({ session }: { session: Session }) {
  const [isOpen, setIsOpen] = React.useState(false);
  const [showLogout, setShowLogout] = React.useState(false);
  const logoutItemRef = React.useRef<HTMLDivElement>(null);
  const cancelLogoutRef = React.useRef<HTMLButtonElement>(null);
  const itemToFocus = React.useRef<'logout' | 'cancel' | null>(null);
  const { isMobile } = useSidebar();
  const { resolvedTheme, setTheme } = useTheme();
  const router = useRouter();
{{#if (eq stackName "tanstack-start")}}
  const queryClient = useQueryClient();

  // The cache is cleared once the login page replaced the dashboard, so no mounted query refetches without a session.
  const handleLogout = async () => {
    await authClient.signOut();
    await router.navigate({ to: '/login' });
    queryClient.clear();
  };
{{else}}

  const handleLogout = async () => {
    await authClient.signOut();
    router.push('/login');
  };
{{/if}}

  // The confirmation and the Logout item replace each other, which would drop the keyboard focus on the page: the item
  // that takes the other's place takes the focus.
  const swapLogoutItems = (confirming: boolean) => {
    itemToFocus.current = confirming ? 'cancel' : 'logout';
    setShowLogout(confirming);
  };

  React.useEffect(() => {
    const target = itemToFocus.current === 'cancel' ? cancelLogoutRef : logoutItemRef;
    if (itemToFocus.current) target.current?.focus();
    itemToFocus.current = null;
  });

  const handleOpenChange = (open: boolean) => {
    setIsOpen(open);
    if (!open) setShowLogout(false);
  };

  const toggleTheme = () => {
    setTheme(resolvedTheme === 'dark' ? 'light' : 'dark');
  };

  return (
    <SidebarMenu>
      <SidebarMenuItem>
        <DropdownMenu modal={false} open={isOpen} onOpenChange={handleOpenChange}>
          <DropdownMenuTrigger asChild>
            <SidebarMenuButton
              size='lg'
              className='data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground'
            >
              <UserAvatar user={session.user} />
              <div className='grid flex-1 text-left text-sm leading-tight gap-1'>
                <span className='truncate font-medium'>
{{#if showRole}}
                  {session.user.name} ({session.user.role})
{{else}}
                  {session.user.name}
{{/if}}
                </span>
                <span className='truncate text-xs'>{session.user.email}</span>
              </div>
{{#if (eq icons "hugeicons")}}
              <HugeiconsIcon icon={ArrowUpDownIcon} className='ml-auto size-4' />
{{else}}
              <ChevronsUpDown className='ml-auto size-4' />
{{/if}}
            </SidebarMenuButton>
          </DropdownMenuTrigger>
          <DropdownMenuContent
            className='w-(--radix-dropdown-menu-trigger-width) min-w-56 rounded-lg'
            side={isMobile ? 'bottom' : 'top'}
            align='center'
            sideOffset={4}
          >
            <DropdownMenuLabel className='p-0 font-normal'>
              <div className='flex items-center gap-2 px-1 py-1.5 text-left text-sm'>
                <UserAvatar user={session.user} />
                <div className='grid flex-1 text-left text-sm leading-tight'>
                  <span className='truncate font-medium'>{session.user.name}</span>
                  <span className='truncate text-xs'>{session.user.email}</span>
                </div>
              </div>
            </DropdownMenuLabel>
            <DropdownMenuSeparator />
            <DropdownMenuGroup>
              <DropdownMenuItem asChild>
{{#if (eq stackName "tanstack-start")}}
                <Link to='/profile/account'>
{{else}}
                <Link href='/profile/account'>
{{/if}}
{{#if (eq icons "hugeicons")}}
                  <HugeiconsIcon icon={UserIcon} />
{{else}}
                  <UserIcon />
{{/if}}
                  Profile
                </Link>
              </DropdownMenuItem>
              <DropdownMenuItem onClick={toggleTheme}>
{{#if (eq icons "hugeicons")}}
                <HugeiconsIcon icon={resolvedTheme === 'dark' ? Sun03Icon : Moon02Icon} />
{{else}}
                {resolvedTheme === 'dark' ? <Sun /> : <Moon />}
{{/if}}
                {resolvedTheme === 'dark' ? 'Light mode' : 'Dark mode'}
              </DropdownMenuItem>
            </DropdownMenuGroup>
            <DropdownMenuSeparator />
            {showLogout ? (
              <div className='space-y-1 p-1'>
                <p className='px-1 py-1 text-sm text-muted-foreground'>Are you sure?</p>
                <DropdownMenuItem asChild onSelect={handleLogout}>
                  <Button variant='destructive' size='sm' className='w-full'>
                    Logout
                  </Button>
                </DropdownMenuItem>
                <DropdownMenuItem
                  asChild
                  onSelect={(event) => {
                    event.preventDefault();
                    swapLogoutItems(false);
                  }}
                >
                  <Button ref={cancelLogoutRef} variant='outline' size='sm' className='w-full'>
                    Cancel
                  </Button>
                </DropdownMenuItem>
              </div>
            ) : (
              <DropdownMenuItem
                ref={logoutItemRef}
                onSelect={(event) => {
                  event.preventDefault();
                  swapLogoutItems(true);
                }}
                className='hover:bg-destructive/40'
              >
{{#if (eq icons "hugeicons")}}
                <HugeiconsIcon icon={Logout01Icon} />
{{else}}
                <LogOut />
{{/if}}
                Logout
              </DropdownMenuItem>
            )}
          </DropdownMenuContent>
        </DropdownMenu>
      </SidebarMenuItem>
    </SidebarMenu>
  );
}
