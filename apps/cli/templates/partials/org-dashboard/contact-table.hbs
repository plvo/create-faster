{{#unless (eq stackName "tanstack-start")}}
'use client';

import Link from 'next/link';
{{/unless}}
import { useSuspenseQuery } from '@tanstack/react-query';
{{#if (eq stackName "tanstack-start")}}
import { Link } from '@tanstack/react-router';
{{/if}}
import { PageOutOfRange, TablePagination, pageCountOf } from '@/components/table-pagination';
import { usePageParams } from '@/hooks/use-page-params';
import { useTRPC } from '@/trpc/providers';

export function ContactTable() {
  const trpc = useTRPC();
  const { page, pageSize, setPage, setPageSize } = usePageParams();
  const { data } = useSuspenseQuery(trpc.contact.list.queryOptions({ page, pageSize }));
  const { items: contacts, total } = data;

  if (total === 0) {
    return (
      <div className='rounded-lg border bg-card p-8 text-center'>
        <p className='text-muted-foreground'>No contacts yet. Create your first contact to get started.</p>
      </div>
    );
  }

  return (
    <>
      {contacts.length === 0 ? (
        <PageOutOfRange page={page} itemName='contacts' onGoToLastPage={() => setPage(pageCountOf(total, pageSize))} />
      ) : (
        <div className='overflow-x-auto rounded-lg border'>
          <table className='w-full text-sm'>
            <thead>
              <tr className='border-b bg-muted/50'>
                <th className='px-4 py-3 text-left font-medium'>Name</th>
                <th className='px-4 py-3 text-left font-medium'>Email</th>
                <th className='hidden px-4 py-3 text-left font-medium sm:table-cell'>Phone</th>
                <th className='hidden px-4 py-3 text-left font-medium md:table-cell'>Company</th>
              </tr>
            </thead>
            <tbody>
              {contacts.map((contact) => (
                <tr key={contact.id} className='border-b last:border-0 hover:bg-muted/50'>
                  <td className='px-4 py-3'>
{{#if (eq stackName "tanstack-start")}}
{{{{raw}}}}
                    <Link to='/contacts/$id' params={{ id: contact.id }} className='font-medium text-primary hover:underline'>
{{{{/raw}}}}
{{else}}
                    <Link href={`/contacts/${contact.id}`} className='font-medium text-primary hover:underline'>
{{/if}}
                      {contact.firstName} {contact.lastName}
                    </Link>
                  </td>
                  <td className='px-4 py-3 text-muted-foreground'>{contact.email || '—'}</td>
                  <td className='hidden px-4 py-3 text-muted-foreground sm:table-cell'>{contact.phone || '—'}</td>
                  <td className='hidden px-4 py-3 text-muted-foreground md:table-cell'>{contact.company || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <TablePagination
        page={page}
        pageSize={pageSize}
        total={total}
        itemName='contacts'
        onPageChange={setPage}
        onPageSizeChange={setPageSize}
      />
    </>
  );
}
