{{#if (eq stackName "tanstack-start")}}
import { Link, useLocation } from '@tanstack/react-router';
{{else}}
'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
{{/if}}
import {
  SidebarGroup,
  SidebarGroupLabel,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
} from '@repo/ui/components/ui/sidebar';
import { allowedRoutes } from '@/lib/allowed-routes';
import type { RouteProps } from '@/lib/constants';

function RouteItem({ item, pathname }: { item: RouteProps; pathname: string }) {
  return (
    <SidebarMenuItem>
      <SidebarMenuButton
        asChild
        tooltip={item.title || item.url}
        isActive={item.url === '/' ? pathname === '/' : pathname.startsWith(item.url)}
      >
{{#if (eq stackName "tanstack-start")}}
        <Link to={item.url}>
{{else}}
        <Link href={item.url}>
{{/if}}
          {item.icon && <item.icon />}
          <span>{item.title}</span>
        </Link>
      </SidebarMenuButton>
    </SidebarMenuItem>
  );
}

// The role comes from the layout, which read the session on the server, so the first render already lists the links.
export function SidebarLinks({ role }: { role: string | null | undefined }) {
{{#if (eq stackName "tanstack-start")}}
  const pathname = useLocation({ select: (location) => location.pathname });
{{else}}
  const pathname = usePathname();
{{/if}}

  const allowedPages = allowedRoutes(role);
  const grouplessPages = allowedPages.filter((item) => !item.category);
  const groupedPages = allowedPages.reduce<Record<string, RouteProps[]>>((acc, item) => {
    if (!item.category) return acc;
    const group = acc[item.category] ?? [];
    group.push(item);
    acc[item.category] = group;
    return acc;
  }, {});

  return (
    <>
      {grouplessPages.length > 0 && (
        <SidebarGroup>
          <SidebarMenu>
            {grouplessPages.map((item) => (
              <RouteItem key={item.url} item={item} pathname={pathname} />
            ))}
          </SidebarMenu>
        </SidebarGroup>
      )}
      {Object.entries(groupedPages).map(([category, items]) => (
        <SidebarGroup key={category}>
          <SidebarGroupLabel>{category}</SidebarGroupLabel>
          <SidebarMenu>
            {items.map((item) => (
              <RouteItem key={item.url} item={item} pathname={pathname} />
            ))}
          </SidebarMenu>
        </SidebarGroup>
      ))}
    </>
  );
}
