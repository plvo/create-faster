{{!-- The whole allowed-routes.ts file: the pages a role can open, one list for the sidebar and the command palette. --}}
import { can } from '@/hooks/use-permission';
import { ROUTES, type RouteProps } from '@/lib/constants';

export function allowedRoutes(role: string | null | undefined): RouteProps[] {
  return ROUTES.filter((item) => can(role, item.permissions ?? {}));
}
