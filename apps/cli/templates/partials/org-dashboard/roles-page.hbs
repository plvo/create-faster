{{#unless (eq stackName "tanstack-start")}}
import { requireAdmin } from '@/lib/auth/session';
{{/unless}}
import { roleDefinitions, statement } from '@repo/auth/permissions';

const RESOURCES = Object.keys(statement) as Array<keyof typeof statement>;

function grantedActions(role: keyof typeof roleDefinitions, resource: string): readonly string[] {
  // roleDefinitions[role] has a different shape per role, so index it generically.
  const perms = roleDefinitions[role] as Record<string, readonly string[] | undefined>;
  return perms[resource] ?? [];
}

function ActionList({ actions, allowed = false }: { actions: readonly string[]; allowed?: boolean }) {
  if (actions.length === 0) return <span className='text-muted-foreground'>None</span>;
  return (
    <ul className='flex flex-wrap gap-1.5'>
      {actions.map((action) => (
        <li
          key={action}
          className={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${
            allowed ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'
          }`}
        >
          {action}
        </li>
      ))}
    </ul>
  );
}

{{#if (eq stackName "tanstack-start")}}
export function RolesPage() {
{{else}}
export default async function RolesPage() {
  await requireAdmin();

{{/if}}
  const roleNames = Object.keys(roleDefinitions) as Array<keyof typeof roleDefinitions>;

  return (
    <div className='space-y-6'>
      <div>
        <h1 className='text-3xl font-bold'>Roles &amp; permissions</h1>
        <p className='text-sm text-muted-foreground'>
          Roles are defined in code at{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>packages/auth/src/permissions.ts</code>. This view is
          read-only.
        </p>
      </div>
      <div className='grid gap-4'>
        {roleNames.map((role) => (
          <section key={role} className='space-y-4 rounded-lg border bg-card p-6'>
            <h2 className='text-lg font-semibold capitalize'>{role}</h2>
            <div className='overflow-x-auto'>
              <table className='w-full text-sm'>
                <thead>
                  <tr className='border-b text-left'>
                    <th scope='col' className='py-2 pr-4 font-medium'>
                      Resource
                    </th>
                    <th scope='col' className='py-2 pr-4 font-medium'>
                      Allowed
                    </th>
                    <th scope='col' className='py-2 font-medium'>
                      Denied
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {RESOURCES.map((resource) => {
                    const granted = grantedActions(role, resource);
                    const actions = statement[resource] as readonly string[];
                    return (
                      <tr key={resource} className='border-b align-top last:border-0'>
                        <th scope='row' className='py-3 pr-4 text-left font-medium'>
                          {resource}
                        </th>
                        <td className='py-3 pr-4'>
                          <ActionList actions={actions.filter((action) => granted.includes(action))} allowed />
                        </td>
                        <td className='py-3'>
                          <ActionList actions={actions.filter((action) => !granted.includes(action))} />
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </div>
    </div>
  );
}
