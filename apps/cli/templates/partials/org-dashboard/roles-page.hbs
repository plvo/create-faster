{{#unless (eq stackName "tanstack-start")}}
import { requireAdmin } from '@/lib/auth/session';
{{/unless}}
import { roleDefinitions, statement } from '@repo/auth/permissions';

const RESOURCES = Object.keys(statement) as Array<keyof typeof statement>;

function grantedActions(role: keyof typeof roleDefinitions, resource: string): readonly string[] {
  // roleDefinitions[role] has a different shape per role, so index it generically.
  const perms = roleDefinitions[role] as Record<string, readonly string[] | undefined>;
  return perms[resource] ?? [];
}

interface PermissionRow {
  resource: string;
  allowed: string[];
  denied: string[];
}

function permissionRows(role: keyof typeof roleDefinitions): PermissionRow[] {
  return RESOURCES.map((resource) => {
    const granted = grantedActions(role, resource);
    const actions: readonly string[] = statement[resource];
    return {
      resource,
      allowed: actions.filter((action) => granted.includes(action)),
      denied: actions.filter((action) => !granted.includes(action)),
    };
  });
}

function AllowedActions({ actions }: { actions: string[] }) {
  if (actions.length === 0) return <span className='text-sm text-muted-foreground'>None allowed</span>;
  return (
    <ul aria-label='Allowed' className='flex flex-wrap gap-1.5'>
      {actions.map((action) => (
        <li
          key={action}
          className='inline-flex items-center whitespace-nowrap rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary'
        >
          {action}
        </li>
      ))}
    </ul>
  );
}

{{#if (eq stackName "tanstack-start")}}
export function RolesPage() {
{{else}}
export default async function RolesPage() {
  await requireAdmin();

{{/if}}
  const roleNames = Object.keys(roleDefinitions) as Array<keyof typeof roleDefinitions>;

  return (
    <div className='space-y-6'>
      <div>
        <h1 className='text-3xl font-bold'>Roles &amp; permissions</h1>
        <p className='text-sm text-muted-foreground'>
          Roles are defined in code at{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>packages/auth/src/permissions.ts</code>. This view is
          read-only.
        </p>
      </div>
      <div className='grid gap-4'>
        {roleNames.map((role) => {
          const headingId = `${role}-permissions`;
          const rows = permissionRows(role);
          return (
            <section key={role} className='min-w-0 space-y-4 rounded-lg border bg-card p-4 sm:p-6'>
              <h2 id={headingId} className='text-lg font-semibold capitalize'>
                {role}
              </h2>
              <ul aria-labelledby={headingId} className='divide-y sm:hidden'>
                {rows.map(({ resource, allowed, denied }) => (
                  <li key={resource} className='space-y-2 py-3 first:pt-0 last:pb-0'>
                    <p className='text-sm font-medium'>{resource}</p>
                    <AllowedActions actions={allowed} />
                    {denied.length > 0 && (
                      <p className='text-xs text-muted-foreground'>Not allowed: {denied.join(', ')}</p>
                    )}
                  </li>
                ))}
              </ul>
              <table aria-labelledby={headingId} className='hidden w-full table-fixed text-sm sm:table'>
                <thead>
                  <tr className='border-b text-left'>
                    <th scope='col' className='w-24 py-2 pr-4 font-medium'>
                      Resource
                    </th>
                    <th scope='col' className='py-2 pr-4 font-medium'>
                      Allowed
                    </th>
                    <th scope='col' className='py-2 font-medium'>
                      Denied
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(({ resource, allowed, denied }) => (
                    <tr key={resource} className='border-b align-top last:border-0'>
                      <th scope='row' className='py-3 pr-4 text-left font-medium'>
                        {resource}
                      </th>
                      <td className='py-3 pr-4'>
                        <AllowedActions actions={allowed} />
                      </td>
                      <td className='py-3 text-muted-foreground'>{denied.length > 0 ? denied.join(', ') : 'None'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          );
        })}
      </div>
    </div>
  );
}
