{{#unless (eq stackName "tanstack-start")}}
'use client';

{{/unless}}
import { ArrowLeft } from 'lucide-react';
import { useState } from 'react';
{{#unless (eq stackName "tanstack-start")}}
import { useRouter } from 'next/navigation';
{{/unless}}
import { useSuspenseQuery, useMutation, useQueryClient } from '@tanstack/react-query';
{{#if (eq stackName "tanstack-start")}}
import { Link, useNavigate } from '@tanstack/react-router';
{{/if}}
import { Button } from '@repo/ui/components/ui/button';
import { useTRPC } from '@/trpc/providers';
import { Can } from '@/components/can';
import { ContactForm } from '@/components/contacts/contact-form';
{{#unless (eq stackName "tanstack-start")}}
import Link from 'next/link';
{{/unless}}

export function ContactDetail({ id }: { id: string }) {
  const trpc = useTRPC();
{{#if (eq stackName "tanstack-start")}}
  const navigate = useNavigate();
{{else}}
  const router = useRouter();
{{/if}}
  const queryClient = useQueryClient();
  const [editing, setEditing] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);

  const { data: contact } = useSuspenseQuery(trpc.contact.getById.queryOptions({ id }));

  const deleteContact = useMutation(
    trpc.contact.delete.mutationOptions({
      onSuccess: () => {
        queryClient.invalidateQueries({ queryKey: trpc.contact.list.queryKey() });
{{#if (eq stackName "tanstack-start")}}
        navigate({ to: '/contacts' });
{{else}}
        router.push('/contacts');
{{/if}}
      },
    }),
  );

  if (!contact) {
    return (
      <div className='space-y-4'>
        <p className='text-muted-foreground'>Contact not found.</p>
{{#if (eq stackName "tanstack-start")}}
        <Link to='/contacts' className='text-sm text-primary underline'>
{{else}}
        <Link href='/contacts' className='text-sm text-primary underline'>
{{/if}}
          Back to contacts
        </Link>
      </div>
    );
  }

  if (editing) {
    return (
      <div className='space-y-6'>
        <div className='flex items-center gap-4'>
          <Button variant='ghost' size='sm' onClick={() => setEditing(false)}>
            <ArrowLeft />
            Cancel
          </Button>
          <h1 className='text-3xl font-bold'>Edit Contact</h1>
        </div>
        <ContactForm
          contact={contact}
          onDone={() => {
            setEditing(false);
            queryClient.invalidateQueries({ queryKey: trpc.contact.getById.queryKey({ id }) });
          }}
        />
      </div>
    );
  }

  return (
    <div className='space-y-6'>
      <div className='flex flex-wrap items-center justify-between gap-4'>
        <div className='flex min-w-0 items-center gap-4'>
          <Button asChild variant='ghost' size='sm'>
{{#if (eq stackName "tanstack-start")}}
            <Link to='/contacts'>
{{else}}
            <Link href='/contacts'>
{{/if}}
{{{{raw}}}}
              <ArrowLeft />
              Contacts
            </Link>
          </Button>
          <h1 className='min-w-0 break-words text-3xl font-bold'>
            {contact.firstName} {contact.lastName}
          </h1>
        </div>
        <div className='flex gap-2'>
          <Can permissions={{ contact: ['update'] }}>
            <Button variant='outline' onClick={() => setEditing(true)}>
              Edit
            </Button>
          </Can>
          <Can permissions={{ contact: ['delete'] }}>
            {confirmDelete ? (
              <div className='flex gap-2'>
                <Button variant='destructive' onClick={() => deleteContact.mutate({ id })} disabled={deleteContact.isPending}>
                  {deleteContact.isPending ? 'Deleting...' : 'Confirm'}
                </Button>
                <Button variant='outline' onClick={() => setConfirmDelete(false)}>
                  Cancel
                </Button>
              </div>
            ) : (
              <Button variant='destructive' onClick={() => setConfirmDelete(true)}>
                Delete
              </Button>
            )}
          </Can>
        </div>
      </div>
      <div className='rounded-lg border bg-card p-6'>
        <dl className='grid gap-4 sm:grid-cols-2'>
          <div>
            <dt className='text-sm font-medium text-muted-foreground'>Email</dt>
            <dd className='mt-1 text-sm'>{contact.email || '—'}</dd>
          </div>
          <div>
            <dt className='text-sm font-medium text-muted-foreground'>Phone</dt>
            <dd className='mt-1 text-sm'>{contact.phone || '—'}</dd>
          </div>
          <div>
            <dt className='text-sm font-medium text-muted-foreground'>Company</dt>
            <dd className='mt-1 text-sm'>{contact.company || '—'}</dd>
          </div>
          <div className='sm:col-span-2'>
            <dt className='text-sm font-medium text-muted-foreground'>Notes</dt>
            <dd className='mt-1 whitespace-pre-wrap text-sm'>{contact.notes || '—'}</dd>
          </div>
        </dl>
      </div>
    </div>
  );
}
{{{{/raw}}}}
