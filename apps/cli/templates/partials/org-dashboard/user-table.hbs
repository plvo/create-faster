{{#unless (eq stackName "tanstack-start")}}
'use client';

{{/unless}}
import { useSuspenseQueries } from '@tanstack/react-query';
{{#if (eq stackName "tanstack-start")}}
import { Link } from '@tanstack/react-router';
{{else}}
import Link from 'next/link';
{{/if}}
import { PagedList } from '@/components/table-pagination';
import { usePageParams } from '@/hooks/use-page-params';
import { useTRPC } from '@/trpc/providers';
import { UserActions } from './user-actions';

const COUNT_STALE_TIME = 60_000;

function RoleBadge({ role }: { role: string | null | undefined }) {
  return (
    <span
      className={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${
        role === 'admin' ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'
      }`}
    >
      {role}
    </span>
  );
}

export function UserTable() {
  const trpc = useTRPC();
  const pagination = usePageParams();
  const [{ data: users }, { data: total }] = useSuspenseQueries({
    queries: [
      trpc.user.list.queryOptions({ page: pagination.page, pageSize: pagination.pageSize }),
      trpc.user.count.queryOptions(undefined, { staleTime: COUNT_STALE_TIME }),
    ],
  });

  return (
    <PagedList {...pagination} total={total} rowCount={users.length} itemName='users' emptyMessage='No users found'>
      <div className='overflow-x-auto rounded-lg border'>
        <table className='w-full text-sm'>
          <thead>
            <tr className='border-b bg-muted/50'>
              <th className='px-4 py-3 text-left font-medium'>Name</th>
              <th className='hidden px-4 py-3 text-left font-medium sm:table-cell'>Email</th>
              <th className='hidden px-4 py-3 text-left font-medium md:table-cell'>Role</th>
              <th className='px-4 py-3 text-left font-medium'>Status</th>
              <th className='px-4 py-3 text-right font-medium'>Actions</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr key={user.id} className='border-b last:border-0 hover:bg-muted/30 transition-colors'>
                <td className='px-4 py-3'>
{{#if (eq stackName "tanstack-start")}}
{{{{raw}}}}
                  <Link to='/admin/users/$id' params={{ id: user.id }} className='hover:underline font-medium'>
{{{{/raw}}}}
{{else}}
                  <Link href={`/admin/users/${user.id}`} className='hover:underline font-medium'>
{{/if}}
                    {user.name}
                  </Link>
                  <div className='mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 md:hidden'>
                    <span className='text-xs wrap-anywhere text-muted-foreground sm:hidden'>{user.email}</span>
                    <RoleBadge role={user.role} />
                  </div>
                </td>
                <td className='hidden px-4 py-3 text-muted-foreground sm:table-cell'>{user.email}</td>
                <td className='hidden px-4 py-3 md:table-cell'>
                  <RoleBadge role={user.role} />
                </td>
                <td className='px-4 py-3'>
                  <span
                    className={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${
                      user.banned
                        ? 'bg-destructive/10 text-destructive'
                        : 'bg-success/10 text-success'
                    }`}
                  >
                    {user.banned ? 'Banned' : 'Active'}
                  </span>
                </td>
                <td className='px-4 py-3 text-right'>
                  <UserActions user={user} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </PagedList>
  );
}
