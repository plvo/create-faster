{{!-- The whole Preferences component file, imports included.
It reads from the project: Button of @repo/ui. --}}
'use client';

import { useTheme } from 'next-themes';
import { useSyncExternalStore } from 'react';
import { Button } from '@repo/ui/components/ui/button';

const THEMES = ['light', 'dark', 'system'] as const;

// The theme only exists in the browser, so the server markup marks no theme and the client marks it once hydrated.
const subscribeToNothing = () => () => {};

export function Preferences() {
  const { theme, setTheme } = useTheme();
  const isHydrated = useSyncExternalStore(
    subscribeToNothing,
    () => true,
    () => false,
  );

  return (
    <section className='space-y-4 rounded-lg border bg-card p-6'>
      <div>
        <h2 className='text-lg font-semibold'>Preferences</h2>
        <p className='text-sm text-muted-foreground'>Customize your experience.</p>
      </div>
      <div className='space-y-2'>
        <span className='text-sm font-medium'>Theme</span>
        <div className='flex gap-2'>
          {THEMES.map((t) => (
            <Button
              key={t}
              variant={isHydrated && theme === t ? 'default' : 'outline'}
              size='sm'
              onClick={() => setTheme(t)}
            >
              {t.charAt(0).toUpperCase() + t.slice(1)}
            </Button>
          ))}
        </div>
      </div>
    </section>
  );
}
