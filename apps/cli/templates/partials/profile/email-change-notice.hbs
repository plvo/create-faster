{{!-- The whole email-change-notice.tsx of a web app: the alert that tells how the link the user opened ended, then drops the query from the URL. --}}
{{#if (eq stackName "nextjs")}}
'use client';

{{/if}}
import { CircleAlertIcon, CircleCheckIcon } from 'lucide-react';
{{#if (eq stackName "nextjs")}}
import { useRouter } from 'next/navigation';
{{else}}
import { useNavigate } from '@tanstack/react-router';
{{/if}}
import { useEffect, useState } from 'react';
import { Alert, AlertDescription } from '@repo/ui/components/ui/alert';
import { ACCOUNT_PATH, type EmailChangeNotice } from '@/lib/auth/email-change';

// The link puts its outcome in the query. The notice is kept in state and the query is dropped from the URL, so a
// reload does not say it again.
export function EmailChangeNoticeAlert({ notice }: { notice: EmailChangeNotice | null }) {
{{#if (eq stackName "nextjs")}}
  const router = useRouter();
{{else}}
  const navigate = useNavigate();
{{/if}}
  const [shown, setShown] = useState(notice);
  if (notice && notice.message !== shown?.message) setShown(notice);

  useEffect(() => {
{{#if (eq stackName "nextjs")}}
    if (notice) router.replace(ACCOUNT_PATH, { scroll: false });
  }, [notice, router]);
{{else}}
    if (notice) void navigate({ to: ACCOUNT_PATH, search: {}, replace: true });
  }, [notice, navigate]);
{{/if}}

  if (!shown) return null;

  return shown.tone === 'error' ? (
    <Alert variant='destructive'>
      <CircleAlertIcon />
      <AlertDescription className='text-destructive wrap-anywhere'>{shown.message}</AlertDescription>
    </Alert>
  ) : (
    <Alert role='status' className='border-success/40 text-success'>
      <CircleCheckIcon />
      <AlertDescription className='text-current wrap-anywhere'>{shown.message}</AlertDescription>
    </Alert>
  );
}
