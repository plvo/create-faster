{{!-- userQuery: the tRPC procedure that reads one user by id. contactQuery: the one that reads a contact, when the dashboard has contacts --}}
type DetailName = React.ComponentType<{ id: string }>;

interface Crumb {
  url: string;
  segment: string;
  title: string;
  Name?: DetailName;
  hasPage: boolean;
}

function findRouteTitle(routes: RouteProps[], url: string): string | undefined {
  return routes.find((route) => route.url === url)?.title;
}

function formatSegment(segment: string): string {
  return segment.charAt(0).toUpperCase() + segment.slice(1);
}

function UserName({ id }: { id: string }) {
  const trpc = useTRPC();
  const { data: user } = useQuery(trpc.{{userQuery}}.queryOptions({ id }));
  return user?.name || 'User';
}
{{#if contactQuery}}

function ContactName({ id }: { id: string }) {
  const trpc = useTRPC();
  const { data: contact } = useQuery(trpc.{{contactQuery}}.queryOptions({ id }));
  return [contact?.firstName, contact?.lastName].filter(Boolean).join(' ') || 'Contact';
}
{{/if}}

const DETAIL_NAMES: Record<string, DetailName> = {
  '/admin/users': UserName,
{{#if contactQuery}}
  '/contacts': ContactName,
{{/if}}
};

function CrumbLabel({ crumb }: { crumb: Crumb }) {
  return crumb.Name ? <crumb.Name id={crumb.segment} /> : crumb.title;
}

function buildCrumbs(pathname: string): Crumb[] {
  const segments = pathname.split('/').filter(Boolean);

  return segments.map((segment, index) => {
    const url = `/${segments.slice(0, index + 1).join('/')}`;
    const title = findRouteTitle(ROUTES, url) || formatSegment(segment);
    const Name = DETAIL_NAMES[`/${segments.slice(0, index).join('/')}`];
    return { url, segment, title, Name, hasPage: PAGE_URLS.includes(url) };
  });
}
