{{!-- Geist Sans is preloaded because the first paint uses it. Geist Mono only styles code and ids, so it is not: a preloaded font that the page does not use makes the browser warn on every page, and a rule that uses it loads it on demand. The root layout puts geistSans.variable and geistMono.variable on <html>, where the theme's --font-sans and --font-mono resolve them. --}}
const geistSans = localFont({
  src: '../styles/fonts/geist-sans-vf.woff',
  variable: '--font-geist-sans',
  weight: '100 900',
});

const geistMono = localFont({
  src: '../styles/fonts/geist-mono-vf.woff',
  preload: false,
  variable: '--font-geist-mono',
  weight: '100 900',
});
