{{!-- The whole proxy file (middleware on Cloudflare), imports included, with its evlog and posthog sections.
forwardRequestPath=true: the proxy copies the requested path and query into the request header named by
REQUEST_PATH_HEADER (src/lib/auth/request-path.ts, from the auth/request-path partial), for the guards of
auth/session-guards. --}}
{{#if (and (hasLibrary "evlog") forwardRequestPath)}}
import { NextRequest } from 'next/server';
{{else if (hasLibrary "evlog")}}
import type { NextRequest } from 'next/server';
{{else if forwardRequestPath}}
import { type NextRequest, NextResponse } from 'next/server';
{{else}}
import { NextResponse } from 'next/server';
{{/if}}
{{#if (hasLibrary "evlog")}}
import { evlogMiddleware } from 'evlog/next';
{{/if}}
{{#if forwardRequestPath}}
import { REQUEST_PATH_HEADER } from '@/lib/auth/request-path';
{{/if}}

{{#if (hasLibrary "evlog")}}
const withEvlog = evlogMiddleware();
{{/if}}

export default async function {{#if (has "deployment" "cloudflare")}}middleware{{else}}proxy{{/if}}({{#if (or forwardRequestPath (hasLibrary "evlog"))}}request: NextRequest{{/if}}) {
  {{#if forwardRequestPath}}
  const { pathname } = request.nextUrl;

  // Server components cannot read their own URL: the guards that send a visitor to the login read the path here.
  const requestHeaders = new Headers(request.headers);
  requestHeaders.set(REQUEST_PATH_HEADER, `${pathname}${request.nextUrl.search}`);

  {{/if}}
  {{#if (hasLibrary "evlog")}}
  return await withEvlog({{#if forwardRequestPath}}new NextRequest(request, { headers: requestHeaders }){{else}}request{{/if}});
  {{else}}
  return NextResponse.next({{#if forwardRequestPath}}{ request: { headers: requestHeaders } }{{/if}});
  {{/if}}
}

export const config = {
  matcher: [
    // Exclude API routes, static files, image optimizations, and .png files
    '/((?!api|{{#if (hasLibrary "posthog")}}ingest|{{/if}}_next/static|manifest.webmanifest|_next/image|.*\\.png$).*)',
  ],
};
