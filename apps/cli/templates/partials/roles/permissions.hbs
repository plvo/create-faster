import { createAccessControl } from 'better-auth/plugins/access';
import { adminAc, defaultStatements } from 'better-auth/plugins/admin/access';

// The role the Better Auth `admin` plugin treats as administrator (`adminRoles` in auth.ts). It has no rows in the
// database: `permissionsOf` (role-permissions.ts) grants it what `adminStatement` below lists.
export const ADMIN_ROLE = 'admin';

// The role of an account nobody assigned another: the `defaultRole` of the plugin. It holds only what its rows in the
// database give it.
export const DEFAULT_ROLE = 'user';

// A role identifier is the value of `users.role`, which the `admin` plugin splits on `,` and compares as plain text.
// Exactly one such id, never a list, is what any path may write there.
export const ROLE_ID = /^[a-z0-9-]+$/;

// The `admin` plugin looks a role up by plain object key, so a role named after a key every object has (`constructor`)
// resolves to that member and the plugin's endpoints fail with a 500 for the account that holds it. No path accepts one.
export function isInheritedKey(id: string): boolean {
  return id in Object.prototype;
}

export function isRoleId(value: unknown): value is string {
  return typeof value === 'string' && ROLE_ID.test(value) && !isInheritedKey(value);
}

// The longest identifier and label a role created in the dashboard can have.
export const MAX_ROLE_ID_LENGTH = 40;
export const MAX_ROLE_LABEL_LENGTH = 64;

// Account administration (`user`, `session`). It belongs to the `admin` plugin, is compiled into `roles` below for
// `admin` alone, and is never stored.
export const accountStatement = defaultStatements;

// The business vocabulary: the only resources and actions a role can be given in the database (`role_permissions`),
// and the only source of valid names. To add a permission, add the action here, then grant it to roles in the
// database (the auth guide in docs/agents).
{{> (blueprintPartial "business-statement")}}

export const statement = { ...accountStatement, ...businessStatement } as const;

export const ac = createAccessControl(statement);

// What `admin` holds: the account administration the plugin grants its administrators, and every business action.
const adminStatement = { ...adminAc.statements, ...businessStatement } as const;

// The compiled roles of the `admin` plugin, whose own endpoints reject any other role name (`guard-administrators.ts`
// assigns the roles of the database itself). Only `admin` holds permissions here; what `user` and `manager` may do on
// business resources is read from the database.
export const roles = {
  admin: ac.newRole(adminStatement),
  user: ac.newRole({}),
  manager: ac.newRole({}),
};

export type AppRole = keyof typeof roles;

export type Statement = typeof statement;
export type Resource = keyof Statement;
export type Action<R extends Resource = Resource> = Statement[R][number];
export type BusinessResource = keyof typeof businessStatement;
export type BusinessAction<R extends BusinessResource = BusinessResource> = (typeof businessStatement)[R][number];

type PermissionOf<S extends Record<string, readonly string[]>> = {
  [R in keyof S & string]: `${R}.${S[R][number]}`;
}[keyof S & string];

// A permission as a flat name, `document.read`, the form the server sends to the client and the database stores
// split in two columns.
export type Permission = PermissionOf<Statement>;
export type BusinessPermission = PermissionOf<typeof businessStatement>;

// What a check asks for: every listed action of every listed resource.
export type PermissionRequest = { [R in Resource]?: readonly Action<R>[] };

function namesOf(source: Record<string, readonly string[]>): string[] {
  return Object.entries(source).flatMap(([resource, actions]) => actions.map((action) => `${resource}.${action}`));
}

export const PERMISSIONS = namesOf(statement) as Permission[];
export const ADMIN_PERMISSIONS = namesOf(adminStatement) as Permission[];
export const BUSINESS_PERMISSIONS = namesOf(businessStatement) as BusinessPermission[];

const BUSINESS_NAMES: ReadonlySet<string> = new Set(BUSINESS_PERMISSIONS);

export function isBusinessPermission(resource: string, action: string): boolean {
  return BUSINESS_NAMES.has(`${resource}.${action}`);
}

// What the interface knows of a request: `unknown` until the permission list of the caller is there, then `granted` when
// every listed action is held and `denied` otherwise. An empty request is granted.
export type Verdict = 'unknown' | 'granted' | 'denied';

export function verdictOf(granted: readonly Permission[] | undefined, request: PermissionRequest): Verdict {
  const wanted = Object.entries(request).flatMap(([resource, actions]) =>
    (actions ?? []).map((action) => `${resource}.${action}` as Permission),
  );
  if (wanted.length === 0) return 'granted';
  if (!granted) return 'unknown';
  return wanted.every((permission) => granted.includes(permission)) ? 'granted' : 'denied';
}
