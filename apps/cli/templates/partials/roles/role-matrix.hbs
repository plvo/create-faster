{{!-- `router` is the name of the tRPC router that has `assignableRoles`. --}}
{{{{raw}}}}
'use client';

import { useMutation, useQueryClient, useSuspenseQuery } from '@tanstack/react-query';
import { Check, Minus, Trash2 } from 'lucide-react';
import { useState } from 'react';
import { toast } from 'sonner';
import { Button } from '@repo/ui/components/ui/button';
import { Checkbox } from '@repo/ui/components/ui/checkbox';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '@repo/ui/components/ui/table';
import { ConfirmDialog } from '@/components/confirm-dialog';
import { useTRPC } from '@/trpc/providers';

const cellKey = (roleId: string, permission: string) => `${roleId}:${permission}`;

function holdersText(holders: number): string {
  return holders === 1 ? '1 user' : `${holders} users`;
}

export function RoleMatrix({ currentRole }: { currentRole: string }) {
  const trpc = useTRPC();
  const queryClient = useQueryClient();
  const { data } = useSuspenseQuery(trpc.roles.matrix.queryOptions());
  const [saving, setSaving] = useState<ReadonlySet<string>>(new Set());
  const [deleting, setDeleting] = useState<{ id: string; label: string; holders: number } | null>(null);
  // What a screen reader is told about a change: the box alone says nothing once the change settled.
  const [announcement, setAnnouncement] = useState('');

  const changeText = (input: { id: string; permission: string; granted: boolean }): string => {
    const label = data.roles.find((role) => role.id === input.id)?.label ?? input.id;
    return `${label} may ${input.granted ? '' : 'not '}${input.permission}`;
  };

  // The matrix is the server's answer and nothing else: a box changes only when the server has confirmed the change and
  // the matrix was fetched again, so a refused grant never looks granted. While a change is in flight its box is busy and
  // ignores further clicks; it is not disabled, because a disabled box loses the keyboard focus of the person using it.
  const refreshMatrix = () => Promise.all([
    queryClient.invalidateQueries(trpc.roles.matrix.queryFilter()),
{{{{/raw}}}}
    queryClient.invalidateQueries(trpc.{{router}}.assignableRoles.queryFilter()),
{{{{raw}}}}
  ]);

  const setPermission = useMutation(
    trpc.roles.setPermission.mutationOptions({
      onMutate: (input) => {
        setSaving((current) => new Set(current).add(cellKey(input.id, input.permission)));
        setAnnouncement(`Saving: ${changeText(input)}`);
      },
      onSuccess: (_data, input) => setAnnouncement(`Saved: ${changeText(input)}`),
      onError: (error) => {
        setAnnouncement(`Not saved: ${error.message}`);
        toast.error(error.message);
      },
      onSettled: async (_data, _error, input) => {
        await refreshMatrix();
        setSaving((current) => {
          const next = new Set(current);
          next.delete(cellKey(input.id, input.permission));
          return next;
        });
      },
    }),
  );

  const removeRole = useMutation(
    trpc.roles.remove.mutationOptions({
      onSuccess: () => toast.success('Role deleted'),
      onError: (error) => toast.error(error.message),
      onSettled: async () => {
        setDeleting(null);
        await refreshMatrix();
      },
    }),
  );

  const storedRoles = data.roles.filter((role) => role.editable);

  return (
    <div className='space-y-4'>
      <p role='status' aria-live='polite' className='sr-only'>
        {announcement}
      </p>
      {storedRoles.length === 0 && (
        <p role='status' className='rounded-lg border border-dashed p-4 text-sm text-muted-foreground'>
          No role is stored in the database yet, so every role but admin is refused. Create one, or write the default roles with{' '}
{{{{/raw}}}}
{{#if (hasRootScript "db:roles:remote")}}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>{{runScript "db:roles"}}</code> on this machine, or{' '}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>{{runScript "db:roles:remote"}}</code> for production.
{{else}}
          <code className='rounded bg-muted px-1 py-0.5 text-xs'>{{runScript "db:roles"}}</code>.
{{/if}}
{{{{raw}}}}
        </p>
      )}

      <div className='overflow-x-auto rounded-lg border'>
        <Table>
          <TableCaption className='sr-only'>Permissions granted to each role</TableCaption>
          <TableHeader>
            <TableRow className='bg-muted/50'>
              <TableHead scope='col' className='sticky left-0 z-10 min-w-40 bg-muted px-2 sm:px-4'>
                Permission
              </TableHead>
              {data.roles.map((role) => (
                <TableHead
                  key={role.id}
                  scope='col'
                  className={`min-w-28 px-2 text-center align-top sm:px-4 ${role.id === currentRole ? 'bg-primary/10 text-primary' : ''}`}
                >
                  <div className='flex flex-col items-center gap-1 py-2'>
                    <span>
                      {role.label}
                      {role.id === currentRole && <span className='ml-1 text-xs font-normal'>(you)</span>}
                    </span>
                    <code className='text-xs font-normal text-muted-foreground'>{role.id}</code>
                    <span className='text-xs font-normal text-muted-foreground'>{holdersText(role.holders)}</span>
                    {role.deletable && (
                      <Button
                        type='button'
                        variant='ghost'
                        size='icon'
                        className='size-11 text-destructive hover:text-destructive sm:size-9'
                        aria-label={`Delete role ${role.label}`}
                        onClick={() => setDeleting({ id: role.id, label: role.label, holders: role.holders })}
                      >
                        <Trash2 className='size-4' />
                      </Button>
                    )}
                  </div>
                </TableHead>
              ))}
            </TableRow>
          </TableHeader>
          <TableBody>
            {data.permissions.map((permission) => {
              const [resource, action] = permission.name.split('.');
              return (
                <TableRow key={permission.name}>
                  <TableHead scope='row' className='sticky left-0 z-10 bg-background px-2 py-3 font-normal whitespace-normal wrap-anywhere sm:px-4'>
                    <span className='font-medium'>{resource}</span>
                    <span className='text-muted-foreground'>.{action}</span>
                  </TableHead>
                  {data.roles.map((role) => {
                    const granted = role.permissions.includes(permission.name);
                    const busy = saving.has(cellKey(role.id, permission.name));
                    const boxId = `permission-${cellKey(role.id, permission.name)}`;
                    const current = role.id === currentRole ? 'bg-primary/5' : '';
                    if (!role.editable || !permission.editable) {
                      return (
                        <TableCell key={role.id} className={`px-2 py-3 text-center sm:px-4 ${current}`}>
                          {granted ? (
                            <Check className='mx-auto size-4 text-primary' />
                          ) : (
                            <Minus className='mx-auto size-4 text-muted-foreground' />
                          )}
                          <span className='sr-only'>{granted ? 'Allowed' : 'Denied'}</span>
                        </TableCell>
                      );
                    }
                    return (
                      <TableCell key={role.id} className={`p-0 text-center ${current}`}>
                        <label htmlFor={boxId} className='flex min-h-11 cursor-pointer items-center justify-center'>
                          <Checkbox
                            id={boxId}
                            checked={granted}
                            aria-busy={busy}
                            className={busy ? 'opacity-50' : undefined}
                            onCheckedChange={(next) => {
                              if (busy) {
                                setAnnouncement(`Still saving ${role.label} ${permission.name}: wait a moment`);
                                return;
                              }
                              setPermission.mutate({ id: role.id, permission: permission.name, granted: next === true });
                            }}
                          />
                          <span className='sr-only'>
                            {role.label} may {permission.name}
                          </span>
                        </label>
                      </TableCell>
                    );
                  })}
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
      </div>

      <ConfirmDialog
        open={deleting !== null}
        onOpenChange={(open) => {
          if (!open) setDeleting(null);
        }}
        title='Delete role'
        description={
          deleting && deleting.holders > 0
            ? `${deleting.label} is held by ${holdersText(deleting.holders)}. Give them another role first: a role someone holds cannot be deleted.`
            : `${deleting?.label ?? 'This role'} and its permissions will be deleted. This cannot be undone.`
        }
        confirmLabel='Delete'
        disabled={removeRole.isPending || (deleting?.holders ?? 0) > 0}
        onConfirm={() => {
          if (deleting) removeRole.mutate({ id: deleting.id });
        }}
      />
    </div>
  );
}
{{{{/raw}}}}
