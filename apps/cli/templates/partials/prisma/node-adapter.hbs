{{#if (has "database" "postgres")}}
// TLS in production unless DATABASE_URL sets sslmode: pg applies the parsed URL over these options.
const adapter = new PrismaPg({
  connectionString: process.env.DATABASE_URL,
  ssl: process.env.NODE_ENV === 'production',
});
{{/if}}
{{#if (has "database" "mysql")}}
const adapter = new PrismaMariaDb(process.env.DATABASE_URL ?? 'mysql://localhost:3306/db');
{{/if}}
