import type { SQL } from 'drizzle-orm';
import { desc } from '@repo/db';
import { type PageParams, pageOffset } from './pagination';
import type { Column } from './text-match';

interface PageableQuery<Rows> {
  orderBy: (...order: SQL[]) => { limit: (limit: number) => { offset: (offset: number) => Rows } };
}

// One page of a table in the given order. The order ends with a unique column, so a page boundary never repeats or
// skips a row. This module reads the database: only routers import it, never a client component.
export function orderedPage<Rows>(query: PageableQuery<Rows>, order: SQL[], params: PageParams): Rows {
  return query.orderBy(...order).limit(params.pageSize).offset(pageOffset(params));
}

// One page of a table, newest first. The id breaks ties between rows created together.
export function newestFirstPage<Rows>(
  query: PageableQuery<Rows>,
  table: { createdAt: Column; id: Column },
  params: PageParams,
): Rows {
  return orderedPage(query, [desc(table.createdAt), desc(table.id)], params);
}
