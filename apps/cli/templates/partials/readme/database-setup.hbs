{{#if (or (has "database" "postgres") (has "database" "mysql"))}}
Start the database:

```bash
docker compose up -d --wait
```

{{/if}}
{{#if (has "orm" "prisma")}}
Create the tables from the schema:

```bash
{{#if pm}}{{pm}} run db:push{{else}}npm run db:push{{/if}}
```
{{else}}
Create the migrations from the schema and apply them:

```bash
{{#if pm}}{{pm}} run db:generate{{else}}npm run db:generate{{/if}}
{{#if pm}}{{pm}} run db:migrate{{else}}npm run db:migrate{{/if}}
```
{{/if}}
