import { defaultShouldDehydrateQuery, QueryClient } from '@tanstack/react-query';
{{#if (hasLibrary "trpc")}}
import superjson from 'superjson';
{{/if}}

/**
{{#if (eq stackName "tanstack-start")}}
 * getRouter() builds one client per request on the server, and one for the browser.
 * staleTime: With SSR, we usually want to set some default staleTime above 0
 * to avoid refetching immediately on the client.
 *
 * shouldDehydrateQuery: This is a function that determines whether a query should be dehydrated or not.
 * The router SSR query integration streams queries that are still pending when the page is sent,
 * so we extend the defaultShouldDehydrateQuery function to also include them. This will allow us
 * to start prefetching in a route loader without awaiting it, then consuming that query in a
 * component further down. Failed queries are not dehydrated: the browser refetches them.
{{#if (hasLibrary "trpc")}}
 *
 * serializeData / deserializeData: superjson carries the types tRPC procedures return (Date, Map, ...)
 * from the server's cache to the browser's.
{{/if}}
{{else}}
 * https://trpc.io/docs/client/tanstack-react-query/server-components#3-create-a-query-client-factory
 * staleTime: With SSR, we usually want to set some default staleTime above 0
 * to avoid refetching immediately on the client.
 *
 * shouldDehydrateQuery: This is a function that determines whether a query should be dehydrated or not.
 * Since the RSC transport protocol supports hydrating promises over the network, we extend
 * the defaultShouldDehydrateQuery function to also include queries that are still pending.
 * This will allow us to start prefetching in a server component high up the tree,
 * then consuming that promise in a client component further down.
{{/if}}
 */

const MAX_RETRIES = 3;

// A 4xx answer (a 403 without the permission, a 404 for an unknown id) is the same on every attempt, so it is not
// retried; tRPC puts the HTTP status of a failed call in `data.httpStatus`. Any other failure keeps the default of
// three attempts. Only the browser gets this function: a `retry` option replaces TanStack's default of no retry on
// the server, where a 5xx would otherwise be retried too.
function retryUnlessRefused(failureCount: number, error: unknown): boolean {
  const status = (error as { data?: { httpStatus?: number } } | null)?.data?.httpStatus;
  if (status !== undefined && status < 500) return false;
  return failureCount < MAX_RETRIES;
}

export function makeQueryClient() {
  return new QueryClient({
    defaultOptions: {
      queries: {
        staleTime: 1000 * 30, // 30 seconds
        ...(typeof window === 'undefined' ? {} : { retry: retryUnlessRefused }),
      },
      dehydrate: {
        shouldDehydrateQuery: (query) =>
          defaultShouldDehydrateQuery(query) || query.state.status === 'pending',
{{#if (hasLibrary "trpc")}}
        serializeData: superjson.serialize,
{{/if}}
      },
{{#if (hasLibrary "trpc")}}
      hydrate: {
        deserializeData: superjson.deserialize,
      },
{{/if}}
    },
  });
}
