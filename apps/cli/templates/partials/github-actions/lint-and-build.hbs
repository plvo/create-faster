{{!-- Steps that run the root lint script and the root build script when the project defines them, through the project package manager. Called after `      - ` in a workflow `steps:` list: it continues the step it is called in. --}}
{{#if (hasRootScript "lint")}}name: Lint
        run: {{> github-actions/package-manager}} run lint{{#if (hasRootScript "build")}}

      - {{/if}}{{/if}}{{#if (hasRootScript "build")}}name: Build
        run: {{> github-actions/package-manager}} run build{{/if}}
