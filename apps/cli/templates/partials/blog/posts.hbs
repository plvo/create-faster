import type { ComponentType } from 'react';
import type { MdxFrontmatter } from '@/lib/mdx';

export interface BlogPost {
  slug: string;
  title: string;
  summary: string;
  publishedAt: string;
  author?: string;
  imageUrl?: string;
}

type PostFrontmatter = Partial<MdxFrontmatter> & { author?: string };

type PostModule = {
  default: ComponentType;
  frontmatter: PostFrontmatter;
};

const posts = require.context('../../contents/blog', false, /\.mdx$/);

function toBlogPost(slug: string, frontmatter: PostFrontmatter): BlogPost {
  return {
    slug,
    title: frontmatter.title ?? slug,
    summary: frontmatter.summary ?? '',
    publishedAt: frontmatter.publishedAt ?? '',
    author: frontmatter.author,
    imageUrl: frontmatter.imageUrl,
  };
}

export function getAllPosts(): BlogPost[] {
  return posts
    .keys()
    .map((key) => toBlogPost(key.slice('./'.length, -'.mdx'.length), posts<PostModule>(key).frontmatter))
    .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
}

export function getPost(slug: string): { metadata: BlogPost; Content: ComponentType } | null {
  const key = `./${slug}.mdx`;
  if (!posts.keys().includes(key)) return null;

  const { default: Content, frontmatter } = posts<PostModule>(key);

  return { metadata: toBlogPost(slug, frontmatter), Content };
}
