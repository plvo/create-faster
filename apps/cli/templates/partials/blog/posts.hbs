import type { MdxFrontmatter, MdxModule } from '@/lib/mdx';

export type BlogPost = MdxFrontmatter & { slug: string; author?: string };

type PostModule = Omit<MdxModule, 'frontmatter'> & { frontmatter: Omit<BlogPost, 'slug'> };

const posts = import.meta.glob<PostModule>('/contents/blog/*.mdx', { eager: true });

export function getAllPosts(): BlogPost[] {
  return Object.entries(posts)
    .map(([path, post]) => ({ slug: path.slice('/contents/blog/'.length, -'.mdx'.length), ...post.frontmatter }))
    .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
}

export function getPost(slug: string): { metadata: BlogPost; Content: PostModule['default'] } | null {
  const post = posts[`/contents/blog/${slug}.mdx`];
  if (!post) return null;

  return { metadata: { slug, ...post.frontmatter }, Content: post.default };
}
