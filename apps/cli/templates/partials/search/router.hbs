{{!-- The whole router/search.ts file of an api package: the one procedure the command palette asks for its records. --}}
import { router, protectedProcedure } from '../trpc';
import { searchInput } from '../search-query';
import { searchRecords } from '../search';

export const searchRouter = router({
  records: protectedProcedure.input(searchInput).query(({ ctx, input }) => searchRecords(ctx, input.query)),
});
