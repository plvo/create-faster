{{!-- The whole use-permission.ts file: what the caller may do, from the permission list the server resolved. --}}
{{#unless (eq stackName "tanstack-start")}}
'use client';

{{/unless}}
{{#if (eq stackName "tanstack-start")}}
import { useRouteContext } from '@tanstack/react-router';
{{else}}
import { useQuery } from '@tanstack/react-query';
{{/if}}
import { type Permission, type PermissionRequest, type Verdict, verdictOf } from '@repo/auth/permissions';
{{#unless (eq stackName "tanstack-start")}}
import { useTRPC } from '@/trpc/providers';
{{/unless}}

{{#if (eq stackName "tanstack-start")}}
// The permission list of the caller, set in the route context by the `_dashboard` layout, so the first render already
// has it.
export function usePermissions(): readonly Permission[] | undefined {
  return useRouteContext({ from: '/_dashboard', select: (context) => context.permissions });
}
{{else}}
// The permission list of the caller: the layout fetches it on the server and hydrates it into the query cache, so the
// first render already has it. It stays `undefined` only if that failed, and `usePermission` then answers `unknown`.
export function usePermissions(): readonly Permission[] | undefined {
  const trpc = useTRPC();
  return useQuery(trpc.permissions.mine.queryOptions()).data;
}
{{/if}}

export function usePermission(permissions: PermissionRequest): Verdict {
  return verdictOf(usePermissions(), permissions);
}
