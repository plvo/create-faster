import { createContext, type ReactNode, useContext, useEffect, useState } from 'react';
import { useMounted } from '@/hooks/use-mounted';
import { useAllowedRoutes } from '@/lib/allowed-routes';
import type { RouteProps } from '@/lib/constants';
import { useTRPC } from '@/trpc/providers';

const SEARCH_DELAY_MS = 250;

type Platform = 'mac' | 'other';

// ariaKeys is the value of aria-keyshortcuts, which names the modifier keys in full.
const SHORTCUTS: Record<Platform, { label: string; ariaKeys: string }> = {
  mac: { label: '⌘K', ariaKeys: 'Meta+K' },
  other: { label: 'Ctrl K', ariaKeys: 'Control+K' },
};

function readPlatform(): Platform {
  return /Mac|iPhone|iPad|iPod/.test(navigator.userAgent) ? 'mac' : 'other';
}

// Null on the server and while the page hydrates, so the markup the server sent never disagrees with the first client render.
function usePlatform(): Platform | null {
  return useMounted() ? readPlatform() : null;
}

export function isPaletteShortcut(event: KeyboardEvent, platform: Platform): boolean {
  const modifier = platform === 'mac' ? event.metaKey : event.ctrlKey;
  return modifier && !event.altKey && !event.shiftKey && !event.repeat && event.key.toLowerCase() === 'k';
}

interface CommandPaletteState {
  setOpen: (open: boolean) => void;
  pages: RouteProps[];
}

const CommandPaletteContext = createContext<CommandPaletteState | null>(null);

function useCommandPalette(): CommandPaletteState {
  const palette = useContext(CommandPaletteContext);
  if (!palette) throw new Error('CommandPaletteTrigger needs a CommandPaletteProvider above it');
  return palette;
}

function useDebouncedValue<T>(value: T, delayMs: number): T {
  const [debounced, setDebounced] = useState(value);

  useEffect(() => {
    const timer = setTimeout(() => setDebounced(value), delayMs);
    return () => clearTimeout(timer);
  }, [value, delayMs]);

  return debounced;
}

// The palette does not filter (`shouldFilter` is false, the records come filtered from the server), so the pages are
// matched here, on their title and category.
function PageResults({ query, onSelect }: { query: string; onSelect: (url: string) => void }) {
  const { pages: allowed } = useCommandPalette();
  const needle = query.trim().toLowerCase();
  const pages = allowed.filter((page) =>
    [page.title, page.category ?? ''].some((text) => text.toLowerCase().includes(needle)),
  );
  if (pages.length === 0) return null;

  return (
    <CommandGroup heading='Pages'>
      {pages.map((page) => (
        <CommandItem key={page.url} value={page.url} onSelect={() => onSelect(page.url)}>
{{{{/raw}}}}
{{#if (eq icons "hugeicons")}}
          <HugeiconsIcon icon={page.icon} />
{{else}}
          {page.icon && <page.icon />}
{{/if}}
{{{{raw}}}}
          <span>{page.title}</span>
          {page.category && <span className='ml-auto text-xs text-muted-foreground'>{page.category}</span>}
        </CommandItem>
      ))}
    </CommandGroup>
  );
}

interface RecordGroup {
  type: string;
  label: string;
  items: { id: string; title: string; subtitle: string; href: string }[];
}

type RecordSearch =
  | { state: 'idle' | 'short' | 'running' }
  | { state: 'failed'; retry: () => void }
  | { state: 'empty'; text: string }
  | { state: 'found'; groups: RecordGroup[] };

// The query of the records for a text. A request for an older text is aborted when a newer text replaces it: the query
// key is the text, so the observer moves to another query and nothing observes the older one any more. TanStack Query
// aborts a request that nothing observes only if the request took its abort signal, and tRPC passes the signal only
// with `trpc.abortOnUnmount`.
export function recordSearchOptions(trpc: ReturnType<typeof useTRPC>, text: string) {
  return trpc.search.records.queryOptions(
    { query: text },
    { enabled: text.length >= SEARCH_MIN_LENGTH, retry: false, trpc: { abortOnUnmount: true } },
  );
}

// What the palette shows for the records, from the text in the box. The answer is always the one for that text: while
// the delay or the request runs the state is `running`, never the answer of an older text.
function useRecordSearch(query: string): RecordSearch {
  const trpc = useTRPC();
  const text = query.trim();
  const searchText = useDebouncedValue(text, SEARCH_DELAY_MS);
  const search = useQuery(recordSearchOptions(trpc, searchText));

  if (text === '') return { state: 'idle' };
  if (text.length < SEARCH_MIN_LENGTH) return { state: 'short' };
  if (searchText !== text || search.isPending || (search.isError && search.isFetching)) return { state: 'running' };
  if (search.isError) {
    return {
      state: 'failed',
      retry: () => {
        search.refetch();
      },
    };
  }
  if (search.data.length === 0) return { state: 'empty', text };
  return { state: 'found', groups: search.data };
}

// One group per type the server returns: this component knows no type. A failed search offers its retry as an item, so
// the keyboard reaches it the way cmdk does (Enter selects the item, the focus stays in the input).
function RecordGroups({ search, onSelect }: { search: RecordSearch; onSelect: (href: string) => void }) {
  if (search.state === 'failed') {
    return (
      <CommandGroup heading='Records'>
        <CommandItem value='records:retry' onSelect={search.retry}>
          Try again
        </CommandItem>
      </CommandGroup>
    );
  }
  if (search.state !== 'found') return null;

  return search.groups.map((group) => (
    <CommandGroup key={group.type} heading={group.label}>
      {group.items.map((item) => (
        <CommandItem key={item.id} value={`${group.type}:${item.id}`} onSelect={() => onSelect(item.href)}>
          <span className='max-w-2/3 shrink-0 truncate'>{item.title}</span>
          <span className='ml-auto truncate text-xs text-muted-foreground'>{item.subtitle}</span>
        </CommandItem>
      ))}
    </CommandGroup>
  ));
}

function recordStatusMessage(search: RecordSearch): string | null {
  switch (search.state) {
    case 'short':
      return `Type at least ${SEARCH_MIN_LENGTH} characters to search records.`;
    case 'running':
      return 'Searching records...';
    case 'empty':
      return `No records match "${search.text}".`;
    default:
      return null;
  }
}

// What is not a result: kept out of the listbox, which holds options only. The status region stays in the page so a
// message put into it is announced.
function RecordStatus({ search }: { search: RecordSearch }) {
  const message = recordStatusMessage(search);
  const style = 'px-2 py-6 text-center text-sm text-muted-foreground';

  return (
    <>
      <div role='status' className={message ? style : undefined}>
        {message}
      </div>
      {search.state === 'failed' && (
        <div role='alert' className={style}>
          The search failed.
        </div>
      )}
    </>
  );
}

// The dialog content is unmounted while the palette is closed, so the text and the search start over at each opening.
function CommandPaletteBody({ onSelect }: { onSelect: (url: string) => void }) {
  const [query, setQuery] = useState('');
  const search = useRecordSearch(query);

  return (
    <>
      <CommandInput value={query} onValueChange={setQuery} placeholder='Search pages and records...' />
      <CommandList>
        <PageResults query={query} onSelect={onSelect} />
        <RecordGroups search={search} onSelect={onSelect} />
      </CommandList>
      <RecordStatus search={search} />
    </>
  );
}

function CommandPaletteDialog({ open, onOpenChange }: { open: boolean; onOpenChange: (open: boolean) => void }) {
  const router = useRouter();

  const openPage = (url: string) => {
    onOpenChange(false);
{{{{/raw}}}}
{{#if (eq stackName "tanstack-start")}}
    router.navigate({ to: url });
{{else}}
    router.push(url);
{{/if}}
{{{{raw}}}}
  };

  return (
    <CommandDialog
      open={open}
      onOpenChange={onOpenChange}
      shouldFilter={false}
      title='Search'
      description='Search for a page or a record to open.'
    >
      <CommandPaletteBody onSelect={openPage} />
    </CommandDialog>
  );
}

{{{{/raw}}}}
{{#if (eq pageAccess "organization")}}
export function CommandPaletteProvider({ children }: { children: ReactNode }) {
  const pages = useAllowedRoutes();
{{else}}
export function CommandPaletteProvider({ role, children }: { role: string | null | undefined; children: ReactNode }) {
  const pages = useAllowedRoutes(role);
{{/if}}
{{{{raw}}}}
  const [open, setOpen] = useState(false);
  const platform = usePlatform();

  useEffect(() => {
    if (!platform) return;
    const toggleOnShortcut = (event: KeyboardEvent) => {
      if (!isPaletteShortcut(event, platform)) return;
      event.preventDefault();
      setOpen((current) => !current);
    };
    document.addEventListener('keydown', toggleOnShortcut);
    return () => document.removeEventListener('keydown', toggleOnShortcut);
  }, [platform]);

  return (
    <CommandPaletteContext.Provider value={{ setOpen, pages }}>
      {children}
      <CommandPaletteDialog open={open} onOpenChange={setOpen} />
    </CommandPaletteContext.Provider>
  );
}

export function CommandPaletteTrigger() {
  const { setOpen } = useCommandPalette();
  const { setOpenMobile } = useSidebar();
  const platform = usePlatform();
  const shortcut = platform ? SHORTCUTS[platform] : null;

  const openPalette = () => {
    setOpenMobile(false);
    setOpen(true);
  };

  return (
    <SidebarMenu>
      <SidebarMenuItem>
        <SidebarMenuButton
          type='button'
          variant='outline'
          tooltip={shortcut ? `Search (${shortcut.label})` : 'Search'}
          aria-haspopup='dialog'
          aria-keyshortcuts={shortcut?.ariaKeys}
          onClick={openPalette}
          className='text-muted-foreground'
        >
{{{{/raw}}}}
{{#if (eq icons "hugeicons")}}
          <HugeiconsIcon icon={Search01Icon} />
{{else}}
          <Search />
{{/if}}
{{{{raw}}}}
          <span>Search</span>
          {shortcut && (
            <span aria-hidden='true' className='ml-auto hidden md:inline-block group-data-[collapsible=icon]:hidden'>
              <kbd className='rounded border bg-muted px-1.5 py-0.5 font-mono text-xs font-medium text-muted-foreground'>
                {shortcut.label}
              </kbd>
            </span>
          )}
        </SidebarMenuButton>
      </SidebarMenuItem>
    </SidebarMenu>
  );
}
