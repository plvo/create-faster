{{!-- The Logout entry of the user menu and its confirmation, placed inside DropdownMenuContent.
The component holds the React state `showLogout` and the handler `handleLogout`, and imports DropdownMenuItem.
icon: the JSX of the Logout icon. --}}
{showLogout ? (
  <div className='p-2 space-y-2'>
    <p className='text-sm text-muted-foreground'>Are you sure?</p>
    <div className='flex gap-2'>
      <button
        type='button'
        onClick={handleLogout}
        className='flex-1 rounded-md bg-destructive px-2 py-1 text-xs text-destructive-foreground hover:bg-destructive/90'
      >
        Logout
      </button>
      <button
        type='button'
        onClick={() => setShowLogout(false)}
        className='flex-1 rounded-md border px-2 py-1 text-xs hover:bg-accent'
      >
        Cancel
      </button>
    </div>
  </div>
) : (
  <DropdownMenuItem
    onSelect={(event) => {
      event.preventDefault();
      setShowLogout(true);
    }}
    className='hover:bg-destructive/40'
  >
    {{{icon}}}
    Logout
  </DropdownMenuItem>
)}
