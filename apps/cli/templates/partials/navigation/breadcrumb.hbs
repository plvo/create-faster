{{!-- The whole AppBreadcrumb component file, imports included.
userProcedure: the tRPC procedure that reads one user by id, for a dashboard with /admin/users. contactProcedure: the one that reads a contact, for a dashboard with contacts. projectProcedure: the one that reads a project, for a dashboard with /projects.
It reads from the project: ROUTES, RouteProps and PROFILE_TABS from @/lib/constants, useTRPC from @/trpc/providers, and the breadcrumb and skeleton components of @repo/ui.
A record is labelled only under the list routes RECORD_LABELS is keyed by, so the project needs the list route of each procedure it gives. --}}
{{#if (eq stackName "tanstack-start")}}
import { Link, useLocation } from '@tanstack/react-router';
{{else}}
'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
{{/if}}
{{#if (eq stackName "tanstack-start")}}
import { useQuery } from '@tanstack/react-query';
{{else}}
import { type QueryKey, useQueryClient } from '@tanstack/react-query';
{{/if}}
import * as React from 'react';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@repo/ui/components/ui/breadcrumb';
import { Skeleton } from '@repo/ui/components/ui/skeleton';
import { PROFILE_TABS, ROUTES, type RouteProps } from '@/lib/constants';
import { useTRPC } from '@/trpc/providers';

type RecordLabelComponent = React.ComponentType<{ id: string }>;

interface Crumb {
  url: string;
  segment: string;
  title: string;
  isLast: boolean;
  hasPage: boolean;
  RecordLabel?: RecordLabelComponent;
}

// The routes that have a page, which the breadcrumb links to.
const PAGE_URLS: string[] = [...ROUTES.map((route) => route.url), '/profile', ...PROFILE_TABS.map((tab) => tab.url)];

function findRouteTitle(routes: RouteProps[], url: string): string | undefined {
  return routes.find((route) => route.url === url)?.title;
}

function formatSegment(segment: string): string {
  return segment.charAt(0).toUpperCase() + segment.slice(1);
}

function CrumbText({ text }: { text: string }) {
  return <span title={text}>{text}</span>;
}

function LabelSkeleton() {
  return <Skeleton className='inline-block h-4 w-24 align-middle' />;
}

{{#unless (eq stackName "tanstack-start")}}
// The label of a record reads the record its page puts in the cache and never creates the query. This header sits in the
// layout, above the page's HydrationBoundary: a query created here first would make the boundary hydrate it in an effect,
// after the page's own useSuspenseQuery has fetched the record again from the browser. Until the page has hydrated the
// record, the label is a skeleton.
//
// The cache emits events while other components render (useSuspenseQuery reports its result as it renders), and React
// refuses a store update that starts in another component's render, so the label hears the cache one microtask later.
//
// A page whose record is gone answers not found before it hydrates anything, so the record never reaches the cache.
// Once the page has committed, a record still missing from the cache is one that is not coming: it reads as null,
// like a record the page found gone.
function useCachedRecord<T>(queryKey: QueryKey): T | null | undefined {
  const queryClient = useQueryClient();
  const record = React.useSyncExternalStore(
    (notify) => queryClient.getQueryCache().subscribe(() => queueMicrotask(notify)),
    () => queryClient.getQueryData<T | null>(queryKey),
    () => undefined,
  );
  const [hasCommitted, setHasCommitted] = React.useState(false);
  React.useEffect(() => {
    queueMicrotask(() => setHasCommitted(true));
  }, []);
  return record === undefined && hasCommitted ? null : record;
}

{{/unless}}
{{#if userProcedure}}
function UserLabel({ id }: { id: string }) {
  const trpc = useTRPC();
{{#if (eq stackName "tanstack-start")}}
  const { data: user, isPending } = useQuery(trpc.{{userProcedure}}.queryOptions({ id }));
  if (isPending) return <LabelSkeleton />;
{{else}}
  const user = useCachedRecord<{ name?: string | null }>(trpc.{{userProcedure}}.queryKey({ id }));
  if (user === undefined) return <LabelSkeleton />;
{{/if}}
  return <CrumbText text={user?.name || 'User'} />;
}
{{/if}}
{{#if contactProcedure}}

function ContactLabel({ id }: { id: string }) {
  const trpc = useTRPC();
{{#if (eq stackName "tanstack-start")}}
  const { data: contact, isPending } = useQuery(trpc.{{contactProcedure}}.queryOptions({ id }));
  if (isPending) return <LabelSkeleton />;
{{else}}
  const contact = useCachedRecord<{ firstName?: string | null; lastName?: string | null }>(
    trpc.{{contactProcedure}}.queryKey({ id }),
  );
  if (contact === undefined) return <LabelSkeleton />;
{{/if}}
  return <CrumbText text={[contact?.firstName, contact?.lastName].filter(Boolean).join(' ') || 'Contact'} />;
}
{{/if}}

{{#if projectProcedure}}

function ProjectLabel({ id }: { id: string }) {
  const trpc = useTRPC();
{{#if (eq stackName "tanstack-start")}}
  const { data: project, isPending } = useQuery(trpc.{{projectProcedure}}.queryOptions({ id }));
  if (isPending) return <LabelSkeleton />;
{{else}}
  const project = useCachedRecord<{ name?: string | null }>(trpc.{{projectProcedure}}.queryKey({ id }));
  if (project === undefined) return <LabelSkeleton />;
{{/if}}
  return <CrumbText text={project?.name || 'Project'} />;
}
{{/if}}

// The label of a record page, keyed by the URL of the list that holds the record.
const RECORD_LABELS: Record<string, RecordLabelComponent> = {
{{#if userProcedure}}
  '/admin/users': UserLabel,
{{/if}}
{{#if projectProcedure}}
  '/projects': ProjectLabel,
{{/if}}
{{#if contactProcedure}}
  '/contacts': ContactLabel,
{{/if}}
};

function buildCrumbs(pathname: string): Crumb[] {
  const segments = pathname.split('/').filter(Boolean);

  return segments.map((segment, index) => {
    const url = `/${segments.slice(0, index + 1).join('/')}`;
    const listUrl = `/${segments.slice(0, index).join('/')}`;
    return {
      url,
      segment,
      title: findRouteTitle(ROUTES, url) || formatSegment(segment),
      isLast: index === segments.length - 1,
      hasPage: PAGE_URLS.includes(url),
      RecordLabel: RECORD_LABELS[listUrl],
    };
  });
}

function CrumbLabel({ crumb }: { crumb: Crumb }) {
  return crumb.RecordLabel ? <crumb.RecordLabel id={crumb.segment} /> : <CrumbText text={crumb.title} />;
}

function CrumbItem({ crumb }: { crumb: Crumb }) {
  if (crumb.isLast) {
    return (
      <BreadcrumbItem className='min-w-0'>
        <BreadcrumbPage className='truncate'>
          <CrumbLabel crumb={crumb} />
        </BreadcrumbPage>
      </BreadcrumbItem>
    );
  }

  if (!crumb.hasPage) {
    return (
      <BreadcrumbItem className='shrink-0'>
        <span>
          <CrumbLabel crumb={crumb} />
        </span>
      </BreadcrumbItem>
    );
  }

  return (
    <BreadcrumbItem className='shrink-0'>
      <BreadcrumbLink asChild>
{{#if (eq stackName "tanstack-start")}}
        <Link to={crumb.url}>
{{else}}
        <Link href={crumb.url}>
{{/if}}
          <CrumbLabel crumb={crumb} />
        </Link>
      </BreadcrumbLink>
    </BreadcrumbItem>
  );
}

export function AppBreadcrumb() {
{{#if (eq stackName "tanstack-start")}}
  const pathname = useLocation({ select: (location) => location.pathname });
{{else}}
  const pathname = usePathname();
{{/if}}
  const crumbs = buildCrumbs(pathname);

  return (
    <Breadcrumb className='min-w-0'>
      <BreadcrumbList className='flex-nowrap'>
        <BreadcrumbItem className='shrink-0'>
          {crumbs.length === 0 ? (
            <BreadcrumbPage>Home</BreadcrumbPage>
          ) : (
            <BreadcrumbLink asChild>
{{#if (eq stackName "tanstack-start")}}
              <Link to='/'>Home</Link>
{{else}}
              <Link href='/'>Home</Link>
{{/if}}
            </BreadcrumbLink>
          )}
        </BreadcrumbItem>
        {crumbs.map((crumb) => (
          <React.Fragment key={crumb.url}>
            <BreadcrumbSeparator />
            <CrumbItem crumb={crumb} />
          </React.Fragment>
        ))}
      </BreadcrumbList>
    </Breadcrumb>
  );
}
