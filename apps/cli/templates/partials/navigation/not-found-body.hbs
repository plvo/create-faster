{{!-- The content of a not found page: a section, since the layout around it provides the main landmark.
heading: the title; linkLabel: the text of the link back to the home page. --}}
<section className='flex flex-col items-center justify-center gap-2 px-4 py-16 text-center'>
  <h1 className='text-2xl font-semibold'>{{heading}}</h1>
  <p className='text-muted-foreground'>The page you are looking for does not exist.</p>
{{#if (eq stackName "tanstack-start")}}
  <Link to='/' className='text-sm underline underline-offset-4'>
    {{linkLabel}}
  </Link>
{{else}}
  <Link href='/' className='text-sm underline underline-offset-4'>
    {{linkLabel}}
  </Link>
{{/if}}
</section>
