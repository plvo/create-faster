{{!-- One entry per task (or task group), kept when it renders something. The block closes on the line of the last entry so the final brace keeps its own line. --}}
{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "remoteCache": {
    "signature": true
  },
  "tasks": {{#joinEntries open="{" close="}" closeIndent="  "}}
{{#entry}}
{{#if (hasRootScript "build")}}
    "build": {
      "dependsOn": ["^build"{{#if (has "orm" "prisma")}}, "^db:generate"{{/if}}],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (hasRootScript "dev")}}
    "dev": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (hasRootScript "start")}}
    "start": {
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (hasRootScript "test")}}
    "test": {
{{#if (hasRootScript "build")}}
      "dependsOn": ["^build"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"]
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (hasRootScript "test:e2e")}}
    "test:e2e": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "cache": false
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (hasRootScript "cf-typegen")}}
    "cf-typegen": {
      "cache": false
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (or (has "orm" "drizzle") (has "orm" "prisma"))}}
    "db:push": {
      "cache": false
    },
    "db:generate": {
{{#if (has "orm" "prisma")}}
      "outputs": ["generated/**"]
{{else}}
      "cache": false
{{/if}}
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false{{#with (taskEnv "db:seed") as |seedEnv|}},
      "env": [{{#each seedEnv}}{{#unless @first}}, {{/unless}}"{{this}}"{{/each}}]{{/with}}
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
{{/if}}
{{/entry}}
{{#entry}}
{{#if (or (has "linter" "eslint") (has "linter" "eslint-prettier"))}}
    "lint": {}
{{/if}}
{{/entry}}{{/joinEntries}}
}
