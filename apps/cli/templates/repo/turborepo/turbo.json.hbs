{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"{{#if (has "orm" "prisma")}}, "^db:generate"{{/if}}],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "dev": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }{{#if (or (has "orm" "drizzle") (has "orm" "prisma"))}},
    "db:push": {
      "cache": false
    },
    "db:generate": {
{{#if (has "orm" "prisma")}}
      "outputs": ["generated/**"]
{{else}}
      "cache": false
{{/if}}
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (or (has "linter" "eslint") (has "linter" "eslint-prettier"))}},
    "lint": {}{{/if}}
  }
}
