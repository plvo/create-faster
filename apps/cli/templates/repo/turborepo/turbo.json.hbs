{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"{{#if (has "orm" "prisma")}}, "^db:generate"{{/if}}],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "dev": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }{{#if (hasRootScript "start")}},
    "start": {
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (hasRootScript "test")}},
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env"]
    }{{/if}}{{#if (hasRootScript "test:e2e")}},
    "test:e2e": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "cache": false
    }{{/if}}{{#if (hasRootScript "cf-typegen")}},
    "cf-typegen": {
      "cache": false
    }{{/if}}{{#if (or (has "orm" "drizzle") (has "orm" "prisma"))}},
    "db:push": {
      "cache": false
    },
    "db:generate": {
{{#if (has "orm" "prisma")}}
      "outputs": ["generated/**"]
{{else}}
      "cache": false
{{/if}}
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false{{#with (taskEnv "db:seed") as |seedEnv|}},
      "env": [{{#each seedEnv}}{{#unless @first}}, {{/unless}}"{{this}}"{{/each}}]{{/with}}
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (or (has "linter" "eslint") (has "linter" "eslint-prettier"))}},
    "lint": {}{{/if}}
  }
}
