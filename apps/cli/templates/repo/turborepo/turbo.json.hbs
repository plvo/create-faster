{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
{{~#if (hasRootScript "build")}}{{!-- A task opens its own line, after the comma when an earlier task exists. --}}
    "build": {
      "dependsOn": ["^build"{{#if (has "orm" "prisma")}}, "^db:generate"{{/if}}],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    }{{/if}}{{#if (hasRootScript "dev")}}{{#if (hasRootScript "build")}},{{/if}}
    "dev": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (hasRootScript "start")}}{{#if (or (hasRootScript "build") (hasRootScript "dev"))}},{{/if}}
    "start": {
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (hasRootScript "test")}}{{#if (or (hasRootScript "build") (hasRootScript "dev") (hasRootScript "start"))}},{{/if}}
    "test": {
{{#if (hasRootScript "build")}}
      "dependsOn": ["^build"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"]
    }{{/if}}{{#if (hasRootScript "test:e2e")}}{{#if (or (hasRootScript "build") (hasRootScript "dev") (hasRootScript "start") (hasRootScript "test"))}},{{/if}}
    "test:e2e": {
{{#if (has "orm" "prisma")}}
      "dependsOn": ["^db:generate"],
{{/if}}
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "cache": false
    }{{/if}}{{#if (hasRootScript "cf-typegen")}}{{#if (or (hasRootScript "build") (hasRootScript "dev") (hasRootScript "start") (hasRootScript "test") (hasRootScript "test:e2e"))}},{{/if}}
    "cf-typegen": {
      "cache": false
    }{{/if}}{{#if (or (has "orm" "drizzle") (has "orm" "prisma"))}}{{#if (or (hasRootScript "build") (hasRootScript "dev") (hasRootScript "start") (hasRootScript "test") (hasRootScript "test:e2e") (hasRootScript "cf-typegen"))}},{{/if}}
    "db:push": {
      "cache": false
    },
    "db:generate": {
{{#if (has "orm" "prisma")}}
      "outputs": ["generated/**"]
{{else}}
      "cache": false
{{/if}}
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false{{#with (taskEnv "db:seed") as |seedEnv|}},
      "env": [{{#each seedEnv}}{{#unless @first}}, {{/unless}}"{{this}}"{{/each}}]{{/with}}
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }{{/if}}{{#if (or (has "linter" "eslint") (has "linter" "eslint-prettier"))}}{{#if (or (hasRootScript "build") (hasRootScript "dev") (hasRootScript "start") (hasRootScript "test") (hasRootScript "test:e2e") (hasRootScript "cf-typegen") (has "orm" "drizzle") (has "orm" "prisma"))}},{{/if}}
    "lint": {}{{/if}}
  }
}
