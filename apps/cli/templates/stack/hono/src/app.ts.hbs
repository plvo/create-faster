import { Hono } from 'hono';
import { cors } from 'hono/cors';
import { HTTPException } from 'hono/http-exception';
{{#unless (hasLibrary "evlog")}}
import { logger } from 'hono/logger';
{{/unless}}
import { timeout } from 'hono/timeout';
{{#if (hasLibrary "evlog")}}
import { EvlogError, initLogger, parseError } from 'evlog';
import { evlog, type EvlogVariables } from 'evlog/hono';
import type { ContentfulStatusCode } from 'hono/utils/http-status';

initLogger({
  env: { service: '{{appName}}' },
});
{{/if}}

{{#if (has "deployment" "cloudflare")}}
const app = new Hono<{{#if (hasLibrary "evlog")}}EvlogVariables & {{/if}}{ Bindings: CloudflareEnv }>();
{{else}}
const app = new Hono{{#if (hasLibrary "evlog")}}<EvlogVariables>{{/if}}();
{{/if}}

{{#if (hasLibrary "evlog")}}
app.use(evlog());
{{else}}
app.use(logger());
{{/if}}
app.use(timeout(15000));

app.use(
  '*',
  cors({
    origin: '*',
    allowHeaders: ['Content-Type', 'Authorization'],
  }),
);

app.notFound((c) => {
  return c.json(
    {
      ok: false,
      message: 'Not found',
    },
    404,
  );
});

app.get('/health/:id', (c) => {
  const { id } = c.req.param();
  return c.json(
    {
      ok: true,
      message: 'Health check',
      data: {
        id,
      },
    },
    200,
  );
});

app.onError((err, c) => {
  const isDev = process.env.NODE_ENV === 'development';
  {{#if (hasLibrary "evlog")}}
  c.get('log').error(err);
  if (!isDev && !(err instanceof HTTPException) && !EvlogError.isEvlogError(err)) {
    return c.json({ ok: false, message: 'Internal server error' }, 500);
  }
  const parsed = parseError(err);
  return c.json(
    {
      ok: false,
      message: parsed.message,
      why: parsed.why,
      fix: parsed.fix,
    },
    (parsed.status || 500) as ContentfulStatusCode,
  );
  {{else}}
  console.error('Error:', err);
  if (err instanceof HTTPException) {
    return c.json({ ok: false, message: err.message }, err.status);
  }
  return c.json(
    {
      ok: false,
      message: isDev ? err.message : 'Internal server error',
      stack: isDev ? err.stack : undefined,
    },
    500,
  );
  {{/if}}
});

export default app;