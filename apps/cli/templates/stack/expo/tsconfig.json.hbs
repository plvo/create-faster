{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["expo/types"{{#if (hasLibrary "jest-expo")}}, "jest"{{/if}}],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"{{#if (hasLibrary "nativewind")}}, "nativewind-env.d.ts"{{/if}}],
  "exclude": ["node_modules"]
}
