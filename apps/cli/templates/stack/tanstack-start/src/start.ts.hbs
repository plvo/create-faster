---
deploymentSkip:
  - cloudflare-static
---
{{#if (or (hasLibrary "evlog"))}}
import { createCsrfMiddleware, {{#if (hasLibrary "evlog")}}createMiddleware, {{/if}}createStart } from '@tanstack/react-start'
{{#if (hasLibrary "evlog")}}
import { EvlogError } from 'evlog'
import { findLogger } from '@/lib/evlog'

const toError = (error: unknown): Error => (error instanceof Error ? error : new Error(String(error)))

const logRequestErrors = createMiddleware({ type: 'request' }).server(async ({ next }) => {
  try {
    return await next()
  } catch (error) {
    findLogger()?.error(toError(error))
    if (EvlogError.isEvlogError(error)) {
      throw new Response(JSON.stringify(error.toJSON()), {
        status: error.status || 500,
        headers: { 'Content-Type': 'application/json' },
      })
    }
    throw error
  }
})

const logServerFnErrors = createMiddleware({ type: 'function' }).server(async ({ next }) => {
  try {
    return await next()
  } catch (error) {
    findLogger()?.error(toError(error))
    throw error
  }
})
{{/if}}

const csrfMiddleware = createCsrfMiddleware({ filter: (ctx) => ctx.handlerType === 'serverFn' })

export const startInstance = createStart(() => ({
  requestMiddleware: [csrfMiddleware{{#if (hasLibrary "evlog")}}, logRequestErrors{{/if}}],
  functionMiddleware: [{{#if (hasLibrary "evlog")}}logServerFnErrors{{/if}}],
}))
{{/if}}
