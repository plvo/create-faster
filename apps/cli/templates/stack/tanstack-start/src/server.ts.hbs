{{#if (has "deployment" "cloudflare")}}
import handler from '@tanstack/react-start/server-entry'
{{#if (hasLibrary "evlog")}}
import type { RequestLogger } from 'evlog'
import { initWorkersLogger, withEvlog } from 'evlog/workers'
import { loggerStorage } from '@/lib/evlog'

declare module '@tanstack/react-start' {
  interface Register {
    server: { requestContext: { log: RequestLogger } }
  }
}

initWorkersLogger({ env: { service: '{{appName}}' } })
{{/if}}

{{#if (hasLibrary "evlog")}}
export default withEvlog((request, _env, _ctx, log) =>
  loggerStorage.run(log, () => handler.fetch(request, { context: { log } })),
)
{{else}}
export default handler
{{/if}}
{{/if}}
