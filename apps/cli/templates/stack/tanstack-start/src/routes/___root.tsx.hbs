/// <reference types="vite/client" />
import { HeadContent, Scripts, {{#if (hasLibrary "trpc")}}createRootRouteWithContext{{else}}createRootRoute{{/if}} } from '@tanstack/react-router'
import { TanStackRouterDevtools } from '@tanstack/react-router-devtools'
{{#if (hasLibrary "trpc")}}
{{#if (hasLibrary "tanstack-query")}}
import type { QueryClient } from '@tanstack/react-query'
import type { TRPCOptionsProxy } from '@trpc/tanstack-react-query'
{{else}}
import type { TRPCClient } from '@trpc/client'
{{/if}}
{{/if}}
{{#if (hasLibrary "next-themes")}}
import { ThemeProvider } from 'next-themes'
{{/if}}

import { NotFound } from '@/components/not-found'
{{#if (hasLibrary "posthog")}}
import { AnalyticsProvider } from '@/components/analytics-provider'
{{/if}}
{{#if (hasLibrary "trpc")}}
import type { AppRouter } from {{#if (isMono)}}'@repo/api'{{else}}'@/trpc/routers/_app'{{/if}}
{{/if}}
import appCss from '../styles.css?url'
{{#if (hasLibrary "trpc")}}

interface RouterContext {
{{#if (hasLibrary "tanstack-query")}}
  queryClient: QueryClient
  trpc: TRPCOptionsProxy<AppRouter>
{{else}}
  trpc: TRPCClient<AppRouter>
{{/if}}
}
{{/if}}

export const Route = {{#if (hasLibrary "trpc")}}createRootRouteWithContext<RouterContext>()({{else}}createRootRoute({{/if}}{
  head: () => ({
    meta: [
      {
        charSet: 'utf-8',
      },
      {
        name: 'viewport',
        content: 'width=device-width, initial-scale=1',
      },
      {
        title: '{{appName}} - TanStack Start',
      },
    ],
    links: [
      {
        rel: 'stylesheet',
        href: appCss,
      },
    ],
  }),
  notFoundComponent: NotFound,
  shellComponent: RootDocument,
})

function RootDocument({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en" suppressHydrationWarning>
      <head>
        <HeadContent />
      </head>
      <body>
        {{#if (hasLibrary "next-themes")}}
        <ThemeProvider attribute="class" defaultTheme="system" enableSystem storageKey="{{appName}}-theme">
        {{/if}}
        {{#if (hasLibrary "posthog")}}
        <AnalyticsProvider>
        {{/if}}
        <div className="min-h-screen {{#if (hasLibrary "shadcn")}}bg-background text-foreground{{else}}bg-slate-900 text-white{{/if}}">
          <main className="container mx-auto px-4 py-8">
            <h1 className="text-4xl font-bold mb-4">{{appName}}</h1>
            <p className="{{#if (hasLibrary "shadcn")}}text-muted-foreground{{else}}text-gray-400{{/if}} mb-8">Built with TanStack Start</p>
            <hr className="{{#if (hasLibrary "shadcn")}}border-border{{else}}border-gray-700{{/if}} mb-8" />
            {children}
          </main>
        </div>
        <TanStackRouterDevtools position="bottom-right" />
        {{#if (hasLibrary "posthog")}}
        </AnalyticsProvider>
        {{/if}}
        {{#if (hasLibrary "next-themes")}}
        </ThemeProvider>
        {{/if}}
        <Scripts />
      </body>
    </html>
  )
}
