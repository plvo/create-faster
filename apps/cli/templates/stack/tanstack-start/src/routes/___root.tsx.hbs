/// <reference types="vite/client" />
import { HeadContent, Scripts, createRootRoute } from '@tanstack/react-router'
import { TanStackRouterDevtools } from '@tanstack/react-router-devtools'
{{#if (hasLibrary "next-themes")}}
import { ThemeProvider } from 'next-themes'
{{/if}}
{{#if (hasLibrary "evlog")}}
import { createMiddleware } from '@tanstack/react-start'
{{#if (has "deployment" "cloudflare")}}
import { EvlogError } from 'evlog'
{{else}}
import { EvlogError, type RequestLogger } from 'evlog'
import { useRequest } from 'nitro/context'
{{/if}}
{{/if}}

import appCss from '../styles.css?url'

export const Route = createRootRoute({
  head: () => ({
    meta: [
      {
        charSet: 'utf-8',
      },
      {
        name: 'viewport',
        content: 'width=device-width, initial-scale=1',
      },
      {
        title: '{{appName}} - TanStack Start',
      },
    ],
    links: [
      {
        rel: 'stylesheet',
        href: appCss,
      },
    ],
  }),
  {{#if (hasLibrary "evlog")}}
  server: {
    middleware: [
      createMiddleware().server(async ({ next{{#if (has "deployment" "cloudflare")}}, context{{/if}} }) => {
        try {
          return await next()
        } catch (error) {
          {{#if (has "deployment" "cloudflare")}}
          context.log?.error(error)
          {{else}}
          (useRequest().context?.log as RequestLogger | undefined)?.error(error)
          {{/if}}
          if (EvlogError.isEvlogError(error)) {
            throw new Response(JSON.stringify(error.toJSON()), {
              status: error.status || 500,
              headers: { 'Content-Type': 'application/json' },
            })
          }
          throw error
        }
      }),
    ],
  },
  {{/if}}
  shellComponent: RootDocument,
})

function RootDocument({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en" suppressHydrationWarning>
      <head>
        <HeadContent />
      </head>
      <body>
        {{#if (hasLibrary "next-themes")}}
        <ThemeProvider attribute="class" defaultTheme="system" enableSystem storageKey="{{appName}}-theme">
        {{/if}}
        <div className="min-h-screen {{#if (hasLibrary "shadcn")}}bg-background text-foreground{{else}}bg-slate-900 text-white{{/if}}">
          <main className="container mx-auto px-4 py-8">
            <h1 className="text-4xl font-bold mb-4">{{appName}}</h1>
            <p className="{{#if (hasLibrary "shadcn")}}text-muted-foreground{{else}}text-gray-400{{/if}} mb-8">Built with TanStack Start</p>
            <hr className="{{#if (hasLibrary "shadcn")}}border-border{{else}}border-gray-700{{/if}} mb-8" />
            {children}
          </main>
        </div>
        <TanStackRouterDevtools position="bottom-right" />
        {{#if (hasLibrary "next-themes")}}
        </ThemeProvider>
        {{/if}}
        <Scripts />
      </body>
    </html>
  )
}
