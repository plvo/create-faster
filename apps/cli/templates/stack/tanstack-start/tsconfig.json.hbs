{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"{{#if (has "deployment" "cloudflare")}}, "cloudflare-env.d.ts"{{/if}}{{#if (or (hasLibrary "vitest") (hasLibrary "playwright"))}}, "tests"{{/if}}]
}
