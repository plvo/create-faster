import { defineConfig } from 'vite'
{{#if (hasLibrary "tanstack-devtools")}}
import { devtools } from '@tanstack/devtools-vite'
{{/if}}
import { tanstackStart } from '@tanstack/react-start/plugin/vite'
import viteReact from '@vitejs/plugin-react'
import tailwindcss from '@tailwindcss/vite'
{{#if (has "deployment" "cloudflare")}}
import { cloudflare } from '@cloudflare/vite-plugin'
{{/if}}
{{#unless (or (has "deployment" "cloudflare") (has "deployment" "cloudflare-static"))}}
import { nitro } from 'nitro/vite'
{{/unless}}
{{#if (hasLibrary "mdx")}}
import mdx from '@mdx-js/rollup'
import remarkFrontmatter from 'remark-frontmatter'
import remarkMdxFrontmatter from 'remark-mdx-frontmatter'
{{/if}}

const config = defineConfig(({{#if (has "deployment" "cloudflare")}}{ command }{{/if}}) => ({
  server: {
    port: {{#if (isMono)}}{{appPort appName}}{{else}}3000{{/if}},
  },
  resolve: {
    tsconfigPaths: true,
  },
  plugins: [
{{#if (hasLibrary "tanstack-devtools")}}
    devtools(),
{{/if}}
{{#if (has "deployment" "cloudflare")}}
    cloudflare({ viteEnvironment: { name: 'ssr' }, persistState: { path: '{{#if (isMono)}}../../{{/if}}.wrangler' }, config: { vars: { NODE_ENV: command === 'build' ? 'production' : 'development' } } }),
{{/if}}
    tailwindcss(),
{{#if (hasLibrary "mdx")}}
    {
      enforce: 'pre',
      ...mdx({
        providerImportSource: '/src/mdx-components.tsx',
        remarkPlugins: [remarkFrontmatter, remarkMdxFrontmatter],
      }),
    },
{{/if}}
{{#if (has "deployment" "cloudflare-static")}}
    tanstackStart({ prerender: { enabled: true, crawlLinks: true, autoSubfolderIndex: false } }),
{{else}}
    tanstackStart(),
{{/if}}
    viteReact({{#if (hasLibrary "mdx")}}{ include: /\.(jsx|js|mdx|md|tsx|ts)$/ }{{/if}}),
{{#unless (or (has "deployment" "cloudflare") (has "deployment" "cloudflare-static"))}}
    nitro(),
{{/unless}}
  ],
}))

export default config
