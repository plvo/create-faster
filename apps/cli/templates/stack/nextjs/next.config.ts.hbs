{{#if (and (has "deployment" "cloudflare") (eq stackName "nextjs"))}}
import { initOpenNextCloudflareForDev } from '@opennextjs/cloudflare';
{{/if}}
{{#if (hasLibrary "mdx")}}
import createMDX from '@next/mdx';
{{/if}}
import type { NextConfig } from 'next';

{{#if (and (has "deployment" "cloudflare") (eq stackName "nextjs"))}}
{{!-- d1: point getPlatformProxy at the same local state the `d1 migrations apply --persist-to` CLI writes (.wrangler/v3), so `next dev` sees the migrated/seeded database --}}
{{!-- development only: the call starts a local workerd on the persisted state, and `next build` loads this config too, where it would hold the shared local D1 while OpenNext builds and previews --}}
if (process.env.NODE_ENV === 'development') {
  initOpenNextCloudflareForDev({{#if (has "database" "d1")}}{ persist: { path: '{{#if (isMono)}}../../{{/if}}.wrangler/v3' } }{{/if}});
}

{{/if}}
const nextConfig: NextConfig = {
  {{#if (isMono)}}
  transpilePackages: [
    {{#if (hasLibrary "shadcn")}}
    "@repo/ui",
    {{/if}}
    {{#if (hasContext "orm")}}
    "@repo/db",
    {{/if}}
  ],
  {{/if}}
  reactStrictMode: true,
  agentRules: false,
  // Top right keeps the dev indicator off a sidebar footer (bottom left) and off the toasts (bottom right).
  devIndicators: { position: 'top-right' },

  {{#if (eq blueprint "dapp-rainbowkit-nextjs")}}
  // RainbowKit reaches @coinbase/cdp-sdk, which dynamically imports optional @x402/* peers that are not installed. Loaded by Node at runtime instead of bundled, the missing peers only matter if x402 signing is used.
  serverExternalPackages: ['@coinbase/cdp-sdk'],

  {{/if}}
  {{#if (has "deployment" "cloudflare-static")}}
  // `next dev` answers an unknown param of a dynamic route with a 500 under `output: 'export'`, whatever `dynamicParams` says; without it the route answers its 404 page, as the export does.
  // {{> nextjs/export-dev-note}}
  output: process.env.NODE_ENV === 'development' ? undefined : 'export',
  images: {
    unoptimized: true,
  },

  {{/if}}
  {{#if (has "tooling" "portless")}}
  env: {
    NEXT_PUBLIC_APP_URL: process.env.PORTLESS_URL ?? process.env.NEXT_PUBLIC_APP_URL,
  },

  {{/if}}
  {{#if (hasLibrary "posthog")}}
  async rewrites() {
    return [
      {
        source: '/ingest/static/:path*',
        destination: 'https://{{> posthog/asset-host}}/static/:path*',
      },
      {
        source: '/ingest/array/:path*',
        destination: 'https://{{> posthog/asset-host}}/array/:path*',
      },
      {
        source: '/ingest/:path*',
        destination: 'https://{{> posthog/api-host}}/:path*',
      },
    ];
  },
  skipTrailingSlashRedirect: true,

  {{/if}}
  experimental: {
    optimizePackageImports: [
      'lucide-react',
      'date-fns',
      'date-fns-tz',
      '@dnd-kit/core',
      '@dnd-kit/sortable',
      'react-day-picker',
      'motion',
    ],
  },

  turbopack: {
    resolveExtensions: [
      '.ts',
      '.tsx',
      '.js',
      '.jsx',
      '.mjs',
      '.cjs',
      {{#if (hasLibrary "mdx")}}
      '.mdx',
      '.md',
      {{/if}}
    ],
  },
};

{{#if (hasLibrary "mdx")}}
const withMDX = createMDX({
  extension: /\.(md|mdx)$/,
  options: {
    remarkPlugins: ['remark-frontmatter', 'remark-mdx-frontmatter'],
  },
});
{{/if}}

{{#if (hasLibrary "mdx")}}
export default withMDX(nextConfig);
{{else}}
export default nextConfig;
{{/if}}
