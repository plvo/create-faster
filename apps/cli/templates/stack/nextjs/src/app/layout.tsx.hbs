---
blueprintSkip:
  - cloudflare-payload-nextjs
---
import type { Metadata } from 'next';
import '@/styles/globals.css';
import localFont from 'next/font/local';
import { AppProviders } from '@/components/app-providers';

{{> nextjs/fonts}}

export const metadata: Metadata = {
  title: {
    template: '%s | {{projectName}}',
    default: 'Home | {{projectName}}',
  },
  description: "{{projectName}} - Initialized with https://github.com/plvo/create-faster",
};

export default {{#if (hasLibrary "tanstack-devtools")}}async {{/if}}function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  {{#if (hasLibrary "tanstack-devtools")}}
  const Devtools = process.env.NODE_ENV === 'development' ? (await import('@/components/devtools')).Devtools : null;

  {{/if}}
  return (
    <html lang='en' className={`${geistSans.variable} ${geistMono.variable}`} suppressHydrationWarning>
      <body className='antialiased' suppressHydrationWarning>
        <AppProviders>
          <main>{children}</main>
          {{#if (hasLibrary "tanstack-devtools")}}
          {Devtools && <Devtools />}
          {{/if}}
        </AppProviders>
      </body>
    </html>
  );
}